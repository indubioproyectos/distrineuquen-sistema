<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Backend page head: navy browser/status bar, DN icons and the safe-area
       aware viewport for the installed app (see scss/movil.scss). -->
  <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap" name="Distri: cabecera de la app">
    <xpath expr="//t[@t-set='head_web']" position="before">
      <t t-set="x_icon" t-value="'/distri_pedido/static/src/img/marca/favicon-32.png?v=129.12'"/>
    </xpath>
    <xpath expr="//meta[@name='viewport']" position="attributes">
      <attribute name="content">width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover</attribute>
    </xpath>
    <xpath expr="//meta[@name='theme-color']" position="attributes">
      <attribute name="content">#10243f</attribute>
    </xpath>
    <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
      <attribute name="href">/distri_pedido/static/src/img/marca/dn-icono-180.png?v=129.12</attribute>
    </xpath>
    <xpath expr="//link[@rel='apple-touch-icon']" position="after">
      <meta name="apple-mobile-web-app-capable" content="yes"/>
      <meta name="mobile-web-app-capable" content="yes"/>
      <meta name="apple-mobile-web-app-title" content="Distri"/>
      <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
    </xpath>
  </template>
</odoo>
