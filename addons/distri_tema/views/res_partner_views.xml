<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Contact card for phones: full name, balance and the three things you
       do with a customer on the street (call, WhatsApp, go there). Hidden
       from md up, where the regular header already has room. -->
  <record id="view_partner_form_movil" model="ir.ui.view">
    <field name="name">res.partner.form.distri.movil</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="after">
        <div class="o_distri_contact_hero d-md-none" invisible="not id">
          <div class="o_distri_contact_hero_name">
            <field name="name" readonly="1" nolabel="1"/>
          </div>
          <div class="o_distri_contact_hero_balance"
               groups="account.group_account_invoice,account.group_account_readonly">
            <field name="currency_id" invisible="1"/>
            <span class="o_distri_pill o_distri_pill_danger" invisible="credit &lt;= 0">
              Debe <field name="credit" widget="monetary" readonly="1" nolabel="1"
                          options="{'currency_field': 'currency_id'}"/>
            </span>
            <span class="o_distri_pill o_distri_pill_ok" invisible="credit &gt; 0">Sin deuda</span>
          </div>
          <div class="o_distri_quick_actions">
            <button name="action_distri_call" type="object" class="btn o_distri_quick_action"
                    invisible="not phone" title="Llamar">
              <i class="fa fa-phone" aria-hidden="true"/><span>Llamar</span>
            </button>
            <button name="action_distri_whatsapp" type="object" class="btn o_distri_quick_action"
                    invisible="not phone" title="WhatsApp">
              <i class="fa fa-whatsapp" aria-hidden="true"/><span>WhatsApp</span>
            </button>
            <button name="action_distri_directions" type="object" class="btn o_distri_quick_action"
                    invisible="not street and not city" title="Cómo llegar">
              <i class="fa fa-map-marker" aria-hidden="true"/><span>Cómo llegar</span>
            </button>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
