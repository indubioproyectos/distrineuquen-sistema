<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Esquema conocido al 25/09/2026, a confirmar con el gerente: cambio al
       pasar a dos repartidores. Se carga una sola vez; despues lo edita el
       gerente en Ventas > Pedidos > Zonas de reparto. -->
  <data noupdate="1">

    <record id="zona_neuquen" model="distri.zona">
      <field name="name">Neuquén</field>
      <field name="viaje">1</field>
      <field name="sequence">10</field>
      <field name="dia_lunes" eval="True"/>
      <field name="dia_martes" eval="True"/>
      <field name="dia_miercoles" eval="True"/>
      <field name="dia_jueves" eval="True"/>
      <field name="dia_viernes" eval="True"/>
    </record>

    <record id="zona_plottier" model="distri.zona">
      <field name="name">Plottier</field>
      <field name="viaje">2</field>
      <field name="sequence">20</field>
      <field name="dia_jueves" eval="True"/>
    </record>

    <record id="zona_centenario" model="distri.zona">
      <field name="name">Centenario</field>
      <field name="viaje">2</field>
      <field name="sequence">30</field>
      <field name="dia_viernes" eval="True"/>
    </record>

  </data>
</odoo>
