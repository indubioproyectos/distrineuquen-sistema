<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Transportista habitual a Zapala. Se edita en Reparto › Transportistas. -->
  <data noupdate="1">
    <record id="carrier_el_petroleo" model="distri.carrier">
      <field name="name">El Petróleo S.A.</field>
      <field name="sequence">10</field>
    </record>

    <!-- Localidades del interior: sus pedidos salen por encomienda desde la
         terminal de Neuquén (Zapala y Cutral Có). Catriel no se reparte ni
         sale por encomienda: sus clientes retiran en el depósito (decisión de
         la gerencia del 22/10/2026). Se editan en Zonas de reparto. -->
    <record id="zona_zapala" model="distri.zona">
      <field name="name">Zapala</field>
      <field name="viaje">1</field>
      <field name="sequence">40</field>
      <field name="encomienda" eval="True"/>
      <field name="carrier_id" ref="carrier_el_petroleo"/>
    </record>
    <record id="zona_cutral_co" model="distri.zona">
      <field name="name">Cutral Có</field>
      <field name="viaje">1</field>
      <field name="sequence">50</field>
      <field name="encomienda" eval="True"/>
    </record>
    <record id="zona_catriel" model="distri.zona">
      <field name="name">Catriel</field>
      <field name="viaje">2</field>
      <field name="sequence">60</field>
      <field name="retira_deposito" eval="True"/>
    </record>

    <!-- Pedidos de encomienda por debajo de este total: el envío lo paga el
         cliente en destino (models/encomienda.py). -->
    <record id="param_encomienda_pedido_chico" model="ir.config_parameter">
      <field name="key">distri_pedido.encomienda_pedido_chico</field>
      <field name="value">70000</field>
    </record>
  </data>

  <!-- Lee el importe de las fotos de los gastos y el número de guía de las
       encomiendas apenas llegan del celular (se dispara solo al sincronizar). -->
  <record id="cron_read_route_photos" model="ir.cron">
    <field name="name">Reparto: leer fotos de gastos y guías</field>
    <field name="model_id" ref="model_distri_route_expense"/>
    <field name="state">code</field>
    <field name="code">model._cron_read_photos()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">10</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
  </record>

</odoo>
