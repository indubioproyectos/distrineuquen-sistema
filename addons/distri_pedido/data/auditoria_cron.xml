<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 19.0.1.129.0 (models/auditoria.py): every evening the collections audit
       with the coverage as it is (only the 3-day alerts can change without a
       new report) and the summary per person of what was credited that day,
       with an activity for Gerencia. Backend only: no email (SMTP fails).
       19.0.1.129.24: noupdate. The nextcall expression only seeds a new
       database; before, every module upgrade reset it to «tomorrow» and a
       deploy skipped that evening's run (24/11). The SFTP cron goes with it:
       once someone turns it on, an upgrade keeps it on. -->
  <data noupdate="1">
  <record id="cron_mp_audit_daily" model="ir.cron">
    <field name="name">Cobros: auditoría diaria y resumen por persona</field>
    <field name="model_id" ref="model_distri_mp_audit"/>
    <field name="state">code</field>
    <field name="code">model._cron_audit()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <!-- 23:30 in Argentina (UTC-3) -->
    <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    <field name="active">True</field>
  </record>

  <!-- 19.0.1.129.0 (models/mp_sftp.py, G10): the Mercado Pago report fetched
       from a remote SFTP server into the folder of
       distri_pedido.mp_carpeta_reportes, then imported. Disabled until the
       distri_pedido.mp_sftp_* parameters and the key file are set. -->
  <record id="cron_mp_sftp_fetch" model="ir.cron">
    <field name="name">Mercado Pago: traer reportes por SFTP</field>
    <field name="model_id" ref="model_distri_mp_report"/>
    <field name="state">code</field>
    <field name="code">model._cron_sftp_fetch()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">30</field>
    <field name="interval_type">minutes</field>
    <field name="active">False</field>
  </record>
  </data>

</odoo>
