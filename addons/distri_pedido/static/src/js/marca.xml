<?xml version="1.0" encoding="UTF-8"?>
<!-- 19.0.1.129.4 (static/src/js/marca.js): web client texts without «Odoo» -->
<templates xml:space="preserve">
    <t t-inherit="web.SessionExpiredDialog" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="title.translate">Sesión vencida</attribute>
        </xpath>
        <xpath expr="//p" position="replace">
            <p class="text-prewrap">Tu sesión venció. La página se va a recargar.</p>
        </xpath>
    </t>

    <!-- Settings › edition block: the system name and the license, no Odoo -->
    <t t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//h3" position="replace">
            <h3 class="px-0 o_distri_edicion">DistriNeuquén <small class="text-muted" t-esc="serverVersion"/></h3>
        </xpath>
        <xpath expr="//small" position="replace">
            <small>Software libre con licencia <a id="license" target="_blank" href="http://www.gnu.org/licenses/lgpl.html" style="text-decoration: underline;">GNU LGPL</a></small>
        </xpath>
    </t>
</templates>
