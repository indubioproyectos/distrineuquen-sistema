<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Transfer receipt photographed in the driver's app (models/comprobante_app.py). -->

  <!-- ===================================================== route / rendición -->

  <record id="view_route_form_app_receipt" model="ir.ui.view">
    <field name="name">distri.route.form.app.receipt</field>
    <field name="model">distri.route</field>
    <field name="inherit_id" ref="distri_pedido.view_route_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='stop_ids']/list/field[@name='receipt_answer']" position="after">
        <field name="has_receipt_photo" optional="show"/>
        <button name="action_open_receipt_photos" type="object" icon="fa-camera"
                title="Ver la foto del comprobante" invisible="not has_receipt_photo"
                groups="distri_pedido.grupo_administracion"/>
      </xpath>
      <xpath expr="//page[@name='settlement']/group[1]" position="after">
        <separator string="Transferencias"/>
        <div class="text-muted mb-2">Lo que el repartidor dijo que cobró por transferencia. La
          transferencia nunca se registra desde acá: se confirma con el reporte de Mercado Pago.
          «Foto en la app»: el repartidor sacó la foto del comprobante en la entrega y ya está en
          Cobros › Comprobantes por WhatsApp para revisar.</div>
        <group>
          <group>
            <field name="transfer_total"/>
          </group>
          <group>
            <field name="transfer_photo_count"/>
            <field name="transfer_no_photo_count"
                   decoration-warning="transfer_no_photo_count &gt; 0"/>
          </group>
        </group>
        <field name="transfer_stop_ids" readonly="1" invisible="not transfer_stop_ids">
          <list create="0" delete="0" decoration-warning="not has_receipt_photo">
            <field name="partner_id"/>
            <field name="order_id"/>
            <field name="transfer_amount" sum="Total"/>
            <field name="receipt_answer"/>
            <field name="has_receipt_photo"/>
            <field name="receipt_status"/>
            <field name="currency_id" column_invisible="1"/>
            <button name="action_open_receipt_photos" type="object" icon="fa-camera"
                    string="Ver foto" invisible="not has_receipt_photo"
                    groups="distri_pedido.grupo_administracion"/>
          </list>
        </field>
      </xpath>
    </field>
  </record>

  <record id="view_route_list_app_receipt" model="ir.ui.view">
    <field name="name">distri.route.list.app.receipt</field>
    <field name="model">distri.route</field>
    <field name="inherit_id" ref="distri_pedido.view_route_list"/>
    <field name="arch" type="xml">
      <field name="cash_difference" position="after">
        <field name="transfer_total" optional="hide"/>
        <field name="transfer_no_photo_count" optional="show"
               decoration-warning="transfer_no_photo_count &gt; 0"/>
      </field>
    </field>
  </record>

  <!-- =========================================================== the order -->

  <record id="view_order_form_app_receipt" model="ir.ui.view">
    <field name="name">sale.order.form.app.receipt</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="distri_pedido.view_order_form_reparto"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_distri_open_receipt_photos" type="object" class="oe_stat_button"
                icon="fa-camera" invisible="distri_receipt_photo_count == 0"
                groups="distri_pedido.grupo_administracion">
          <field name="distri_receipt_photo_count" widget="statinfo" string="Comprobante"/>
        </button>
      </xpath>
      <xpath expr="//field[@name='distri_stop_ids']/list/field[@name='transfer']" position="after">
        <field name="transfer_amount" optional="show"/>
        <field name="receipt_answer" optional="show"/>
        <field name="has_receipt_photo" optional="show"/>
        <button name="action_open_receipt_photos" type="object" icon="fa-camera"
                title="Ver la foto del comprobante" invisible="not has_receipt_photo"
                groups="distri_pedido.grupo_administracion"/>
      </xpath>
    </field>
  </record>

  <!-- ====================================================== receipts list -->

  <record id="view_receipt_list_app" model="ir.ui.view">
    <field name="name">distri.whatsapp.message.receipt.list.app</field>
    <field name="model">distri.whatsapp.message</field>
    <field name="inherit_id" ref="distri_pedido.view_receipt_list"/>
    <field name="arch" type="xml">
      <field name="distri_forwarded_by_id" position="after">
        <field name="distri_from_app" readonly="1" optional="show"/>
        <field name="distri_app_order_id" readonly="1" optional="hide"/>
      </field>
    </field>
  </record>

  <record id="view_receipt_form_app" model="ir.ui.view">
    <field name="name">distri.whatsapp.message.receipt.form.app</field>
    <field name="model">distri.whatsapp.message</field>
    <field name="inherit_id" ref="distri_pedido.view_receipt_form"/>
    <field name="arch" type="xml">
      <field name="distri_forwarded_by_id" position="after">
        <field name="distri_from_app" readonly="1" invisible="not distri_from_app"/>
        <field name="distri_app_order_id" readonly="1" invisible="not distri_app_order_id"/>
        <field name="distri_app_route_id" readonly="1" invisible="not distri_app_route_id"/>
      </field>
    </field>
  </record>

  <record id="view_receipt_search_app" model="ir.ui.view">
    <field name="name">distri.whatsapp.message.receipt.search.app</field>
    <field name="model">distri.whatsapp.message</field>
    <field name="inherit_id" ref="distri_pedido.view_receipt_search"/>
    <field name="arch" type="xml">
      <filter name="no_partner" position="after">
        <filter name="from_app" string="De la app de reparto"
                domain="[('distri_from_app', '=', True)]"/>
      </filter>
    </field>
  </record>

</odoo>
