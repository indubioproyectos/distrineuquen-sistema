        <!-- 19.0.1.129.14: registered as a supplier payment from «Subir comprobante» -->
        <div class="alert alert-success d-flex gap-2 align-items-baseline" role="status"
             invisible="not distri_supplier_payment_id">
          Registrado como pago a proveedor autorizado por Gerencia:
          <field name="distri_supplier_payment_id" readonly="1" class="fw-bold"/>
