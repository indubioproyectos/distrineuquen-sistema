  <menuitem id="menu_cobros_upload_attempts" name="Intentos repetidos" parent="menu_cobros_root"
            action="action_receipt_upload_attempts" sequence="22"
            groups="distri_pedido.grupo_administracion,distri_pedido.grupo_gerencia,base.group_system"/>

  <record id="view_receipt_form_upload_attempts" model="ir.ui.view">
