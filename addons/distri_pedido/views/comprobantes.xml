    <field name="model">distri.receipt.upload.attempt</field>
    <field name="arch" type="xml">
      <search>
        <field name="user_id"/>
        <field name="file_name"/>
        <field name="partner_id"/>
        <group>
          <filter name="by_user" string="Quién lo intentó" context="{'group_by': 'user_id'}"/>
