<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- «Subir comprobante» (19.0.1.99.0, audit 3a): controllers/comprobantes.py,
       models/comprobante_subir.py, static/src/comprobantes/. On the kit.
       19.0.1.100.0: «Importe» and «Girar» per file, «Ver comprobante» and
       «Mis comprobantes». data-comp-api="100" on the form tells
       comprobantes.js that this server takes them (the static files are
       served before the module is updated).
       19.0.1.101.0: data-comp-api="101"; the refused duplicates are rows of
       «Subidos hoy por vos» and «Mis comprobantes» (attempt_row) and open
       comprobante_intento_page.
       19.0.1.126.1: data-comp-api="126": the customer is mandatory («No
       está en el sistema» + who sent it otherwise), «Subir y acreditar»,
       suggested customers (/comprobantes/sugerir), the large photo with ↺ ↻
       and a zoom, and «Cancelar» / «Cambiar foto» / «Girar» on «Ver
       comprobante» (models/subir_v126_1.py).
       19.0.1.126.2: a result «completar» (the user's own receipt pending
       assignment uploaded again) links «Completar y acreditar»
       (/comprobantes/<id>/completar, the `complete` form of
       comprobante_ver_page); the rows of such receipts link it too.
       19.0.1.129.14: «Es un pago a proveedor autorizado por Gerencia» (only
       grupo_pago_proveedor): the option on the upload form with the fields of
       comprobante_pago_proveedor_campos, and comprobante_pago_proveedor_page
       for a receipt already uploaded (the one refused for «transferencia a
       otra cuenta» links it: result, row and «Ver comprobante»). -->

  <!-- 19.0.1.129.14: supplier, amount, date and «Autorizó»; `ppc` is
       _distri_supplier_fields (models/pago_proveedor_subir.py) -->
  <template id="comprobante_pago_proveedor_campos" name="Pago a proveedor (campos)">
    <div class="dn-field comp-ppc__prov" data-ppc="">
      <label for="ppc-q">Proveedor</label>
      <p t-if="ppc['destination']" class="comp-muted">Destino leído en el comprobante:
        <t t-esc="ppc['destination']"/></p>
      <input type="hidden" name="proveedor_id" data-ppc-id=""
             t-att-value="ppc['supplier']['id'] if ppc['supplier'] else ''"/>
      <input id="ppc-q" class="dn-input" type="search" autocomplete="off" maxlength="80"
             placeholder="Buscar proveedor por nombre o CUIT…" data-ppc-q=""/>
      <ul class="comp-res" data-ppc-res="" hidden="hidden"></ul>
      <p class="comp-muted" data-ppc-txt=""
         t-esc="('Proveedor: %s.' % ppc['supplier']['name']) if ppc['supplier'] else 'Elegí el proveedor, o crealo abajo con el CUIT y el nombre del comprobante.'"/>
      <details class="comp-ppc__new" data-ppc-new="" t-att-open="'open' if ppc['new_open'] else None">
        <summary>No está: crear el proveedor</summary>
        <label for="ppc-cuit">CUIT del proveedor</label>
        <input id="ppc-cuit" class="dn-input dn-num" type="text" name="proveedor_cuit" inputmode="numeric"
               maxlength="13" autocomplete="off" placeholder="Ej.: 30-12345678-9"
               t-att-value="ppc['new_cuit']" data-ppc-cuit=""/>
        <label for="ppc-nombre">Nombre del proveedor</label>
        <input id="ppc-nombre" class="dn-input" type="text" name="proveedor_nombre" maxlength="120"
               autocomplete="off" t-att-value="ppc['new_name']" data-ppc-nombre=""/>
        <p class="comp-muted">Si ya hay un proveedor con ese CUIT se usa ese; si no, se crea.</p>
      </details>
    </div>
    <div class="dn-field">
      <label for="ppc-importe">Importe</label>
      <input id="ppc-importe" class="dn-input dn-num" type="text" name="proveedor_importe"
             inputmode="decimal" maxlength="20" autocomplete="off" placeholder="Ej.: 150.000"
             t-att-value="ppc['amount_text']" data-ppc-importe=""/>
      <p class="comp-muted">El leído en el comprobante: revisalo mirando la foto.</p>
    </div>
    <div class="dn-field">
      <label for="ppc-fecha">Fecha de la transferencia</label>
      <input id="ppc-fecha" class="dn-input" type="date" name="proveedor_fecha"
             t-att-value="ppc['date']" t-att-max="ppc['today']" data-ppc-fecha=""/>
    </div>
    <div class="dn-field">
      <label for="ppc-autorizo">Autorizó</label>
      <select id="ppc-autorizo" class="dn-input" name="autorizo_id" data-ppc-autorizo="">
        <option value="" t-att-selected="None if ppc['authorizer_id'] else 'selected'">Elegí quién de Gerencia lo autorizó</option>
        <option t-foreach="ppc['authorizers']" t-as="a" t-att-value="a[0]"
                t-att-selected="'selected' if a[0] == ppc['authorizer_id'] else None" t-esc="a[1]"/>
      </select>
    </div>
    <div class="dn-field">
      <label for="ppc-nota">Nota (opcional)</label>
      <input id="ppc-nota" class="dn-input" type="text" name="proveedor_nota" maxlength="200"
             autocomplete="off" t-att-value="ppc['note']"/>
    </div>
    <p class="comp-muted">Se acredita al cliente en «Pagos a proveedores por cuenta de clientes» y no se
      cruza con el reporte de Mercado Pago.</p>
  </template>

  <!-- a refused duplicate in a list; `u` is DistriReceiptUploadAttempt._distri_row,
       `href` the link -->
  <template id="comprobante_intento_row" name="Comprobante que ya estaba (fila)">
    <a class="comp-item comp-item--link comp-item--attempt" t-att-href="href" data-dn="down">
      <span class="comp-item__st comp-item__st--attempt" aria-hidden="true">⊘</span>
      <span class="comp-item__amt dn-num" t-esc="money(u['amount']) if u['amount'] else 'sin importe'"/>
      <span class="comp-item__who" t-esc="u['partner'] or 'sin cliente'"/>
      <small class="comp-item__state comp-item__flag" t-esc="u['flag']"/>
      <small class="comp-item__note">Llegó el <t t-esc="u['existing_when']"/> · <t t-esc="u['existing_channel']"/>
        · <t t-esc="u['bucket_label']"/> · intentado <t t-esc="u['date']"/></small>
    </a>
  </template>

  <template id="comprobantes_page" name="Subir comprobante">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Subir comprobante · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="comp dn-has-foot" t-att-data-parent="inicio" data-page="comprobantes">
  <header class="dn-top">
    <div class="dn-top__row">
      <a class="dn-icon-btn" t-att-href="inicio" data-dn-back="" aria-label="Volver al inicio">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'back'"/></t>
      </a>
      <div class="dn-top__txt">
        <span class="dn-top__kicker">Cobros · transferencias</span>
        <h1 class="dn-top__title">Subir comprobante</h1>
      </div>
      <t t-call="distri_pedido.dn_ajustes"/>
    </div>
  </header>
  <div t-if="error" class="dn-banner dn-banner--err" role="alert"><span t-esc="error"/></div>
  <!-- 19.0.1.126.0: the one-time notice of the instant crediting -->
  <form t-if="aviso_acreditar" class="dn-card dn-card--warn comp-aviso" method="post"
        action="/tablero/aviso-acreditar" role="alert">
    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
    <input type="hidden" name="volver" value="/comprobantes"/>
    <p t-esc="aviso_acreditar"/>
    <button type="submit" class="dn-btn">Entendido</button>
  </form>
  <main class="dn-main">
    <form id="comp-form" class="comp-form" method="post" action="/comprobantes/subir"
          enctype="multipart/form-data" data-comp-form="" data-comp-api="126"
          t-att-data-comp-credit="'1' if puede_acreditar else None">
      <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
      <input t-if="stage" type="hidden" name="compartido" t-att-value="stage.token"/>

      <div class="comp-pick">
        <label class="dn-btn dn-btn--lg comp-pick__btn">
          <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'camera'"/></t> Sacar foto
          <input type="file" name="archivos" accept="image/*" capture="environment" class="comp-file" data-comp-file=""/>
        </label>
        <label class="dn-btn dn-btn--outline dn-btn--lg comp-pick__btn">
          <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'image'"/></t> Elegir de galería
          <input type="file" name="archivos" accept="image/*,application/pdf,.pdf" multiple="multiple"
                 class="comp-file" data-comp-file=""/>
        </label>
        <p class="comp-muted">Varias a la vez, foto o PDF. En Android también podés tocar
          <b>Compartir</b> en WhatsApp y elegir <b>Distri</b>.</p>
      </div>

      <section class="comp-sel" data-comp-sel="" t-att-hidden="None if preview else 'hidden'">
        <h2 class="dn-label">Para subir</h2>
        <ul class="comp-thumbs comp-thumbs--rows" data-comp-thumbs="">
          <li t-foreach="preview" t-as="f" class="comp-thumb" t-att-data-comp-index="f['index']">
            <div class="comp-thumb__media">
              <img t-if="not f['pdf']" t-att-src="f['src']" alt="Comprobante compartido" data-comp-zoom=""/>
              <span t-else="" class="comp-thumb__pdf"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'doc'"/></t>PDF</span>
              <div t-if="not f['pdf']" class="comp-thumb__tools">
                <button type="button" class="comp-thumb__tool" data-comp-rotl="" aria-label="Girar a la izquierda">↺</button>
                <button type="button" class="comp-thumb__tool" data-comp-rot="" aria-label="Girar a la derecha">↻</button>
              </div>
            </div>
            <span class="comp-thumb__name" t-esc="f['name']"/>
            <input type="hidden" name="giro_compartido" value="0" data-comp-turn=""/>
            <label class="comp-thumb__amt">
              <span>Importe</span>
              <input class="dn-input dn-num" type="text" name="importe_compartido" inputmode="decimal"
                     autocomplete="off" maxlength="20" placeholder="Ej.: 150.000" enterkeyhint="done"
                     data-comp-amt=""/>
            </label>
          </li>
        </ul>
        <p t-if="preview" class="comp-muted">Llegaron con «Compartir con Distri».</p>
        <p class="comp-muted">Si sabés el importe, escribilo: administración lo compara con lo que lea
          del comprobante.</p>
      </section>

      <div class="dn-field comp-cliente">
        <label for="comp-q">¿De qué cliente?</label>
        <div class="comp-sug" data-comp-sug="" hidden="hidden" aria-live="polite"></div>
        <input type="hidden" name="cliente_id" data-comp-cliente-id=""/>
        <input id="comp-q" class="dn-input" type="search" autocomplete="off" maxlength="80"
               placeholder="Buscar cliente…" data-comp-q=""/>
        <ul class="comp-res" data-comp-res="" hidden="hidden"></ul>
        <p class="comp-muted" data-comp-cliente-txt="">Elegí el cliente: es obligatorio. El sistema puede
          sugerirlo, pero lo confirmás vos.</p>
      </div>
      <!-- 19.0.1.129.14: only grupo_pago_proveedor (the server checks again) -->
      <div t-if="puede_proveedor" class="dn-field comp-ppc">
        <label class="comp-check">
          <input type="checkbox" name="pago_proveedor" value="1" data-comp-ppc=""/>
          <span>Es un pago a proveedor autorizado por Gerencia</span>
        </label>
        <div class="comp-ppc__box" data-comp-ppc-box="">
          <p class="comp-muted">El cliente le transfirió directo a un proveedor de la empresa. Un solo
            comprobante por vez.</p>
          <t t-call="distri_pedido.comprobante_pago_proveedor_campos"/>
        </div>
      </div>
      <div class="dn-field comp-noesta">
        <label class="comp-check">
          <input type="checkbox" name="no_en_sistema" value="1" data-comp-noesta=""/>
          <span>No está en el sistema</span>
        </label>
        <div class="comp-noesta__box" data-comp-noesta-box="">
          <label for="comp-remitente">¿Quién lo mandó? (nombre, negocio o teléfono)</label>
          <input id="comp-remitente" class="dn-input" type="text" name="remitente" maxlength="200"
                 autocomplete="off" data-comp-remitente=""/>
          <p class="comp-muted">Queda pendiente de asignación, sin acreditar: administración elige el
            cliente y lo acredita. No se crea ningún cliente.</p>
        </div>
      </div>
      <input t-if="puede_acreditar" type="hidden" name="acreditar" value="1"/>
    </form>

    <ul class="comp-results" role="status" data-comp-results="" t-att-hidden="None if results else 'hidden'">
      <li t-foreach="results" t-as="r" t-att-class="'comp-r comp-r--%s comp-r--c-%s' % (r['status'], r.get('credit') or 'none')">
        <b t-esc="r['name']"/> <span t-esc="r['message']"/>
        <form t-if="r.get('credit') == 'aviso'" class="comp-r__confirm" method="post"
              t-att-action="'/comprobantes/%d/acreditar' % r['id']">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="importe" t-att-value="r['amount_text']"/>
          <input type="hidden" name="cliente_id" t-att-value="r['partner_id']"/>
          <input type="hidden" name="confirmado" value="1"/>
          <ul><li t-foreach="r['warnings']" t-as="w" t-esc="w"/></ul>
          <button type="submit" class="dn-btn">Acreditar igual</button>
        </form>
        <a t-if="r.get('supplier_url')" class="dn-btn comp-r__complete" t-att-href="r['supplier_url']"
           data-dn="down" t-esc="r['supplier_hint']"/>
        <a t-if="r['status'] == 'completar'" class="dn-btn comp-r__complete"
           t-att-href="r['url'] + ('?cliente_id=%s' % r['partner_id'] if r.get('partner_id') else '')"
           data-dn="down">Completar y acreditar</a>
      </li>
    </ul>

    <h2 class="dn-label">Subidos hoy por vos: <span data-comp-count="" t-esc="len(uploads)"/></h2>
    <p t-if="puede_acreditar" class="comp-muted">Tocá un comprobante pendiente para acreditarlo, cancelarlo
      o cambiar la foto.</p>
    <p t-else="" class="comp-muted">Tocá un comprobante pendiente para cancelarlo o cambiar la foto.</p>
    <div class="dn-empty" t-if="not rows" data-comp-empty="">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'empty'"/></t>
      <p>Todavía no subiste comprobantes hoy.</p>
    </div>
    <ul class="comp-list" data-comp-list="">
      <t t-foreach="rows" t-as="u">
      <li t-if="u.get('attempt')"><t t-call="distri_pedido.comprobante_intento_row"><t t-set="href" t-value="u['url']"/></t></li>
      <li t-else=""><a class="comp-item comp-item--link" t-att-href="u['url']" data-dn="down">
        <span t-att-class="'comp-item__st comp-item__st--%s' % ('reading' if u['reading'] else (u['state'] or 'pending'))"
              t-esc="'⏳' if u['reading'] or u['state'] in ('pending', 'no_money') else ('✓' if u['state'] in ('matched', 'registered') else '•')"/>
        <span class="comp-item__amt dn-num" t-esc="money(u['amount'] or u['amount_typed']) if (u['amount'] or u['amount_typed']) else ('leyendo…' if u['reading'] else 'sin importe')"/>
        <span class="comp-item__who" t-esc="u['partner'] or 'sin cliente'"/>
        <small class="comp-item__state" t-esc="u['state_label']"/>
        <small t-if="u['amount_differs']" class="comp-item__note comp-item__note--warn"
               t-esc="'Cargaste %s y el comprobante dice %s: lo revisa administración.' % (money(u['amount_typed']), money(u['amount']))"/>
        <small t-elif="u['amount_typed'] and u['reading']" class="comp-item__note">Importe cargado por vos · leyendo el comprobante…</small>
        <small t-if="u.get('sender_note')" class="comp-item__note">Lo mandó: <t t-esc="u['sender_note']"/></small>
      </a>
      <a t-if="u.get('complete_url')" class="dn-link comp-item__manage" t-att-href="u['complete_url']"
         data-dn="down">Completar y acreditar</a>
      <a t-if="u.get('supplier_url')" class="dn-link comp-item__manage" t-att-href="u['supplier_url']"
         data-dn="down">Cargalo como pago a proveedor</a>
      <a t-if="u.get('can_manage')" class="dn-link comp-item__manage" t-att-href="u['url'] + '#gestionar'"
         data-dn="down">Cancelar o cambiar la foto</a></li>
      </t>
    </ul>
    <p class="comp-more"><a class="dn-link" href="/comprobantes/mios" data-dn="down">Ver mis comprobantes de los
      últimos 30 días</a></p>
  </main>
  <div class="dn-bottom">
    <div class="dn-foot dn-foot--one">
      <button type="submit" form="comp-form" class="dn-btn dn-btn--lg" data-comp-send=""
              t-esc="'Subir y acreditar' if puede_acreditar else 'Subir'"/>
    </div>
    <!-- 19.0.1.129.29: the role's bottom bar (ui_v2 only) -->
    <t t-call="distri_pedido.dn_nav"/>
  </div>
</body>
</html>
  </template>

  <!-- «Ver comprobante» (19.0.1.100.0): read only, for whoever uploaded it
       and for administración / gerencia (controllers/comprobantes.py view) -->
  <template id="comprobante_ver_page" name="Ver comprobante">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Comprobante · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="comp" t-att-data-parent="parent" data-page="comprobante">
  <header class="dn-top">
    <div class="dn-top__row">
      <a class="dn-icon-btn" t-att-href="parent" data-dn-back="" aria-label="Volver">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'back'"/></t>
      </a>
      <div class="dn-top__txt">
        <span class="dn-top__kicker">Comprobante subido</span>
        <h1 class="dn-top__title dn-num" t-esc="money(r['amount'] or r['amount_typed']) if (r['amount'] or r['amount_typed']) else 'Sin importe'"/>
      </div>
    </div>
  </header>
  <main class="dn-main comp-ver">
    <t t-set="chip" t-value="{'pendiente': 'warn', 'aprobado': 'ok', 'rechazado': 'err'}.get(r['bucket'], 'neutral')"/>
    <p class="comp-ver__state">
      <span t-att-class="'dn-chip dn-chip--%s' % chip" t-esc="r['bucket_label']"/>
      <small class="comp-muted" t-if="r['state_label'] and r['state_label'] != r['bucket_label']" t-esc="r['state_label']"/>
    </p>
    <div t-if="r['note']" class="dn-card dn-card--warn comp-ver__note">
      <b>Aclaración de administración:</b> <span t-esc="r['note']"/>
    </div>
    <div t-if="manage_done" class="dn-card comp-ver__note" role="status">
      <b>✓</b> <span t-esc="manage_done"/>
    </div>
    <div t-if="manage_error" class="dn-card dn-card--warn comp-ver__note" role="alert">
      <span t-esc="manage_error"/>
    </div>
    <div t-if="r.get('cancel_note')" class="dn-card dn-card--warn comp-ver__note">
      <b t-esc="r['cancel_note']"/>
    </div>
    <div t-if="r.get('sender_note')" class="dn-card dn-card--warn comp-ver__note">
      <b>No está en el sistema.</b> Lo mandó: <span t-esc="r['sender_note']"/>.
      <t t-if="not r['partner']">Pendiente de asignación: administración elige el cliente y lo acredita.</t>
    </div>
    <div t-if="r.get('suggestions')" class="dn-card comp-ver__note">
      <b>Sugeridos:</b>
      <t t-foreach="r['suggestions']" t-as="sg"><span class="dn-chip dn-chip--neutral"><t t-esc="sg['name']"/> (<t t-esc="sg['reason']"/>)</span> </t>
      <small class="comp-muted">Asignalo en Cobros con «Elegir cliente».</small>
    </div>
    <div t-if="r['typed_note']" class="dn-card dn-card--warn comp-ver__note">
      <b>Importe distinto.</b> <span t-esc="r['typed_note']"/>. Lo revisa administración.
    </div>
    <dl class="comp-ver__facts">
      <dt>Importe</dt>
      <dd class="dn-num" t-esc="money(r['amount']) if r['amount'] else ('leyendo el comprobante…' if r['reading'] else 'sin importe leído')"/>
      <t t-if="r['amount_typed']"><dt>Importe que cargaste</dt><dd class="dn-num" t-esc="money(r['amount_typed'])"/></t>
      <dt>Cliente</dt><dd t-esc="r['partner'] or 'sin cliente (lo propone el sistema o administración)'"/>
      <dt>Subido</dt><dd><t t-esc="r['when']"/> · <t t-esc="r['uploader']"/></dd>
      <dt>Archivo</dt><dd class="comp-ver__file" t-esc="r['name']"/>
    </dl>
    <t t-if="r['file_url']">
      <a t-if="r['image']" class="comp-ver__photo" t-att-href="r['file_url']" target="_blank" rel="noopener">
        <img t-att-src="r['file_url']" alt="Foto del comprobante"/>
      </a>
      <a class="dn-btn dn-btn--outline dn-btn--lg" t-att-href="r['file_url']" target="_blank" rel="noopener">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'image' if r['image'] else 'doc'"/></t>
        <t t-esc="'Ver la foto en pantalla completa' if r['image'] else 'Abrir el PDF'"/>
      </a>
    </t>
    <!-- 19.0.1.126.2: «Completar y acreditar» the uploader's own receipt pending
         assignment (controllers/comprobantes.py complete) -->
    <div t-if="complete_error" class="dn-card dn-card--warn comp-ver__note" role="alert">
      <span t-esc="complete_error"/>
    </div>
    <form t-if="complete and not credit_done" id="completar" class="comp-credit comp-complete"
          method="post" t-att-action="'/comprobantes/%d/completar' % r['id']">
      <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
      <input type="hidden" name="desde" t-att-value="'mios' if parent == '/comprobantes/mios' else ''"/>
      <h2 class="dn-label" t-esc="'Completar y acreditar' if complete['credit'] else 'Completar'"/>
      <p class="dn-card dn-card--warn comp-ver__note" t-esc="complete['message']"/>
      <div t-if="complete['credit']" class="dn-field">
        <label for="complete-importe">Importe a acreditar</label>
        <input id="complete-importe" class="dn-input dn-num" type="text" name="importe"
               inputmode="decimal" maxlength="20" required="required"
               t-att-value="complete['amount_text']"/>
        <p class="comp-muted">
          <t t-if="complete['read_amount']">Leído en el comprobante: <t t-esc="money(complete['read_amount'])"/>.</t>
          <t t-else="">No se pudo leer el importe: escribilo mirando el comprobante.</t>
          <t t-if="complete['typed_amount']"> Cargado al subirlo: <t t-esc="money(complete['typed_amount'])"/>.</t>
        </p>
      </div>
      <div class="dn-field comp-cliente">
        <label for="comp-q">¿De qué cliente?</label>
        <div t-if="complete['suggestions']" class="comp-sug">
          <button t-foreach="complete['suggestions']" t-as="sg" type="button" class="comp-sug__chip"
                  t-att-data-comp-sug-id="sg['id']" t-att-data-name="sg['name']">Sugerido: <t t-esc="sg['name']"/>
            <small t-esc="sg['reason']"/></button>
        </div>
        <input type="hidden" name="cliente_id" data-comp-cliente-id="" t-att-value="complete['partner_id']"/>
        <input id="comp-q" class="dn-input" type="search" autocomplete="off" maxlength="80"
               placeholder="Buscar cliente…" data-comp-q=""/>
        <ul class="comp-res" data-comp-res="" hidden="hidden"></ul>
        <p class="comp-muted" data-comp-cliente-txt=""
           t-esc="('Se acredita a %s.' % complete['partner_name']) if complete['partner_name'] else 'Elegí el cliente: tocá la sugerencia si es ese, o buscalo.'"/>
      </div>
      <button type="submit" class="dn-btn dn-btn--lg"
              t-esc="'Completar y acreditar' if complete['credit'] else 'Completar'"/>
    </form>
    <!-- 19.0.1.129.14: registered as a supplier payment, or the way to do it -->
    <div t-if="r.get('supplier_payment')" class="dn-card comp-ver__note" role="status">
      <b>✓</b> Registrado como pago a proveedor <t t-esc="r['supplier_payment']['name']"/>:
      <t t-esc="money(r['supplier_payment']['amount'])"/>, proveedor <t t-esc="r['supplier_payment']['supplier']"/>,
      autorizó <t t-esc="r['supplier_payment']['authorized_by']"/> (<t t-esc="r['supplier_payment']['state']"/>).
      No se acredita de nuevo ni se cruza con el reporte de Mercado Pago.
    </div>
    <div t-if="r.get('supplier_url')" class="dn-card dn-card--warn comp-ver__note">
      <p>Es una transferencia a otra cuenta: no se acredita como cobro.</p>
      <a class="dn-btn" t-att-href="r['supplier_url'] + ('?desde=mios' if parent == '/comprobantes/mios' else '')"
         data-dn="down" t-esc="r['supplier_hint']"/>
    </div>
    <!-- 19.0.1.126.0: «Acreditar» (controllers/comprobantes.py credit) -->
    <div t-if="credit_done" class="dn-card comp-ver__note" role="status">
      <b>✓</b> <span t-esc="credit_done"/>
    </div>
    <div t-if="credit_error" class="dn-card dn-card--warn comp-ver__note" role="alert">
      <span t-esc="credit_error"/>
    </div>
    <form t-if="credit and not credit_done" class="comp-credit" method="post"
          t-att-action="'/comprobantes/%d/acreditar' % r['id']">
      <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
      <input type="hidden" name="desde" t-att-value="'mios' if parent == '/comprobantes/mios' else ''"/>
      <h2 class="dn-label">Acreditar</h2>
      <p class="dn-card dn-card--warn comp-ver__note" t-esc="credit['reminder']"/>
      <div class="dn-field">
        <label for="credit-importe">Importe a acreditar</label>
        <input id="credit-importe" class="dn-input dn-num" type="text" name="importe"
               inputmode="decimal" maxlength="20" required="required"
               t-att-value="credit['amount_text']"/>
        <p class="comp-muted">
          <t t-if="credit['read_amount']">Leído en el comprobante: <t t-esc="money(credit['read_amount'])"/>.</t>
          <t t-else="">No se pudo leer el importe: escribilo mirando el comprobante.</t>
          <t t-if="credit['typed_amount']"> Cargado al subirlo: <t t-esc="money(credit['typed_amount'])"/>.</t>
        </p>
      </div>
      <div class="dn-field comp-cliente">
        <label for="comp-q">Cliente</label>
        <input type="hidden" name="cliente_id" data-comp-cliente-id="" t-att-value="credit['partner_id']"/>
        <input id="comp-q" class="dn-input" type="search" autocomplete="off" maxlength="80"
               placeholder="Buscar cliente…" data-comp-q=""/>
        <ul class="comp-res" data-comp-res="" hidden="hidden"></ul>
        <p class="comp-muted" data-comp-cliente-txt="" t-esc="credit['partner_name'] or 'Elegí el cliente.'"/>
      </div>
      <div t-if="credit_warnings" class="dn-card dn-card--warn comp-ver__note" role="alert">
        <b>Revisá antes de acreditar:</b>
        <ul><li t-foreach="credit_warnings" t-as="w" t-esc="w"/></ul>
        <input type="hidden" name="confirmado" value="1"/>
      </div>
      <button type="submit" class="dn-btn dn-btn--lg"
              t-esc="'Acreditar igual' if credit_warnings else 'Acreditar'"/>
    </form>
    <p t-if="not credit and not complete" class="comp-muted">Lo aprueba o lo descarta administración en Cobros.</p>
    <!-- 19.0.1.126.1: «Girar», «Cambiar foto», «Cancelar» (controllers/comprobantes.py _manage) -->
    <section t-if="r.get('manage')" id="gestionar" class="comp-manage">
      <h2 class="dn-label">Corregir</h2>
      <div t-if="r['image'] and not r['credited']" class="comp-manage__row">
        <form method="post" t-att-action="'/comprobantes/%d/girar' % r['id']">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="sentido" value="izquierda"/>
          <button type="submit" class="dn-btn dn-btn--outline" aria-label="Girar a la izquierda">↺ Girar</button>
        </form>
        <form method="post" t-att-action="'/comprobantes/%d/girar' % r['id']">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="sentido" value="derecha"/>
          <button type="submit" class="dn-btn dn-btn--outline" aria-label="Girar a la derecha">↻ Girar</button>
        </form>
      </div>
      <form class="comp-manage__form" method="post" enctype="multipart/form-data"
            t-att-action="'/comprobantes/%d/cambiar-foto' % r['id']">
        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
        <label for="comp-nueva">Cambiar foto</label>
        <input id="comp-nueva" class="dn-input" type="file" name="archivo" required="required"
               accept="image/*,application/pdf,.pdf"/>
        <p t-if="r['credited']" class="comp-muted">Está acreditado: al cambiar la foto se anula la
          acreditación y después lo acreditás de nuevo.</p>
        <button type="submit" class="dn-btn dn-btn--outline">Cambiar foto</button>
      </form>
      <form class="comp-manage__form" method="post" t-att-action="'/comprobantes/%d/cancelar' % r['id']">
        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
        <label for="comp-motivo">Cancelar el comprobante</label>
        <input id="comp-motivo" class="dn-input" type="text" name="motivo" maxlength="200"
               required="required" placeholder="Motivo (ej.: lo subí dos veces)"/>
        <p t-if="r['credited']" class="comp-muted">Está acreditado: al cancelarlo se anula la acreditación.</p>
        <button type="submit" class="dn-btn dn-btn--danger">Cancelar comprobante</button>
      </form>
    </section>
  </main>
</body>
</html>
  </template>

  <!-- «Mis comprobantes» (19.0.1.100.0): the user's uploads of the last
       days, by state -->
  <!-- 19.0.1.129.14: «Cargalo como pago a proveedor» of an uploaded receipt
       (controllers/comprobantes.py supplier_page / supplier_register) -->
  <template id="comprobante_pago_proveedor_page" name="Pago a proveedor">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Pago a proveedor · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="comp" t-att-data-parent="'/comprobantes/%d' % r['id']" data-page="comprobante-proveedor">
  <header class="dn-top">
    <div class="dn-top__row">
      <a class="dn-icon-btn" t-att-href="'/comprobantes/%d' % r['id']" data-dn-back="" aria-label="Volver">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'back'"/></t>
      </a>
      <div class="dn-top__txt">
        <span class="dn-top__kicker">Autorizado por Gerencia</span>
        <h1 class="dn-top__title">Pago a proveedor</h1>
      </div>
    </div>
  </header>
  <main class="dn-main comp-ver">
    <div t-if="done" class="dn-card comp-ver__note" role="status"><b>✓</b> <span t-esc="done"/></div>
    <div t-if="error" class="dn-card dn-card--warn comp-ver__note" role="alert"><span t-esc="error"/></div>
    <div t-if="problem" class="dn-card dn-card--warn comp-ver__note" role="alert"><span t-esc="problem"/></div>
    <t t-if="r['file_url']">
      <a t-if="r['image']" class="comp-ver__photo" t-att-href="r['file_url']" target="_blank" rel="noopener">
        <img t-att-src="r['file_url']" alt="Comprobante subido"/>
      </a>
      <a t-else="" class="dn-link" t-att-href="r['file_url']" target="_blank" rel="noopener">Abrir el PDF</a>
    </t>
    <form t-if="not done and not problem" class="comp-credit comp-ppc-form" method="post"
          t-att-action="'/comprobantes/%d/pago-proveedor' % r['id']">
      <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
      <input type="hidden" name="desde" t-att-value="'mios' if parent == '/comprobantes/mios' else ''"/>
      <p class="comp-muted">El cliente le transfirió directo a un proveedor de la empresa, con
        autorización de Gerencia.</p>
      <div class="dn-field comp-cliente">
        <label for="comp-q">Cliente</label>
        <input type="hidden" name="cliente_id" data-comp-cliente-id="" t-att-value="partner_id"/>
        <input id="comp-q" class="dn-input" type="search" autocomplete="off" maxlength="80"
               placeholder="Buscar cliente…" data-comp-q=""/>
        <ul class="comp-res" data-comp-res="" hidden="hidden"></ul>
        <p class="comp-muted" data-comp-cliente-txt="" t-esc="('Cliente: %s.' % partner_name) if partner_name else 'Elegí el cliente.'"/>
      </div>
      <t t-call="distri_pedido.comprobante_pago_proveedor_campos"/>
      <button type="submit" class="dn-btn dn-btn--lg">Registrar pago a proveedor</button>
    </form>
    <p><a class="dn-link" t-att-href="parent" data-dn="down">Volver a los comprobantes</a></p>
