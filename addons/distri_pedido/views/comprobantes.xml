              <field name="message_id" context="{'form_view_ref': 'distri_pedido.view_receipt_form'}"/>
              <field name="message_timestamp"/>
              <field name="partner_id"/>
              <field name="channel"/>
              <field name="receipt_state"/>
            </group>
          </group>
        </sheet>
      </form>
