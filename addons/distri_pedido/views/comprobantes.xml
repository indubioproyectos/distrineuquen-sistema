</body>
</html>
  </template>

  <template id="comprobantes_mios_page" name="Mis comprobantes">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Mis comprobantes · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="comp" data-parent="/comprobantes" data-page="comprobantes-mios">
  <header class="dn-top">
    <div class="dn-top__row">
      <a class="dn-icon-btn" href="/comprobantes" data-dn-back="" aria-label="Volver a Subir comprobante">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'back'"/></t>
      </a>
      <div class="dn-top__txt">
        <span class="dn-top__kicker">Últimos <t t-esc="days"/> días</span>
        <h1 class="dn-top__title">Mis comprobantes</h1>
      </div>
    </div>
  </header>
  <main class="dn-main">
    <nav class="comp-filters" aria-label="Filtrar por estado">
      <a t-foreach="filters" t-as="f" t-att-href="'/comprobantes/mios' + ('?estado=%s' % f[0] if f[0] else '')"
         t-att-class="'dn-chip ' + ('dn-chip--ok' if f[0] == estado else 'dn-chip--neutral')"
         t-att-aria-current="'page' if f[0] == estado else None" data-dn="side" t-esc="f[1]"/>
    </nav>
    <div class="dn-empty" t-if="not rows">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'empty'"/></t>
      <p t-if="estado == 'repetido'">No intentaste subir comprobantes que ya estaban.</p>
      <p t-else="">No hay comprobantes<t t-if="estado"> en este estado</t>.</p>
    </div>
    <ul class="comp-list" t-if="rows">
      <t t-foreach="rows" t-as="u">
      <li t-if="u.get('attempt')"><t t-call="distri_pedido.comprobante_intento_row"><t t-set="href" t-value="u['url'] + '?desde=mios'"/></t></li>
      <li t-else=""><a class="comp-item comp-item--link" t-att-href="u['url'] + '?desde=mios'" data-dn="down">
        <span t-att-class="'comp-item__st comp-item__st--%s' % u['bucket']"
              t-esc="{'aprobado': '✓', 'rechazado': '✕', 'pendiente': '⏳'}.get(u['bucket'], '•')"/>
        <span class="comp-item__amt dn-num" t-esc="money(u['amount'] or u['amount_typed']) if (u['amount'] or u['amount_typed']) else 'sin importe'"/>
        <span class="comp-item__who" t-esc="u['partner'] or 'sin cliente'"/>
        <small class="comp-item__state"><t t-esc="u['bucket_label']"/> · <t t-esc="u['date']"/></small>
      </a></li>
      </t>
    </ul>
  </main>
</body>
</html>
  </template>

  <!-- A refused duplicate (19.0.1.101.0): the receipt that was already in the
       system, for the user who tried to upload it again. Only what is needed
       to recognise it: no notes of administración, no actions. -->
  <template id="comprobante_intento_page" name="Comprobante que ya estaba">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Ya estaba cargado · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="comp" t-att-data-parent="parent" data-page="comprobante-intento">
  <header class="dn-top">
    <div class="dn-top__row">
      <a class="dn-icon-btn" t-att-href="parent" data-dn-back="" aria-label="Volver">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'back'"/></t>
      </a>
      <div class="dn-top__txt">
        <span class="dn-top__kicker" t-esc="'El que estaba se canceló' if r.get('cancelled') else 'Ya estaba en el sistema'"/>
        <h1 class="dn-top__title dn-num" t-esc="money(r['amount']) if r['amount'] else 'Sin importe'"/>
      </div>
    </div>
  </header>
  <main class="dn-main comp-ver">
    <div t-if="r.get('cancelled')" class="dn-card comp-ver__note">
      <b t-esc="r['flag']"/>. Este comprobante se canceló después de tu intento: ya no está en el
      sistema, así que lo podés subir de nuevo desde «Subir comprobante».
    </div>
    <div t-else="" class="dn-card dn-card--warn comp-ver__note">
      <b t-esc="r['flag']"/>. Este es el comprobante que ya estaba: no hace falta subirlo de nuevo.
    </div>
    <t t-set="chip" t-value="{'pendiente': 'warn', 'aprobado': 'ok', 'rechazado': 'err'}.get(r['bucket'], 'neutral')"/>
    <dl class="comp-ver__facts">
      <dt>Importe</dt><dd class="dn-num" t-esc="money(r['amount']) if r['amount'] else 'sin importe leído'"/>
      <dt>Cliente</dt><dd t-esc="r['partner'] or 'sin cliente'"/>
      <dt>Llegó</dt><dd t-esc="r['existing_when']"/>
      <dt>Cómo llegó</dt><dd t-esc="r['existing_channel']"/>
      <dt>Estado</dt><dd><span t-att-class="'dn-chip dn-chip--%s' % chip" t-esc="r['bucket_label']"/></dd>
    </dl>
    <t t-if="r['file_url']">
      <a t-if="r['image']" class="comp-ver__photo" t-att-href="r['file_url']" target="_blank" rel="noopener">
        <img t-att-src="r['file_url']" alt="Foto del comprobante que ya estaba"/>
      </a>
      <a class="dn-btn dn-btn--outline dn-btn--lg" t-att-href="r['file_url']" target="_blank" rel="noopener">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'image' if r['image'] else 'doc'"/></t>
        <t t-esc="'Ver la foto en pantalla completa' if r['image'] else 'Abrir el PDF'"/>
      </a>
    </t>
    <h2 class="dn-label">Tu intento</h2>
    <dl class="comp-ver__facts">
      <dt>Cuándo</dt><dd t-esc="r['when']"/>
      <dt>Desde</dt><dd t-esc="r['via_label']"/>
      <dt>Archivo</dt><dd class="comp-ver__file" t-esc="r['name']"/>
      <t t-if="r['amount_typed']"><dt>Importe que cargaste</dt><dd class="dn-num" t-esc="money(r['amount_typed'])"/></t>
    </dl>
  </main>
</body>
</html>
  </template>

  <!-- ================================================= back office (19.0.1.101.0) -->

  <record id="view_receipt_upload_attempt_list" model="ir.ui.view">
    <field name="name">distri.receipt.upload.attempt.list</field>
    <field name="model">distri.receipt.upload.attempt</field>
    <field name="arch" type="xml">
      <list string="Intentos repetidos" create="0" edit="0" delete="0">
        <field name="attempted_at"/>
        <field name="user_id"/>
        <field name="via"/>
        <field name="file_name"/>
        <field name="amount_typed" optional="show" invisible="not amount_typed"/>
        <field name="message_id" optional="hide"/>
        <field name="message_timestamp"/>
        <field name="partner_id"/>
        <field name="channel"/>
        <field name="receipt_state" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_receipt_upload_attempt_form" model="ir.ui.view">
    <field name="name">distri.receipt.upload.attempt.form</field>
    <field name="model">distri.receipt.upload.attempt</field>
    <field name="arch" type="xml">
      <form string="Intento repetido" create="0" edit="0" delete="0">
        <sheet>
          <group>
