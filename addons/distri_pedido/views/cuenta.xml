<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_cuenta_list" model="ir.ui.view">
    <field name="name">distri.cuenta.movimiento.list</field>
    <field name="model">distri.cuenta.movimiento</field>
    <field name="arch" type="xml">
      <list string="Cuenta corriente" create="false" default_order="fecha desc">
        <field name="fecha"/>
        <field name="partner_id"/>
        <field name="comprobante"/>
        <field name="tipo"/>
        <field name="concepto" optional="hide"/>
        <field name="debe"/>
        <field name="haber"/>
        <field name="distri_owed" optional="show"/>
        <field name="distri_owed_amount" optional="hide"/>
        <field name="distri_owed_note" optional="hide"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <!-- 19.0.1.129.55 (owner): «Total debe» / «Total haber» at the foot of
       the list add up every customer listed (the aggregate debt), so only
       gerencia, administración and Sistemas get them (models/cuentas_app.py
       ve_total_deuda / TOTAL_VIEW_GROUPS). A seller keeps the rows and each
       customer's own group subtotal -->
  <record id="view_cuenta_list_total" model="ir.ui.view">
    <field name="name">distri.cuenta.movimiento.list.total</field>
    <field name="model">distri.cuenta.movimiento</field>
    <field name="inherit_id" ref="view_cuenta_list"/>
    <field name="group_ids" eval="[(4, ref('distri_pedido.grupo_administracion')), (4, ref('base.group_system')), (4, ref('distri_pedido.grupo_ingresos_reporte'))]"/>
    <field name="arch" type="xml">
      <field name="debe" position="attributes">
        <attribute name="sum">Total debe</attribute>
      </field>
      <field name="haber" position="attributes">
        <attribute name="sum">Total haber</attribute>
      </field>
    </field>
  </record>

  <record id="action_cuenta" model="ir.actions.act_window">
    <field name="name">Cuenta corriente</field>
    <field name="res_model">distri.cuenta.movimiento</field>
    <field name="view_mode">list</field>
    <field name="context">{'search_default_g_cliente': 1}</field>
  </record>

  <menuitem id="menu_cuenta_raiz" name="Cuenta corriente" sequence="55"/>
  <menuitem id="menu_cuenta_mov" name="Movimientos"
            parent="menu_cuenta_raiz" action="action_cuenta" sequence="10"/>

  <record id="view_partner_form_cuenta" model="ir.ui.view">
    <field name="name">res.partner.form.cuenta</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button class="oe_stat_button" type="object" name="action_ver_cuenta" icon="fa-list">
          <field name="cantidad_movimientos" widget="statinfo" string="Movimientos"/>
        </button>
      </div>
    </field>
  </record>

</odoo>
