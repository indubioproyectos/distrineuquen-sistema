<?xml version="1.0" encoding="utf-8"?>
<!-- Puesta al día de las cuentas corrientes en el lab (19.0.1.38.0,
     models/puesta_al_dia.py). Guía: documentacion/integraciones/puesta-al-dia-cobros.md -->
<odoo>

  <!-- ===================================================== MP import: xlsx and range -->

  <record id="view_mp_import_form_puesta" model="ir.ui.view">
    <field name="name">distri.mp.import.form.puesta</field>
    <field name="model">distri.mp.import</field>
    <field name="inherit_id" ref="distri_pedido.view_mp_import_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@invisible='report_id']/p" position="replace">
        <p>Reporte «Todas las transacciones» de Mercado Pago, en .csv o .xlsx. Cada operación se
           carga una sola vez: se puede subir un reporte que se superpone con otro. Al cargar, las
           operaciones que ya están en el sistema anterior salen del tablero como «Ya cargado en Online»
           y los pagadores mayoristas quedan apartados.</p>
      </xpath>
      <xpath expr="//field[@name='filename']" position="after">
        <field name="date_from"/>
        <field name="date_to"/>
      </xpath>
    </field>
  </record>

  <!-- ===================================================== board -->

  <record id="view_mp_collection_form_online" model="ir.ui.view">
    <field name="name">distri.mp.collection.form.online</field>
    <field name="model">distri.mp.collection</field>
    <field name="inherit_id" ref="distri_pedido.view_mp_collection_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_online_unlink" type="object" string="No está en Online"
                invisible="not online_payment_id or export_batch_id"
                groups="distri_pedido.grupo_cobros,base.group_system"
                confirm="El pago de Online del mismo importe es otro cobro: este vuelve al tablero y no se vincula de nuevo por importe. ¿Seguir?"/>
      </xpath>
      <xpath expr="//header" position="after">
        <div class="alert alert-info mb-0" role="status" invisible="online_status == 'none'">
          <b><field name="online_status" readonly="1" class="oe_inline"/></b>
          <span invisible="not online_label"> · <field name="online_label" readonly="1" class="oe_inline"/></span>
          <span invisible="not export_batch_id"> · <field name="export_batch_id" readonly="1" class="oe_inline"/></span>
        </div>
        <div class="alert alert-warning mb-0" role="alert" invisible="not online_conflict">
          <b>Posible doble carga:</b> <field name="online_conflict" readonly="1" class="oe_inline"/>
        </div>
        <field name="online_payment_id" invisible="1"/>
      </xpath>
    </field>
  </record>

  <record id="view_mp_collection_list_online" model="ir.ui.view">
    <field name="name">distri.mp.collection.list.online</field>
    <field name="model">distri.mp.collection</field>
    <field name="arch" type="xml">
      <list string="Cobros ya cargados en Online" create="0" delete="0">
        <field name="date"/>
        <field name="source_id"/>
        <field name="amount" sum="Total"/>
        <field name="payer_name"/>
        <field name="partner_id"/>
        <field name="online_label"/>
        <field name="online_status"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="online_payment_id" column_invisible="1"/>
        <field name="export_batch_id" column_invisible="1"/>
        <button name="action_online_unlink" type="object" string="No está en Online"
                invisible="not online_payment_id or export_batch_id"
                confirm="El pago de Online del mismo importe es otro cobro: este vuelve al tablero. ¿Seguir?"
                groups="distri_pedido.grupo_cobros,base.group_system"/>
      </list>
    </field>
  </record>

  <record id="action_mp_online_already" model="ir.actions.act_window">
    <field name="name">Ya cargados en Online</field>
    <field name="res_model">distri.mp.collection</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_mp_collection_list_online"/>
    <field name="domain">[('online_status', '=', 'already')]</field>
    <field name="help" type="html">
      <p>Ingresos de Mercado Pago que el sistema anterior ya tiene registrados (mismo importe y fecha en
         el diario Banco). No pasan por el tablero y nunca se exportan. Si uno no corresponde,
         «No está en Online» lo devuelve al tablero.</p>
    </field>
  </record>

  <!-- ===================================================== export -->

  <record id="view_online_export_wizard" model="ir.ui.view">
    <field name="name">distri.online.export.wizard.form</field>
    <field name="model">distri.online.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar para el sistema anterior">
        <p>Arma la planilla para <b>Importar registros</b> en el sistema anterior (Contabilidad ›
           Clientes › Pagos). Lleva solo los cobros confirmados en el lab que Online no tiene y
           que no se exportaron antes. Los cobros entran en Online como borrador.</p>
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="ready_count"/>
            <field name="ready_total"/>
            <field name="pending_count"/>
            <field name="blocked_count"/>
            <field name="currency_id" invisible="1"/>
          </group>
        </group>
        <label for="check_text"/>
        <field name="check_text" nolabel="1"/>
        <group>
          <field name="allow_pending" invisible="not pending_count"/>
        </group>
        <footer>
          <button name="action_export" type="object" string="Exportar" class="btn-primary"
                  groups="distri_pedido.grupo_cobros,base.group_system"/>
          <button special="cancel" string="Cerrar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_online_export_wizard" model="ir.actions.act_window">
    <field name="name">Exportar para el sistema anterior</field>
    <field name="res_model">distri.online.export.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="view_online_export_list" model="ir.ui.view">
    <field name="name">distri.online.export.list</field>
    <field name="model">distri.online.export</field>
    <field name="arch" type="xml">
      <list string="Lotes exportados" create="0" delete="0">
        <field name="name"/>
        <field name="exported_at"/>
        <field name="exported_by_id"/>
        <field name="row_count"/>
        <field name="total" sum="Total"/>
        <field name="loaded_count"/>
        <field name="currency_id" column_invisible="1"/>
        <button name="action_download" type="object" string="Descargar de nuevo"
                icon="fa-download"/>
      </list>
    </field>
  </record>

  <record id="view_online_export_form" model="ir.ui.view">
    <field name="name">distri.online.export.form</field>
    <field name="model">distri.online.export</field>
    <field name="arch" type="xml">
      <form string="Lote exportado" create="0" edit="0" delete="0">
        <header>
          <button name="action_download" type="object" string="Descargar de nuevo"
                  class="btn-primary"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="exported_at"/>
              <field name="exported_by_id"/>
            </group>
            <group>
              <field name="row_count"/>
              <field name="total"/>
              <field name="loaded_count"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <field name="collection_ids">
            <list>
              <field name="date"/>
              <field name="source_id"/>
              <field name="partner_id"/>
              <field name="amount" sum="Total"/>
              <field name="online_status"/>
              <field name="online_label"/>
              <field name="currency_id" column_invisible="1"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_online_export" model="ir.actions.act_window">
    <field name="name">Lotes exportados para Online</field>
    <field name="res_model">distri.online.export</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ===================================================== Online payments (read only) -->

  <record id="view_online_payment_list" model="ir.ui.view">
    <field name="name">distri.online.payment.list</field>
    <field name="model">distri.online.payment</field>
    <field name="arch" type="xml">
      <list string="Pagos del sistema anterior" create="0" edit="0" delete="0">
        <field name="date"/>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="online_partner_id" optional="hide"/>
        <field name="amount" sum="Total"/>
        <field name="journal_name"/>
        <field name="memo"/>
        <field name="state"/>
        <field name="collection_id"/>
        <field name="link_kind"/>
        <field name="synced_at" optional="hide"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_online_payment_search" model="ir.ui.view">
    <field name="name">distri.online.payment.search</field>
    <field name="model">distri.online.payment</field>
    <field name="arch" type="xml">
      <search>
        <field name="partner_id"/>
        <field name="memo"/>
        <field name="name"/>
        <filter name="linked" string="Con ingreso de MP" domain="[('collection_id', '!=', False)]"/>
        <filter name="from_lab" string="Exportados del lab" domain="[('link_kind', '=', 'memo')]"/>
        <filter name="draft" string="Borrador en Online" domain="[('state', '=', 'draft')]"/>
      </search>
    </field>
  </record>

  <record id="action_online_payment" model="ir.actions.act_window">
    <field name="name">Pagos del sistema anterior</field>
    <field name="res_model">distri.online.payment</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p>Copia de lectura de los cobros del sistema anterior, de la última sincronización
         (scripts/online/leer_online.py). Sirve para saber qué ya está cargado allá.</p>
    </field>
  </record>

  <!-- ===================================================== balances -->

  <record id="view_online_balance_list" model="ir.ui.view">
    <field name="name">distri.online.balance.list</field>
    <field name="model">distri.online.balance</field>
    <field name="arch" type="xml">
      <list string="Saldos lab vs Online" create="0" edit="0" delete="0"
            decoration-success="explained" decoration-danger="not explained">
        <field name="partner_id"/>
        <field name="online_id"/>
        <field name="online_balance" sum="Total"/>
        <field name="lab_balance" sum="Total"/>
        <field name="difference" sum="Total"/>
        <field name="lab_only" sum="Total"/>
        <field name="explained"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="action_online_balance" model="ir.actions.server">
    <field name="name">Saldos lab vs Online</field>
    <field name="model_id" ref="model_distri_online_balance"/>
    <field name="state">code</field>
    <field name="code">action = model.action_compare()</field>
    <field name="group_ids" eval="[(4, ref('distri_pedido.grupo_administracion'))]"/>
  </record>

  <!-- ===================================================== WhatsApp chat -->

  <record id="view_chat_import_wizard" model="ir.ui.view">
    <field name="name">distri.whatsapp.chat.import.wizard.form</field>
    <field name="model">distri.whatsapp.chat.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Importar chat de WhatsApp">
        <div invisible="import_id">
          <p>El chat del grupo de comprobantes exportado desde WhatsApp («Exportar chat ›
             Incluir archivos»), en .zip. WhatsApp exporta todo el historial: acá se elige el
             período. Cada foto y PDF se lee como comprobante y se une a su ingreso de Mercado
             Pago con las mismas reglas del tablero. Importar dos veces no duplica nada.</p>
          <p class="text-muted">Hasta 100 MB por acá. Un chat más grande se importa en el
             servidor con <code>scripts/importar-chat-whatsapp.sh</code>.</p>
          <group>
            <field name="file" filename="filename"/>
            <field name="filename" invisible="1"/>
            <field name="owner"/>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
        </div>
        <div invisible="not import_id">
          <field name="import_id" invisible="1"/>
          <field name="summary" nolabel="1"/>
        </div>
        <footer>
          <button name="action_import" type="object" string="Importar" class="btn-primary"
                  invisible="import_id"/>
          <button special="cancel" string="Cerrar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_chat_import_wizard" model="ir.actions.act_window">
    <field name="name">Importar chat de WhatsApp</field>
    <field name="res_model">distri.whatsapp.chat.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="view_chat_import_list" model="ir.ui.view">
    <field name="name">distri.whatsapp.chat.import.list</field>
    <field name="model">distri.whatsapp.chat.import</field>
    <field name="arch" type="xml">
      <list string="Chats importados" create="0" edit="0" delete="0">
        <field name="imported_at"/>
        <field name="name"/>
        <field name="distri_export_owner"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="message_count"/>
        <field name="file_count"/>
        <field name="duplicate_count"/>
        <field name="receipt_count"/>
        <field name="matched_count"/>
        <field name="summary" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="action_chat_import" model="ir.actions.act_window">
    <field name="name">Chats importados</field>
    <field name="res_model">distri.whatsapp.chat.import</field>
    <field name="view_mode">list</field>
  </record>

  <!-- ===================================================== menu -->

  <record id="action_mp_import_wizard" model="ir.actions.act_window">
    <field name="name">Importar reporte de Mercado Pago</field>
    <field name="res_model">distri.mp.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_cobros_puesta" name="Puesta al día" parent="menu_cobros_root"
            sequence="15" groups="distri_pedido.grupo_administracion,base.group_system"/>
  <menuitem id="menu_puesta_mp" name="Importar reporte MP" parent="menu_cobros_puesta"
            action="action_mp_import_wizard" sequence="10"/>
  <menuitem id="menu_puesta_chat" name="Importar chat de WhatsApp (zip)"
            parent="menu_cobros_puesta" action="action_chat_import_wizard" sequence="20"/>
  <menuitem id="menu_puesta_chats" name="Chats importados" parent="menu_cobros_puesta"
            action="action_chat_import" sequence="25"/>
  <menuitem id="menu_puesta_online" name="Ya cargados en Online" parent="menu_cobros_puesta"
            action="action_mp_online_already" sequence="30"/>
  <menuitem id="menu_puesta_export" name="Exportar para el sistema anterior" parent="menu_cobros_puesta"
            action="action_online_export_wizard" sequence="40" groups="distri_pedido.grupo_cobros,base.group_system"/>
  <menuitem id="menu_puesta_batches" name="Lotes exportados" parent="menu_cobros_puesta"
            action="action_online_export" sequence="45"/>
  <menuitem id="menu_puesta_balances" name="Saldos lab vs Online" parent="menu_cobros_puesta"
            action="action_online_balance" sequence="50"/>
  <menuitem id="menu_puesta_online_payments" name="Pagos del sistema anterior (lectura)"
            parent="menu_cobros_puesta" action="action_online_payment" sequence="60"/>

</odoo>
