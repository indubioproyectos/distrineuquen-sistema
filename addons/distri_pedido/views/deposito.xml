<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===================================== order: depot delivery, counter sale -->

  <record id="view_order_form_deposito" model="ir.ui.view">
    <field name="name">sale.order.form.deposito</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <field name="distri_delivery_state" invisible="1"/>
        <field name="distri_partner_generic" invisible="1"/>
        <field name="distri_armado" invisible="1"/>
        <button name="action_distri_depot_delivery" type="object" string="Entrega en depósito"
                groups="distri_pedido.grupo_administracion"
                invisible="state != 'sale' or distri_armado != 'armado' or distri_partner_generic or distri_delivery_state in ('delivered', 'on_route', 'dispatched')"/>
        <button name="action_distri_counter_sale" type="object" string="Venta en mostrador"
                groups="distri_pedido.grupo_administracion" context="{'distri_wa_ask': True}"
                invisible="state not in ('draft', 'sent') or distri_partner_generic or distri_armado != 'pendiente'"
                confirm="Se confirma el pedido, se arma completo tal como se pidió, se valida el remito y sale la factura. Después se registra la entrega y el cobro. ¿Seguir?"/>
      </xpath>
    </field>
  </record>

  <record id="view_depot_delivery_form" model="ir.ui.view">
    <field name="name">distri.depot.delivery.form</field>
    <field name="model">distri.depot.delivery</field>
    <field name="arch" type="xml">
      <form string="Entrega en depósito">
        <field name="counter_sale" invisible="1"/>
        <field name="has_code" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <div class="alert alert-info" role="status" invisible="not counter_sale">
          El pedido ya quedó confirmado, armado completo, con remito y factura. Registrá lo que se
          lleva el cliente y cómo paga.
        </div>
        <group>
          <group string="Pedido">
            <field name="order_id" options="{'no_open': True}"/>
            <field name="partner_id" options="{'no_open': True}"/>
            <field name="parcels" readonly="not counter_sale"/>
          </group>
          <group string="Saldo">
            <field name="order_amount"/>
            <field name="previous_debt"/>
            <field name="returns_amount" invisible="returns_answer != 'yes'"/>
            <field name="expected_balance" class="fw-bold"/>
          </group>
        </group>
        <separator string="Detalle de productos"/>
        <field name="order_line_ids" readonly="1" nolabel="1">
          <list create="0" delete="0">
            <field name="product_id"/>
            <field name="product_uom_qty" string="Cantidad"/>
            <field name="product_uom_id" string="Unidad"/>
            <field name="price_total" string="Importe"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="display_type" column_invisible="1"/>
          </list>
        </field>

        <separator string="¿Devolvió algo?"/>
        <field name="returns_answer" widget="radio" options="{'horizontal': true}" required="1"
               nolabel="1"/>
        <div invisible="returns_answer != 'yes'">
          <field name="return_ids" nolabel="1">
            <list editable="bottom">
              <field name="order_id" column_invisible="1"/>
              <field name="currency_id" column_invisible="1"/>
              <field name="order_line_id" options="{'no_create': True, 'no_open': True}"
                     domain="[('order_id', '=', parent.order_id), ('display_type', '=', False), ('product_uom_qty', '&gt;', 0)]"/>
              <field name="quantity"/>
              <field name="reason" placeholder="Vencido, roto, no lo pidió…"/>
              <field name="amount" sum="Total"/>
            </list>
          </field>
          <group>
            <field name="returns_received"/>
          </group>
          <div class="text-muted small">La nota de crédito sale solo por lo recibido en el depósito.
            Sin la marca, la devolución queda para controlar en el cierre de caja depósito.</div>
        </div>

        <separator string="Código de recibido"/>
        <group invisible="not counter_sale">
          <field name="counter_present"/>
        </group>
        <group invisible="counter_sale and counter_present">
          <field name="code_option" widget="radio" nolabel="1" colspan="2"/>
          <field name="code" invisible="code_option != 'code'" required="code_option == 'code' and not (counter_sale and counter_present)"
                 placeholder="4 dígitos"/>
        </group>
        <div class="text-muted small" invisible="has_code or (counter_sale and counter_present)">
          Este pedido no tiene código cargado. Usá «Entregar igual».
        </div>
        <div class="text-warning small" invisible="code_option != 'without_code' or (counter_sale and counter_present)">
          Queda como «Entregado sin código»: ante un reclamo por faltantes no hay constancia de recibido.
        </div>

        <separator string="¿Cómo pagó?"/>
        <group>
          <group>
            <field name="cash"/>
            <field name="transfer" widget="radio" options="{'horizontal': true}"/>
            <field name="transfer_amount" invisible="transfer != 'yes'"
                   required="transfer == 'yes'"/>
            <field name="receipt_answer" widget="radio" invisible="transfer != 'yes'"
                   required="transfer == 'yes'"/>
          </group>
          <group>
            <field name="no_payment" invisible="cash or transfer != 'no'"/>
            <field name="comment"/>
          </group>
        </group>
        <div class="text-muted small">El efectivo entra en «Caja depósito» y se aplica a las
          facturas del cliente, la más vieja primero. Una transferencia queda como comprobante
          pendiente hasta que el comprobante llega a la empresa: nunca crea un pago.</div>
        <footer>
          <button name="action_confirm" type="object" string="Registrar entrega" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ============================================ Cierre de caja depósito -->

  <record id="view_depot_close_list" model="ir.ui.view">
    <field name="name">distri.route.depot.list</field>
    <field name="model">distri.route</field>
    <field name="priority">30</field>
    <field name="arch" type="xml">
      <list string="Cierre de caja depósito" create="0" decoration-muted="state == 'settled'"
            decoration-danger="depot_overdue"
            decoration-warning="cash_count_done and cash_difference != 0">
        <field name="date"/>
        <!-- 19.0.1.93.0 (E2E-C C16): a box of a day before, still open -->
        <field name="depot_overdue" optional="show"/>
        <field name="driver_id" string="Usuario"/>
        <field name="stop_count" string="Entregas" sum="Total"/>
        <field name="cash_expected" sum="Total"/>
        <field name="cash_counted"/>
        <field name="cash_count_done" column_invisible="1"/>
        <field name="cash_difference"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="state" column_invisible="1"/>
        <field name="depot_status" widget="badge" decoration-info="depot_status == 'open'"
               decoration-success="depot_status == 'closed'"/>
      </list>
    </field>
  </record>

  <record id="view_depot_close_form" model="ir.ui.view">
    <field name="name">distri.route.depot.form</field>
    <field name="model">distri.route</field>
    <field name="priority">30</field>
    <field name="arch" type="xml">
      <form string="Cierre de caja depósito" create="0">
        <header>
          <button name="action_close_depot" type="object" class="btn-primary"
                  string="Cerrar caja depósito" invisible="state == 'settled'"
                  groups="distri_pedido.grupo_administracion"
                  confirm="Se cierra la caja del día de este usuario. ¿Seguir?"/>
          <field name="depot_status" widget="statusbar"/>
        </header>
        <sheet>
          <div class="alert alert-danger" role="alert" invisible="not depot_overdue">
            <b>Esta caja es de un día anterior y sigue abierta.</b> Contá el efectivo y cerrala: los
            cobros de hoy ya entran en la caja nueva de este usuario.
          </div>
          <field name="depot_overdue" invisible="1"/>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="driver_id" string="Usuario" readonly="1"/>
              <field name="date" readonly="1"/>
              <field name="journal_id" readonly="1"/>
              <field name="state" invisible="1"/>
              <field name="kind" invisible="1"/>
              <field name="company_id" invisible="1"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group string="Efectivo">
              <field name="cash_expected" help="La suma de los cobros en efectivo registrados en Caja depósito por este usuario en el día: entregas en depósito y cobros en efectivo de la página /cobro."/>
              <field name="cash_counted" readonly="state == 'settled'"/>
              <field name="cash_count_done" invisible="1"/>
              <field name="cash_difference" invisible="not cash_count_done"
                     decoration-danger="cash_difference &lt; 0" decoration-warning="cash_difference &gt; 0"/>
            </group>
          </group>
          <group string="Si hay diferencia" invisible="not cash_count_done or cash_difference == 0">
            <field name="cash_candidates" nolabel="1" colspan="2"/>
            <field name="driver_explanation" string="Explicación" readonly="state == 'settled'"/>
            <button name="action_open_cash_case" type="object" string="Abrir caso por la diferencia"
                    colspan="2" class="btn-secondary"/>
          </group>
          <notebook>
            <page string="Entregas" name="stops">
              <field name="stop_ids" readonly="1">
                <list>
                  <field name="order_id"/>
                  <field name="partner_id"/>
                  <field name="parcels"/>
                  <field name="state" widget="badge" decoration-success="state == 'paid'"
                         decoration-danger="state == 'not_paid'"/>
                  <field name="delivery_state" widget="badge"
                         decoration-warning="delivery_state == 'delivered_no_code'"
                         decoration-success="delivery_state == 'delivered_code'"/>
                  <field name="no_code_reason" optional="show"/>
                  <field name="expected_balance" optional="show"/>
                  <field name="cash_amount" sum="Total"/>
                  <field name="transfer" optional="show"/>
                  <field name="transfer_amount" optional="show"/>
                  <field name="comment" optional="hide"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
            <!-- 19.0.1.92.0: models/cobro_efectivo.py, page /cobro -->
            <page string="Cobros en efectivo" name="cash_collections"
                  invisible="not cash_collection_ids">
              <field name="cash_collection_ids" readonly="1">
                <list>
                  <field name="create_date" string="Hora"/>
                  <field name="partner_id"/>
                  <field name="invoice_id"/>
                  <field name="note" optional="show"/>
                  <field name="payment_id" optional="hide"/>
                  <field name="amount" sum="Total"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
            <page string="Devoluciones" name="returns">
              <div class="text-muted mb-2">La factura del cliente se corrige solo por lo recibido en el
                depósito; «No volvió» abre un caso.</div>
              <field name="return_ids" readonly="1">
                <list decoration-success="settlement_state == 'received'"
                      decoration-danger="settlement_state == 'missing'">
                  <field name="partner_id"/>
                  <field name="order_id"/>
                  <field name="product_id"/>
                  <field name="quantity"/>
                  <field name="reason"/>
                  <field name="amount" sum="Total"/>
                  <field name="settlement_state" widget="badge"/>
                  <field name="credit_note_id" optional="show"/>
                  <field name="currency_id" column_invisible="1"/>
                  <button name="action_received" type="object" string="Recibido en el depósito"
                          icon="fa-check" invisible="settlement_state == 'received' or parent.state == 'settled'"/>
                  <button name="action_missing" type="object" string="No volvió"
                          icon="fa-times" invisible="settlement_state == 'missing' or parent.state == 'settled'"/>
                </list>
              </field>
            </page>
            <page string="Cobros registrados" name="payments">
              <field name="payment_ids"/>
            </page>
            <page string="Comprobantes pendientes" name="promises">
              <field name="promise_ids" readonly="1">
                <list>
                  <field name="partner_id"/>
                  <field name="order_id"/>
                  <field name="amount"/>
                  <field name="state" widget="badge"/>
                  <field name="status_label"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
            <page string="Casos" name="cases">
              <field name="case_ids" readonly="1">
                <list>
                  <field name="kind"/>
                  <field name="amount"/>
                  <field name="state" widget="badge" decoration-danger="state == 'open'"
                         decoration-success="state == 'closed'"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
          </notebook>
          <group invisible="state != 'settled'">
            <field name="settled_at" string="Cerrada el"/>
            <field name="settled_by_id" string="Cerró"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_depot_close" model="ir.actions.act_window">
    <field name="name">Cierre de caja depósito</field>
    <field name="res_model">distri.route</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('kind', '=', 'depot')]</field>
    <field name="context">{'search_default_open': 1, 'default_kind': 'depot'}</field>
    <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_depot_close_list')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_depot_close_form')})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Sin entregas en depósito para cerrar</p>
      <p>Cada usuario que entrega en el depósito («Entrega en depósito» o «Venta en mostrador»)
         tiene una caja por día. Al final del día se carga el efectivo contado; si no coincide con
         lo registrado, la diferencia queda como un caso.</p>
    </field>
  </record>

  <!-- ==================================================== Salida de viajes -->

  <record id="view_departure_kanban" model="ir.ui.view">
    <field name="name">distri.route.departure.kanban</field>
    <field name="model">distri.route</field>
    <field name="arch" type="xml">
      <kanban create="0" highlight_color="load_color" class="o_distri_departure" sample="0">
        <field name="load_missing"/>
        <field name="dispatch_missing"/>
        <field name="left_order_count"/>
        <field name="departure_controlled_by_id"/>
        <field name="currency_id"/>
        <templates>
          <t t-name="card" class="p-3">
            <div class="d-flex justify-content-between align-items-baseline gap-2">
              <field name="driver_id" class="fs-4 fw-bold"/>
              <field name="trip" class="fs-5 text-muted"/>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <span class="fs-5">Pedidos: <field name="stop_count"/></span>
              <field name="state" widget="badge" decoration-info="state == 'on_route'"
                     decoration-warning="state == 'closed'" decoration-success="state == 'settled'"/>
            </div>
            <!-- at the depot: the double check (models/despacho.py); a route
                 that already left keeps the driver's count -->
            <t t-set="at_depot" t-value="record.state.raw_value == 'draft'"/>
            <t t-set="missing" t-value="at_depot ? record.dispatch_missing.raw_value : record.load_missing.raw_value"/>
            <div t-att-class="'rounded p-2 mt-2 ' + (missing ? 'bg-warning-subtle text-warning-emphasis fw-bold' : 'bg-success-subtle text-success-emphasis')">
              <div class="fs-4">Doble control: <field name="checked_stop_count"/> de <field name="stop_count"/> pedidos</div>
              <div class="fs-5"><field name="parcel_checked_count"/> de <field name="parcel_count"/> bultos</div>
              <div class="small">Tildados por el repartidor: <field name="parcel_loaded_count"/> de <field name="parcel_count"/> bultos</div>
            </div>
            <div t-if="record.left_order_count.raw_value" class="mt-2 text-muted">
              Quedan en el depósito: <field name="left_order_count"/>
            </div>
            <field name="orders_summary" class="small text-muted mt-2"/>
            <field name="departure_note" class="mt-2 fst-italic"/>
            <div class="mt-3 d-flex align-items-center gap-2">
              <button t-if="!record.departure_controlled_by_id.raw_value" name="action_mark_controlled"
                      type="object" class="btn btn-primary btn-lg"
                      groups="distri_pedido.grupo_administracion">Controlado</button>
              <span t-else="" class="text-success fw-bold">
                <i class="fa fa-check" title="Controlado"/> Controló <field name="departure_controlled_by_id"/>
                · <field name="departure_controlled_at"/>
              </span>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_departure_list" model="ir.ui.view">
    <field name="name">distri.route.departure.list</field>
    <field name="model">distri.route</field>
    <field name="priority">40</field>
    <field name="arch" type="xml">
      <list string="Salida de viajes" create="0" editable="bottom"
            decoration-warning="(state == 'draft' and dispatch_missing) or (state != 'draft' and load_missing)">
        <field name="date" readonly="1"/>
        <field name="driver_id" readonly="1"/>
        <field name="trip" readonly="1"/>
        <field name="stop_count" string="Pedidos"/>
        <field name="checked_stop_count"/>
        <field name="parcel_count" string="Bultos"/>
        <field name="parcel_checked_count"/>
        <field name="parcel_loaded_count" optional="hide"/>
        <field name="left_order_count" optional="show"/>
        <field name="load_missing" column_invisible="1"/>
        <field name="dispatch_missing" column_invisible="1"/>
        <field name="state" widget="badge" readonly="1" decoration-info="state == 'on_route'"
               decoration-warning="state == 'closed'" decoration-success="state == 'settled'"/>
        <field name="departure_note"/>
        <field name="departure_controlled_by_id"/>
        <field name="departure_controlled_at"/>
        <button name="action_mark_controlled" type="object" string="Controlado" icon="fa-check"
                class="btn-primary" invisible="departure_controlled_by_id"
                groups="distri_pedido.grupo_administracion"/>
      </list>
    </field>
  </record>

  <record id="action_departure" model="ir.actions.act_window">
    <field name="name">Salida de viajes</field>
    <field name="res_model">distri.route</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('kind', '=', 'route')]</field>
    <field name="context">{'search_default_today': 1}</field>
    <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_departure_kanban')}),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_departure_list')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_route_form')})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No hay rutas para hoy</p>
      <p>Los viajes del día con el doble control de la carga: cada pedido lo tilda el repartidor
         en su celular y administración en «Despacho (celular)». En ámbar, los que todavía tienen
         pedidos sin los dos tildes. «Controlado» cierra el despacho: solo con todos los pedidos
         controlados por los dos (o que quedaron en el depósito).</p>
    </field>
  </record>

  <menuitem id="menu_reparto_departure" name="Salida de viajes" parent="menu_reparto_root"
            action="action_departure" sequence="15"/>
  <menuitem id="menu_reparto_depot_close" name="Cierre de caja depósito" parent="menu_reparto_root"
            action="action_depot_close" sequence="25"/>

  <!-- «Caja depósito» (models/deposito.py): created once per company, kept on update -->
  <function model="account.journal" name="_distri_ensure_depot_journal"/>

  <!-- «Devoluciones de clientes» (models/devolucion.py): the DEV-NNNNN return
       type of each warehouse's deliveries -->
  <function model="stock.picking.type" name="_distri_ensure_return_types"/>

</odoo>
