<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 19.0.1.128.0: «Cobrar» in one step (models/cobrar.py, models/cobrar_wizard.py) -->

  <record id="view_cobrar_wizard_form" model="ir.ui.view">
    <field name="name">distri.cobrar.wizard.form</field>
    <field name="model">distri.cobrar.wizard</field>
    <field name="arch" type="xml">
      <form string="Cobrar">
        <field name="currency_id" invisible="1"/>
        <field name="company_id" invisible="1"/>
        <field name="question_field" invisible="1"/>
        <field name="answered" invisible="1"/>
        <div class="alert alert-danger" role="alert" invisible="not error_text">
          <b>No se cobró:</b>
          <field name="error_text" readonly="1" nolabel="1"/>
        </div>
        <div class="alert alert-warning" role="alert" invisible="not question">
          <b>Revisá antes de cobrar:</b>
          <field name="question" readonly="1" nolabel="1"/>
          <div class="d-flex gap-2 align-items-center">
            <field name="confirm" nolabel="1"/>
            <field name="question_button" readonly="1" nolabel="1" class="fw-bold"/>
          </div>
        </div>
        <div class="alert alert-info" role="status" invisible="not caja_hint">
          <field name="caja_hint" readonly="1" nolabel="1"/>
        </div>
        <group>
          <group>
            <field name="partner_id" readonly="1"/>
            <field name="balance" widget="monetary"/>
            <field name="destination" widget="radio"/>
            <field name="invoice_choice_ids" invisible="1"/>
            <field name="history_choice_ids" invisible="1"/>
            <field name="invoice_id" options="{'no_create': True, 'no_open': True}"
                   invisible="destination != 'lab'" required="destination == 'lab'"/>
            <field name="history_id" options="{'no_create': True, 'no_open': True}"
                   context="{'distri_invoice_label': True}"
                   invisible="destination != 'online'" required="destination == 'online'"/>
            <field name="owed" widget="monetary" invisible="destination == 'account'"/>
          </group>
          <group>
            <field name="cash_amount" widget="monetary"/>
            <field name="transfer_total" widget="monetary" invisible="not transfer_total"/>
            <field name="total" widget="monetary" class="fw-bold"/>
            <field name="note" placeholder="Opcional"/>
          </group>
        </group>
        <!-- 19.0.1.129.1: one empty row from the start, a real «+ Agregar
             transferencia» button (static/src/css/cobros_backend.css) and a
             form per transfer with its receipt big (receipt_preview.js) -->
        <label for="line_ids"/>
        <div class="text-muted small">Cada transferencia lleva su comprobante (foto o PDF): toque la
          fila para cargarlo y verlo en grande. Se lee solo y se acredita en el momento; si no se
          lee a tiempo, escriba el importe. Una fila sin archivo ni importe no se cobra.</div>
        <field name="line_ids" nolabel="1" class="o_distri_cobrar_transfers">
          <list>
            <control>
              <create string="+ Agregar transferencia"/>
            </control>
            <field name="currency_id" column_invisible="1"/>
            <field name="receipt_id" column_invisible="1" force_save="1"/>
            <field name="receipt_filename" column_invisible="1"/>
            <field name="receipt_label"/>
            <field name="amount" widget="monetary"/>
            <field name="read_note" force_save="1"/>
          </list>
          <form string="Transferencia">
            <field name="currency_id" invisible="1"/>
            <field name="receipt_id" invisible="1" force_save="1"/>
            <field name="receipt_filename" invisible="1"/>
            <group>
              <group>
                <field name="receipt_file" filename="receipt_filename" widget="binary"
                       required="1"/>
              </group>
              <group>
                <field name="amount" widget="monetary" class="fw-bold"/>
                <field name="read_note" force_save="1"/>
              </group>
            </group>
            <field name="receipt_file" widget="distri_receipt_preview" filename="receipt_filename"
                   nolabel="1"/>
          </form>
        </field>
        <footer>
          <button name="action_collect" type="object" string="Cobrar" class="btn-primary"
                  data-hotkey="q"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- «Cobrar» on the customer invoice; a cashier no longer sees «Pagar» -->
  <record id="view_move_form_cobrar" model="ir.ui.view">
    <field name="name">account.move.form.distri.cobrar</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@id='account_invoice_payment_btn']" position="before">
        <field name="distri_can_cobrar" invisible="1"/>
        <field name="distri_native_pay_allowed" invisible="1"/>
        <button name="action_distri_cobrar" type="object" string="Cobrar" class="oe_highlight"
                invisible="not distri_can_cobrar or state != 'posted' or payment_state not in ('not_paid', 'partial', 'in_payment')"/>
      </xpath>
      <xpath expr="//header/button[@id='account_invoice_payment_btn']" position="attributes">
        <attribute name="invisible" add="not distri_native_pay_allowed" separator=" or "/>
      </xpath>
      <xpath expr="//header/button[@id='account_invoice_payment_secondary_btn']" position="attributes">
        <attribute name="invisible" add="not distri_native_pay_allowed" separator=" or "/>
      </xpath>
    </field>
  </record>

  <!-- the payment opens its receipt card and its one-step collection -->
  <record id="view_account_payment_form_cobro" model="ir.ui.view">
    <field name="name">account.payment.form.distri.cobro</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="distri_cobro_id" invisible="1"/>
        <button name="action_distri_open_receipt" type="object" class="oe_stat_button"
                icon="fa-file-image-o" invisible="not distri_receipt_card_count">
          <field name="distri_receipt_card_count" widget="statinfo" string="Comprobante"/>
        </button>
        <button name="action_distri_open_cobro" type="object" class="oe_stat_button"
                icon="fa-handshake-o" string="Cobro" invisible="not distri_cobro_id"/>
      </xpath>
    </field>
  </record>

  <!-- the receipt card opens the payments of its collection -->
  <record id="view_mp_collection_form_cobro" model="ir.ui.view">
    <field name="name">distri.mp.collection.form.distri.cobro</field>
    <field name="model">distri.mp.collection</field>
    <field name="inherit_id" ref="distri_pedido.view_mp_collection_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_distri_open_payments" type="object" class="oe_stat_button"
                icon="fa-handshake-o" invisible="distri_cobro_payment_count &lt; 2">
          <field name="distri_cobro_payment_count" widget="statinfo" string="Pagos del cobro"/>
        </button>
      </xpath>
    </field>
  </record>

  <record id="view_distri_cobro_form" model="ir.ui.view">
    <field name="name">distri.cobro.form</field>
    <field name="model">distri.cobro</field>
    <field name="arch" type="xml">
      <form string="Cobro en un paso" create="0" edit="0" delete="0">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_payments" type="object" class="oe_stat_button"
                    icon="fa-money" string="Pagos"/>
            <button name="action_open_cards" type="object" class="oe_stat_button"
                    icon="fa-file-image-o" string="Comprobantes" invisible="not card_ids"/>
          </div>
          <div class="oe_title">
            <h1><field name="amount" widget="monetary"/></h1>
            <h3><field name="memo"/></h3>
          </div>
          <field name="currency_id" invisible="1"/>
          <group>
            <group>
              <field name="partner_id"/>
              <field name="destination"/>
              <field name="invoice_id" invisible="not invoice_id"/>
              <field name="history_invoice_id" invisible="not history_invoice_id"/>
              <field name="note" invisible="not note"/>
            </group>
            <group>
              <field name="user_id"/>
              <field name="create_date" string="Cobrado el"/>
              <field name="cash_amount" widget="monetary"/>
              <field name="transfer_amount" widget="monetary"/>
              <field name="caja_id" invisible="not caja_id"/>
              <field name="cash_collection_id" invisible="not cash_collection_id"/>
              <field name="caja_notice" invisible="not caja_notice"/>
            </group>
          </group>
          <field name="payment_ids" readonly="1">
            <list>
              <field name="name"/>
              <field name="date"/>
              <field name="journal_id"/>
              <field name="memo"/>
              <field name="amount"/>
              <field name="state"/>
            </list>
          </field>
          <field name="card_ids" readonly="1" invisible="not card_ids">
            <list>
              <field name="name"/>
              <field name="operation"/>
              <field name="amount"/>
              <field name="audit_state"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_distri_cobro_list" model="ir.ui.view">
    <field name="name">distri.cobro.list</field>
    <field name="model">distri.cobro</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="create_date" string="Cobrado el"/>
        <field name="user_id"/>
        <field name="partner_id"/>
        <field name="memo"/>
        <field name="cash_amount" sum="Efectivo"/>
        <field name="transfer_amount" sum="Transferencias"/>
        <field name="amount" sum="Total"/>
      </list>
    </field>
  </record>

  <record id="action_distri_cobro" model="ir.actions.act_window">
    <field name="name">Cobros en un paso</field>
    <field name="res_model">distri.cobro</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_cobros_cobro" name="Cobros en un paso" parent="menu_cobros_root"
            action="action_distri_cobro" sequence="25"
            groups="distri_pedido.grupo_administracion,base.group_system"/>
</odoo>
