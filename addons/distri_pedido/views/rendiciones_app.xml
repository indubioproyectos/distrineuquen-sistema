<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- «Rendiciones y casos» on the phone (19.0.1.127.1, controllers/rendiciones.py):
       the landing of the home tile, on the kit with /deposito's look
       (static/src/deposito/deposito.css, dp-* classes, deposito_top). The
       backend screens stay for the PC; this page only leads to them. -->

  <template id="rendiciones_page" name="Rendiciones y casos">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Rendiciones y casos · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="dp" data-parent="/tablero" data-page="rendiciones">
  <t t-call="distri_pedido.deposito_top">
    <t t-set="volver" t-value="'/tablero'"/>
    <t t-set="kicker" t-value="'Distri Neuquén · %s' % user.name"/>
    <t t-set="titulo" t-value="'Rendiciones y casos'"/>
    <t t-set="sub" t-value="'Rendir las rutas y seguir los casos, cargos y comprobantes.'"/>
  </t>
  <main class="dn-main">
    <a t-foreach="rows" t-as="r" class="dp-act" t-att-href="r['url']"
       t-att-data-dn="r['how'] or None" t-att-data-rd="r['key']">
      <span class="dp-ico"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="r['icon']"/></t></span>
      <span class="dp-act__txt"><b t-esc="r['title']"/><span t-esc="r['subtitle']"/></span>
      <span t-if="r['badge']" class="dn-chip dn-num" t-esc="r['badge']"/>
    </a>
    <div t-if="ajustes" class="dp-note">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'pin'"/></t>
      <span>Zonas, gastos, transportistas y tiempos de reparto, en la PC.</span>
      <a t-att-href="ajustes" data-rd="ajustes">Ajustes de reparto (PC)</a>
    </div>
  </main>
</body>
</html>
  </template>

  <template id="rendiciones_rutas" name="Rendiciones y casos: rutas para rendir">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Rutas para rendir · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="dp" data-parent="/rendiciones" data-page="rendiciones-rutas">
  <t t-call="distri_pedido.deposito_top">
    <t t-set="volver" t-value="'/rendiciones'"/>
    <t t-set="kicker" t-value="'Rendiciones y casos'"/>
    <t t-set="titulo" t-value="'Rutas para rendir'"/>
    <t t-set="sub" t-value="'Cerradas por el repartidor en el celular, todavía sin rendir.'"/>
  </t>
  <main class="dn-main">
    <h2 class="dn-label">Para rendir · <t t-esc="len(routes)"/></h2>
    <t t-foreach="routes" t-as="route">
      <a class="dp-row" t-att-href="route_url % route.id" data-rd="ruta">
        <span class="dp-row__txt"><b t-esc="route.name"/>
          <span class="dp-meta"><t t-esc="route.driver_id.name"/> · <t t-esc="dia(route.date)"/></span></span>
        <span class="dp-amt dn-num" t-esc="money(route.cash_expected)"/>
      </a>
      <!-- 19.0.1.129.25 (#105): back to the driver's phone, no reason asked -->
      <form method="post" t-att-action="'/rendiciones/rutas/%s/reabrir' % route.id" class="rd-reabrir">
        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
        <button type="submit" class="dn-btn dn-btn--ghost">Reabrir para el repartidor</button>
      </form>
    </t>
    <div t-if="not routes" class="dn-empty">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'check'"/></t>
      <p>No hay rutas esperando la rendición.</p>
    </div>
  </main>
</body>
</html>
  </template>
</odoo>
