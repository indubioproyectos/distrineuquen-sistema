<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Distrineuquén kit (19.0.1.94.0): the <head> and the bottom nav of the
       standalone staff pages. Values come from controllers/kit.py:
       dn = kit_context(<page files>), nav = staff_nav(env, <current>). -->

  <!-- Inside <head>, after the page's <title>. Optional values:
       manifest (URL of a web app manifest), icon (favicon URL). -->
  <template id="dn_head" name="Kit: head">
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
    <meta name="theme-color" content="#10243f"/>
    <meta t-if="request" name="csrf-token" t-att-content="request.csrf_token()"/>
    <link t-if="dn['font']" rel="preload" as="font" type="font/woff2" crossorigin="anonymous" t-att-href="dn['font']"/>
    <link rel="stylesheet" t-att-href="dn['css']"/>
    <t t-foreach="dn['page_css']" t-as="href"><link rel="stylesheet" t-att-href="href"/></t>
    <link t-if="manifest" rel="manifest" t-att-href="manifest"/>
    <link rel="icon" type="image/png" t-att-href="icon or '/distri_pedido/static/src/img/marca/favicon-32.png?v=129.12'"/>
    <link rel="apple-touch-icon" href="/distri_pedido/static/src/img/marca/dn-icono-180.png?v=129.12"/>
    <script defer="defer" t-att-src="dn['js']"/>
    <t t-foreach="dn['page_js']" t-as="src"><script defer="defer" t-att-src="src"/></t>
  </template>

  <!-- Role-based bottom nav (controllers/kit.py staff_nav, depot_nav). Put it
       inside <div class="dn-bottom">, after the page's .dn-foot if it has
       one. 19.0.1.109.0: an item may carry a count badge (it['badge']). -->
  <template id="dn_nav" name="Kit: bottom nav">
    <nav class="dn-nav" aria-label="Secciones" t-if="nav">
      <t t-foreach="nav" t-as="it">
        <a t-att-href="it['url']" t-att-data-dn="it['how']" t-att-class="'on' if it['on'] else None"
           t-att-aria-current="'page' if it['on'] else None">
          <span class="dn-nav__ic"><svg class="dn-i" aria-hidden="true"><use t-att-href="'%s#%s' % (dn['icons'], it['icon'])"/></svg><i t-if="it.get('badge')" class="dn-nav__bd dn-num" t-esc="it['badge']"/></span>
          <span t-esc="it['label']"/>
        </a>
      </t>
    </nav>
  </template>

  <!-- 19.0.1.95.0: the legacy pages (css/distri_ui.css and the customer
       pages) save without stacking history: static/src/js/sin_historial.js,
       see models/ir_http.py. Inside <head> of every such page. -->
  <template id="sin_historial" name="Legacy pages: navigation without extra history">
    <script defer="defer" t-att-src="request.env['ir.http'].distri_nav_script() if request else '/dn/sin_historial.js'"/>
  </template>

  <!-- 19.0.1.98.0: the «Ajustes» gear of EVERY custom page (kit and legacy,
       staff and customers). One self-contained macro: the gear button where
       it is called (inside the top bar), the sheet, and its own small
       static/src/kit/ajustes.css + ajustes.js (served by /dn/, they need
       neither dn.css nor dn.js). Values: gear_float = fixed top-right
       button (single-page apps whose header is drawn by JavaScript),
       gear_volver = where the armado preferences go back to.
       Without JavaScript the sheet opens as a #dn-aj anchor target.
       The letter size is a per-device zoom (localStorage «dn:letra»),
       applied here before the page paints. -->
  <template id="dn_ajustes" name="Ajustes: botón y hoja">
    <t t-set="aj" t-value="request.env.user._distri_ajustes() if request else {'publico': True}"/>
    <t t-set="aj_urls" t-value="request.env['ir.http'].distri_ajustes_urls() if request else {}"/>
    <script>try{var z=localStorage.getItem('dn:letra');if(z&amp;&amp;z.length&lt;5&amp;&amp;+z&gt;0.5&amp;&amp;+z&lt;2){document.documentElement.style.setProperty('--dn-scale',z)}}catch(e){}</script>
    <link rel="stylesheet" t-att-href="aj_urls.get('css')"/>
    <!-- 19.0.1.120.0: the way back to Inicio (/tablero) on every staff
         screen, for whoever has it as home (res.users._distri_has_inicio):
         a button next to the floating gear, and the first link of the sheet -->
    <t t-set="aj_inicio" t-value="aj.get('inicio') if request and request.httprequest.path.rstrip('/') != '/tablero' else ''"/>
    <a t-if="aj_inicio and gear_float" t-att-href="aj_inicio" id="dn-home" class="dn-home dn-home--float"
       aria-label="Inicio" title="Inicio">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>
      <span>Inicio</span>
    </a>
    <a href="#dn-aj" id="dn-gear" t-att-class="('dn-gear dn-gear--float' if gear_float else 'dn-gear') + (' dn-gear--mini' if gear_mini else '')"
       aria-label="Ajustes" title="Ajustes" aria-controls="dn-aj" aria-haspopup="dialog">
      <!-- 19.0.1.129.15: /pedido shows a small wrench, like AgilPedido -->
      <svg t-if="gear_mini" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      <svg t-else="" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
    </a>
    <div id="dn-aj" class="dn-aj" role="dialog" aria-modal="true" aria-labelledby="dn-aj-t"
         t-att-data-manifest="aj_urls.get('manifest')" t-att-data-publico="'1' if aj['publico'] else None">
      <div class="dn-aj__in">
        <div class="dn-aj__head">
          <h2 id="dn-aj-t">Ajustes</h2>
          <a href="#" class="dn-aj__x" data-aj-close="" aria-label="Cerrar">×</a>
        </div>
        <p t-if="not aj['publico']" class="dn-aj__quien"><b t-esc="aj['nombre']"/><span t-esc="aj['rol']"/></p>
        <section class="dn-aj__sec">
          <h3>Tamaño de letra</h3>
          <div class="dn-aj__seg" role="group" aria-label="Tamaño de letra">
            <button type="button" data-letra="0.9" aria-label="Letra más chica">A−</button>
            <button type="button" data-letra="1" aria-label="Letra normal" aria-pressed="true">A</button>
            <button type="button" data-letra="1.15" aria-label="Letra más grande">A+</button>
            <button type="button" data-letra="1.3" aria-label="Letra muy grande">A++</button>
          </div>
        </section>
        <section t-if="aj.get('armador')" class="dn-aj__sec">
          <h3>Armado</h3>
          <form method="post" action="/armado/preferencias" class="dn-aj__seg" data-aj-pref="">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="volver" t-att-value="gear_volver or (request.httprequest.path if request else '/armado')"/>
            <button type="submit" name="vista" value="tradicional" t-att-aria-pressed="'true' if aj['vista'] == 'tradicional' else 'false'">Tradicional</button>
            <button type="submit" name="vista" value="tarjetas" t-att-aria-pressed="'true' if aj['vista'] == 'tarjetas' else 'false'">Tarjetas</button>
          </form>
          <form method="post" action="/armado/preferencias" class="dn-aj__seg" data-aj-pref="">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="volver" t-att-value="gear_volver or (request.httprequest.path if request else '/armado')"/>
            <button type="submit" name="orden" value="alfabetico" t-att-aria-pressed="'true' if aj['orden'] == 'alfabetico' else 'false'">Alfabético</button>
            <button type="submit" name="orden" value="secciones" t-att-aria-pressed="'true' if aj['orden'] == 'secciones' else 'false'">Por secciones</button>
          </form>
        </section>
        <section class="dn-aj__sec dn-aj__inst" hidden="hidden">
          <button type="button" class="dn-aj__btn" data-aj-instalar="">Instalar la app</button>
          <p class="dn-aj__ios" hidden="hidden">En el iPhone, desde Safari: tocá <b>Compartir</b>
            y después <b>Agregar a inicio</b>.</p>
        </section>
        <nav t-if="not aj['publico']" class="dn-aj__links">
          <a t-if="aj_inicio" t-att-href="aj_inicio" class="dn-aj__inicio">Inicio: todas tus pantallas</a>
          <a t-if="aj.get('capacitacion')" href="/proyecto">Capacitación</a>
          <a t-if="aj.get('perfil')" href="/mi-perfil">Mi perfil</a>
          <a t-if="aj.get('cuenta')" href="/mi-cuenta">Mi cuenta corriente</a>
          <a t-if="aj.get('clave')" href="/mi-clave">Cambiar clave</a>
        </nav>
        <a t-if="not aj['publico']" class="dn-aj__btn dn-aj__salir" href="/web/session/logout">Salir</a>
      </div>
    </div>
    <script defer="defer" t-att-src="aj_urls.get('js')"/>
  </template>

  <!-- One icon of the sprite: t-call with i = the symbol id. -->
  <template id="dn_icon" name="Kit: icon">
    <svg class="dn-i" aria-hidden="true"><use t-att-href="'%s#%s' % (dn['icons'], i)"/></svg>
  </template>
</odoo>
