<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 19.0.1.129.30: «Nueva venta» (controllers/nueva_venta.py, models/
       nueva_venta.py, static/src/nueva_venta/). One screen: the customer,
       the cart priced with his list, and how the sale goes on. -->

  <template id="nueva_venta_top" name="Nueva venta: barra">
    <!-- 19.0.1.129.47 (ui_v2): the design system's ScreenHeader of a task
         screen: back arrow, kicker, title, gear; under it the short help
         and, on the sale itself (avance), the progress of its 3 steps
         (nueva_venta.css, from the steps shown) -->
    <header t-if="v2" class="dn-top nv-top nv-top--v2">
      <div class="dn-top__row">
        <a class="dn-icon-btn" t-att-href="volver" data-dn-back="" aria-label="Volver">
          <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'back'"/></t></a>
        <div class="dn-top__txt">
          <span class="dn-top__kicker" t-esc="kicker or 'Distri Neuquén · %s' % user.name"/>
          <h1 class="dn-top__title" t-esc="titulo"/>
        </div>
        <t t-call="distri_pedido.dn_ajustes"/>
      </div>
      <div t-if="sub or avance" class="dn-top__extra">
        <p t-if="sub" class="dn-top__sub nv-top__sub" t-esc="sub"/>
        <div t-if="avance" class="dn-progress nv-avance" role="img" aria-label="Avance de la venta"><i></i></div>
      </div>
    </header>
    <header t-else="" class="dn-top nv-top">
      <div class="dn-top__row nv-top__row">
        <a class="dn-back" t-att-href="volver" data-dn-back="">‹ Volver</a>
        <t t-call="distri_pedido.dn_ajustes"/>
      </div>
      <div class="nv-top__txt">
        <span class="dn-top__kicker">Distri Neuquén · <t t-esc="user.name"/></span>
        <h1 class="nv-title" t-esc="titulo"/>
        <p t-if="sub" class="nv-sub" t-esc="sub"/>
      </div>
    </header>
  </template>

  <template id="nueva_venta_page" name="Nueva venta">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Nueva venta · Distri Neuquén</title>
  <!-- 19.0.1.129.53 (ui_v2): a PC (>= 1024 px, fine pointer) opens the
       «planilla» layout unless this device chose the phone one («Ver
       versión celular», ?celular=1, remembered in localStorage); the
       choice «Ver versión planilla» is remembered by planilla.js. Before
       any CSS, so the phone layout never flashes. -->
  <script t-if="v2" id="nv-vista">(function(){try{var K='dn:nv:vista',q=location.search;if(q.indexOf('celular=1')!==-1){localStorage.setItem(K,'celular');return}if(q.indexOf('volver=')!==-1){return}var p=localStorage.getItem(K);if(p==='planilla'||(!p&amp;&amp;window.matchMedia&amp;&amp;matchMedia('(min-width: 1024px) and (pointer: fine)').matches)){location.replace('/nueva-venta/planilla')}}catch(e){}})();</script>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body t-att-class="'nv nv--v2 dn-has-nav' if v2 else 'nv dn-has-nav'" t-att-data-parent="inicio" data-page="nueva-venta" t-att-data-uid="uid"
      t-att-data-wa-requerido="'1' if wa_requerido else '0'">
  <t t-call="distri_pedido.nueva_venta_top">
    <t t-set="volver" t-value="inicio"/>
    <t t-set="titulo" t-value="'Nueva venta'"/>
    <t t-set="sub" t-value="'Elegí el cliente, cargá los productos y decí cómo sigue.'"/>
    <t t-set="avance" t-value="True"/>
  </t>
  <div class="dn-banner dn-banner--err" role="alert" id="nv-error" t-att-hidden="None if error else 'hidden'"><span t-esc="error"/></div>
  <!-- 19.0.1.129.35 (#59): the draft kept on the phone (nueva_venta.js) -->
  <div class="dn-banner dn-banner--warn nv-borrador" role="status" id="nv-borrador" hidden="hidden">
    <span id="nv-borrador-txt"></span>
    <span class="nv-borrador__btns">
      <button type="button" class="dn-btn dn-btn--sm dn-btn--auto" id="nv-borrador-seguir">Seguir</button>
      <button type="button" class="dn-btn dn-btn--ghost dn-btn--sm dn-btn--auto" id="nv-borrador-descartar">Descartar</button>
    </span>
  </div>

  <form id="nv-form" class="dn-main nv-main" method="post" action="/nueva-venta/crear" data-nv-form="">
    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
    <input type="hidden" name="envio" t-att-value="envio"/>
    <input type="hidden" name="cliente_id" id="nv-cliente-id" value=""/>
    <input type="hidden" name="renglones" id="nv-renglones" value="[]"/>

    <section class="dn-card nv-step" aria-labelledby="nv-t1">
      <h2 class="nv-step__t" id="nv-t1"><span class="nv-n">1</span> Cliente</h2>
      <div class="nv-elegido" id="nv-elegido" hidden="hidden">
        <span class="nv-elegido__txt"><b id="nv-cliente-nombre"></b><span class="nv-meta" id="nv-cliente-meta"></span></span>
        <button type="button" class="dn-btn dn-btn--ghost dn-btn--sm dn-btn--auto" id="nv-cambiar">Cambiar</button>
      </div>
      <!-- 19.0.1.129.40: picking him is enough; his data are one tap away -->
      <div class="nv-cliente-acc" id="nv-cliente-acc" hidden="hidden">
        <button type="button" class="dn-btn dn-btn--outline dn-btn--sm dn-btn--auto" id="nv-datos-abrir">Datos del cliente</button>
        <a class="dn-btn dn-btn--ghost dn-btn--sm dn-btn--auto" id="nv-ficha" href="#" hidden="hidden" data-dn="down">Ver ficha</a>
      </div>
      <!-- 19.0.1.129.35: what the customer step adds once he is picked -->
      <div class="nv-cliente-extra" id="nv-cliente-extra" hidden="hidden">
        <a class="dn-link nv-cuenta" id="nv-cuenta" href="#" hidden="hidden">Ver su estado de cuenta</a>
        <div class="nv-anteriores" id="nv-anteriores-box" hidden="hidden">
          <h3 class="nv-sub-t">Repetir un pedido anterior</h3>
          <div id="nv-anteriores" class="nv-list"></div>
        </div>
        <details class="nv-mas" id="nv-mas">
        <summary>Quién pide y ubicación <small class="nv-meta">(opcional)</small></summary>
        <div class="dn-field">
          <label for="nv-contacto">Nombre y apellido de quien pide <small class="nv-meta">(opcional)</small></label>
          <input id="nv-contacto" name="contacto" class="dn-input" type="text" maxlength="120" autocomplete="off"
                 enterkeyhint="done"/>
        </div>
        <div class="nv-gps">
          <button type="button" class="dn-btn dn-btn--outline dn-btn--sm" id="nv-gps">
            <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'pin'"/></t>Registrar la ubicación (GPS)</button>
          <small class="nv-meta" id="nv-gps-txt">Opcional: tocalo estando en el comercio.</small>
          <input type="hidden" name="lat" id="nv-lat" value=""/>
          <input type="hidden" name="lng" id="nv-lng" value=""/>
          <input type="hidden" name="precision" id="nv-precision" value=""/>
        </div>
        </details>
      </div>
      <div id="nv-buscar-cliente">
        <label for="nv-q-cliente" class="dn-sr">Buscar cliente</label>
        <div class="nv-search">
        <t t-if="v2" t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'search'"/></t>
        <input id="nv-q-cliente" class="dn-input" type="search" maxlength="60" autocomplete="off"
               placeholder="Buscar cliente por nombre, CUIT o WhatsApp" enterkeyhint="search"/>
        </div>
        <div id="nv-clientes" class="nv-list" aria-live="polite"></div>
        <button t-if="v2" type="button" class="dn-btn dn-btn--secondary nv-nuevo-abrir" id="nv-nuevo-abrir">
          <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'plus'"/></t>Nuevo cliente</button>
        <button t-else="" type="button" class="dn-btn dn-btn--outline dn-btn--sm nv-nuevo-abrir" id="nv-nuevo-abrir">+ Nuevo cliente</button>
      </div>
    </section>

    <section class="dn-card nv-step" aria-labelledby="nv-t2" id="nv-paso-carrito" hidden="hidden">
      <h2 class="nv-step__t" id="nv-t2"><span class="nv-n">2</span> Productos
        <small class="nv-meta" id="nv-lista"></small></h2>
      <!-- 19.0.1.129.40: /pedido's catalog on the whole screen, the main way on a phone -->
      <a t-if="v2" class="dn-btn dn-btn--secondary dn-btn--lg nv-elegir" id="nv-elegir" href="/nueva-venta/productos">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'list'"/></t>Elegir productos</a>
      <a t-else="" class="dn-btn dn-btn--lg nv-elegir" id="nv-elegir" href="/nueva-venta/productos">Elegir productos</a>
      <div class="nv-tools">
        <label for="nv-q-prod" class="dn-sr">Buscar producto</label>
        <input id="nv-q-prod" class="dn-input" type="search" maxlength="60" autocomplete="off"
               placeholder="O buscá uno acá" enterkeyhint="search"/>
        <button t-if="pegar" type="button" class="dn-btn dn-btn--outline dn-btn--sm dn-btn--auto" id="nv-pegar-abrir">
          Pegar mensaje de AgilPedido</button>
      </div>
      <p class="nv-meta" id="nv-carrito-vacio">Todavía no hay productos en la venta.</p>
      <div id="nv-carrito" class="nv-list nv-list--carrito"></div>
      <div id="nv-productos" class="nv-list" aria-live="polite"></div>
      <p class="nv-total">Total <b class="dn-num" id="nv-total">$ 0</b>
        <small class="nv-meta" id="nv-conteo"></small></p>
    </section>

    <section class="dn-card nv-step" aria-labelledby="nv-t3" id="nv-paso-salida" hidden="hidden">
      <h2 class="nv-step__t" id="nv-t3"><span class="nv-n">3</span> ¿Cómo sigue?</h2>
      <div class="nv-salidas" role="radiogroup" aria-labelledby="nv-t3">
        <label t-foreach="salidas" t-as="s" class="nv-salida">
          <input type="radio" name="salida" t-att-value="s[0]"/>
          <span class="nv-salida__txt"><b t-esc="s[1]"/><small t-esc="s[2]"/></span>
        </label>
      </div>
      <!-- 19.0.1.129.35 «¿Cuál es el WhatsApp?», since 19.0.1.129.40 only at
           the exits that confirm: required with pedido_requiere_whatsapp on,
           optional otherwise -->
      <div class="nv-wa" id="nv-wa" hidden="hidden">
        <p class="nv-wa__t"><b t-if="wa_requerido">El cliente no tiene WhatsApp y hace falta para confirmar. ¿Cuál es?</b>
          <b t-else="">El cliente no tiene WhatsApp. Si lo sabés, ponelo <small class="nv-meta">(opcional)</small></b>
          <small class="nv-meta">Queda guardado en el cliente.</small></p>
        <div class="nv-wa__campos">
          <div class="dn-field"><label for="nv-wa-area">Código de área</label>
            <input id="nv-wa-area" name="wa_area" class="dn-input dn-num" inputmode="numeric" maxlength="5"
                   placeholder="299" autocomplete="off" enterkeyhint="next"/></div>
          <div class="dn-field"><label for="nv-wa-numero">Número</label>
            <input id="nv-wa-numero" name="wa_numero" class="dn-input dn-num" inputmode="numeric" maxlength="12"
                   placeholder="4222444" autocomplete="off" enterkeyhint="done"/></div>
        </div>
        <p class="nv-meta">Sin el 0 del código de área ni el 15 del número.</p>
      </div>
      <div class="nv-extra" data-nv-para="armar presupuesto" hidden="hidden">
        <div class="dn-field">
          <label for="nv-entrega">Entrega</label>
          <select id="nv-entrega" name="entrega" class="dn-input">
            <option value="domicilio">Envío a domicilio</option>
            <option value="retira">Lo retira en el depósito</option>
          </select>
        </div>
        <!-- 19.0.1.129.40: they come from his record; change them only if needed -->
        <details class="nv-mas" id="nv-entrega-datos">
          <summary>Datos de entrega y notas <small class="nv-meta" id="nv-entrega-resumen">(de su ficha)</small></summary>
          <div class="dn-field">
            <label for="nv-telefono">Teléfono de contacto <small class="nv-meta">(opcional)</small></label>
            <input id="nv-telefono" name="telefono" class="dn-input" type="tel" maxlength="40" autocomplete="off"
                   enterkeyhint="next"/>
          </div>
          <div class="dn-field">
            <label for="nv-domicilio">Domicilio de entrega <small class="nv-meta">(opcional)</small></label>
            <input id="nv-domicilio" name="domicilio" class="dn-input" type="text" maxlength="200" autocomplete="off"
                   enterkeyhint="next"/>
          </div>
          <div class="dn-field">
            <label for="nv-comentario">Comentario del pedido</label>
            <input id="nv-comentario" name="comentario" class="dn-input" type="text" maxlength="500" autocomplete="off"
                   enterkeyhint="next"/>
          </div>
          <div class="dn-field">
            <label for="nv-nota">Nota para el depósito</label>
            <input id="nv-nota" name="nota_deposito" class="dn-input" type="text" maxlength="500" autocomplete="off"
                   enterkeyhint="done"/>
          </div>
        </details>
        <!-- 19.0.1.129.35: /pedido's «Soy del interior» (parcel to a terminal) -->
        <label class="nv-check"><input type="checkbox" name="encomienda" value="1" id="nv-encomienda"/>
          Va por encomienda a la terminal</label>
        <div class="nv-enc" id="nv-enc" hidden="hidden">
          <div class="dn-field">
            <label for="nv-enc-nombre">Nombre y apellido de quien retira</label>
            <input id="nv-enc-nombre" name="enc_nombre" class="dn-input" type="text" maxlength="120" autocomplete="off"/>
          </div>
          <div class="dn-field">
            <label for="nv-enc-dni">DNI de quien retira</label>
            <input id="nv-enc-dni" name="enc_dni" class="dn-input dn-num" inputmode="numeric" maxlength="12" autocomplete="off"/>
          </div>
          <div class="dn-field">
            <label for="nv-enc-localidad">Localidad de la terminal</label>
            <input id="nv-enc-localidad" name="enc_localidad" class="dn-input" type="text" maxlength="80"
                   list="nv-localidades" autocomplete="off"/>
            <datalist id="nv-localidades"><option t-foreach="localidades" t-as="l" t-att-value="l"/></datalist>
          </div>
        </div>
      </div>
      <div class="nv-extra" data-nv-para="entregado" hidden="hidden">
        <div class="dn-field">
          <label for="nv-fecha">Día en que se entregó</label>
          <input id="nv-fecha" name="fecha" class="dn-input" type="date"/>
        </div>
        <div class="dn-field">
          <label for="nv-motivo">Motivo</label>
          <input id="nv-motivo" name="motivo" class="dn-input" type="text" maxlength="250"
                 t-att-value="motivo" autocomplete="off"/>
        </div>
        <p class="nv-meta">Se arma, se factura y queda entregada ese día: no entra a ninguna ruta ni a las
          entregas del depósito, y no registra cobro.</p>
      </div>
      <div class="nv-extra" data-nv-para="mostrador" hidden="hidden">
        <p class="nv-meta">Se confirma, se arma completo tal como se cargó y sale la factura. Después se
          registra la entrega y el cobro.</p>
      </div>
      <button type="submit" class="dn-btn dn-btn--lg nv-ok" id="nv-ok" disabled="disabled">Cargar la venta</button>
    </section>
    <!-- 19.0.1.129.53: on a wide screen only (nueva_venta.css) -->
    <a t-if="v2" class="dn-link nv-a-planilla" href="/nueva-venta/planilla?vista=planilla">Ver versión planilla (PC)</a>
  </form>

  <div t-if="pegar" class="dn-sheet nv-pegar" id="nv-pegar" role="dialog" aria-labelledby="nv-pegar-t">
    <h2 id="nv-pegar-t">Pegar mensaje de AgilPedido</h2>
    <label for="nv-mensaje" class="dn-sr">Mensaje de WhatsApp</label>
    <textarea id="nv-mensaje" class="dn-input nv-mensaje" rows="8" maxlength="20000"
              placeholder="Pegá el mensaje tal como llegó, sin editarlo."></textarea>
    <p class="nv-meta" id="nv-pegar-aviso"></p>
    <div class="dn-grid2 nv-grid2">
      <button type="button" class="dn-btn dn-btn--ghost" data-dn-close="">Cancelar</button>
      <button type="button" class="dn-btn" id="nv-pegar-leer">Leer el mensaje</button>
    </div>
  </div>
  <!-- 19.0.1.129.40: «Datos del cliente» and «Nuevo cliente», on this page
       (the draft stays as it is) -->
  <div class="dn-sheet nv-hoja" id="nv-datos" role="dialog" aria-labelledby="nv-datos-t">
    <h2 id="nv-datos-t">Datos del cliente</h2>
    <p class="nv-meta" id="nv-datos-nombre"></p>
    <div class="nv-wa__campos">
      <div class="dn-field"><label for="nv-d-area">WhatsApp: código de área</label>
        <input id="nv-d-area" class="dn-input dn-num" inputmode="numeric" maxlength="5" placeholder="299"
               autocomplete="off" enterkeyhint="next"/></div>
      <div class="dn-field"><label for="nv-d-numero">Número</label>
        <input id="nv-d-numero" class="dn-input dn-num" inputmode="numeric" maxlength="12" placeholder="4222444"
               autocomplete="off" enterkeyhint="next"/></div>
    </div>
    <p class="nv-meta" id="nv-d-wa-actual"></p>
    <div class="dn-field"><label for="nv-d-calle">Domicilio</label>
      <input id="nv-d-calle" class="dn-input" type="text" maxlength="120" autocomplete="off" enterkeyhint="next"/></div>
    <div class="dn-field"><label for="nv-d-ciudad">Localidad</label>
      <input id="nv-d-ciudad" class="dn-input" type="text" maxlength="60" autocomplete="off" enterkeyhint="done"/></div>
    <p class="nv-meta nv-aviso" id="nv-datos-aviso"></p>
    <div class="dn-grid2 nv-grid2">
      <button type="button" class="dn-btn dn-btn--ghost" data-dn-close="">Cancelar</button>
      <button type="button" class="dn-btn" id="nv-datos-guardar">Guardar</button>
    </div>
  </div>
  <div class="dn-sheet nv-hoja" id="nv-nuevo" role="dialog" aria-labelledby="nv-nuevo-t">
    <h2 id="nv-nuevo-t">Nuevo cliente</h2>
    <div class="dn-field"><label for="nv-n-nombre">Nombre del comercio o de la persona</label>
      <input id="nv-n-nombre" class="dn-input" type="text" maxlength="120" autocomplete="off" enterkeyhint="next"/></div>
    <div class="nv-wa__campos">
      <div class="dn-field"><label for="nv-n-area">WhatsApp: código de área <small class="nv-meta">(opcional)</small></label>
        <input id="nv-n-area" class="dn-input dn-num" inputmode="numeric" maxlength="5" placeholder="299"
               autocomplete="off" enterkeyhint="next"/></div>
      <div class="dn-field"><label for="nv-n-numero">Número</label>
        <input id="nv-n-numero" class="dn-input dn-num" inputmode="numeric" maxlength="12" placeholder="4222444"
               autocomplete="off" enterkeyhint="next"/></div>
    </div>
    <div class="dn-field"><label for="nv-n-calle">Domicilio <small class="nv-meta">(opcional)</small></label>
      <input id="nv-n-calle" class="dn-input" type="text" maxlength="120" autocomplete="off" enterkeyhint="next"/></div>
    <div class="dn-field"><label for="nv-n-ciudad">Localidad <small class="nv-meta">(opcional)</small></label>
      <input id="nv-n-ciudad" class="dn-input" type="text" maxlength="60" autocomplete="off" enterkeyhint="done"/></div>
    <div class="nv-list" id="nv-parecidos" hidden="hidden"></div>
    <p class="nv-meta nv-aviso" id="nv-nuevo-aviso"></p>
    <div class="dn-grid2 nv-grid2">
      <button type="button" class="dn-btn dn-btn--ghost" data-dn-close="">Cancelar</button>
      <button type="button" class="dn-btn" id="nv-nuevo-crear">Crear y elegir</button>
    </div>
  </div>
  <div class="dn-bottom"><t t-call="distri_pedido.dn_nav"/></div>
</body>
</html>
  </template>

  <template id="nueva_venta_hecho" name="Nueva venta: hecho">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Nueva venta · Distri Neuquén</title>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body t-att-class="'nv nv--v2 dn-has-nav' if v2 else 'nv dn-has-nav'" data-parent="/nueva-venta" data-page="nueva-venta-hecho">
  <t t-call="distri_pedido.nueva_venta_top">
    <t t-set="volver" t-value="'/nueva-venta'"/>
    <t t-set="titulo" t-value="titulo"/>
    <t t-set="sub" t-value="texto"/>
  </t>
  <main class="dn-main nv-main">
    <section class="dn-card nv-hecho">
      <p class="nv-hecho__name"><b t-esc="order.name"/> · <span t-esc="order.partner_id.name"/></p>
      <p class="nv-total">Total <b class="dn-num" t-esc="total"/></p>
      <p t-if="factura" class="nv-meta">Factura: <t t-esc="factura"/></p>
      <a t-if="enviar" class="dn-btn dn-btn--outline" t-att-href="enviar" target="_blank" rel="noopener">
        Enviar al cliente por WhatsApp</a>
    </section>
    <!-- 19.0.1.129.42 (ui_v2): a counter sale's next steps, where pending -->
    <t t-if="pasos">
      <a t-if="pasos.get('entregar')" class="dn-btn dn-btn--lg" t-att-href="pasos['entregar']"
         data-dn="down" data-nv-paso="entregar">Entregar</a>
      <a t-if="pasos.get('cobrar')" t-att-class="'dn-btn dn-btn--lg' + (' dn-btn--outline' if pasos.get('entregar') else '')"
         t-att-href="pasos['cobrar']" data-nv-paso="cobrar">Cobrar ahora · <t t-esc="pasos['debe']"/></a>
      <a class="dn-btn dn-btn--lg dn-btn--ghost" href="/nueva-venta" data-nv-paso="nueva">Nueva venta</a>
    </t>
    <a t-else="" class="dn-btn dn-btn--lg" href="/nueva-venta">Cargar otra venta</a>
    <a class="dn-link nv-link" t-att-href="mis_ventas">Ver en Mis ventas</a>
  </main>
  <div class="dn-bottom"><t t-call="distri_pedido.dn_nav"/></div>
</body>
</html>
  </template>
</odoo>
