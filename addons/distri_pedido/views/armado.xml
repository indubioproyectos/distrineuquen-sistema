<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================ pantalla del armador -->

  <!-- 19.0.1.94.0: on the Distrineuquén kit (views/kit.xml, static/src/kit)
       with this screen's own static/src/armado/armado.css and armado.js,
       served versioned and cached (controllers/kit.py). Navigation goes up
       one level: item -> order -> list -> staff home (dn.js). Every action
       has a plain form fallback that works without JavaScript. -->

  <!-- Top bar: back to the parent, mint kicker, title. -->
  <template id="armado_top" name="Armado: barra">
    <header class="dn-top">
      <div class="dn-top__row">
        <a t-if="volver" class="dn-icon-btn" t-att-href="volver" data-dn-back="" t-att-aria-label="volver_txt or 'Volver'">
          <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'back'"/></t>
        </a>
        <div class="dn-top__txt" t-att-style="None if volver else 'padding-left:12px'">
          <span class="dn-top__kicker" t-if="kicker" t-esc="kicker"/>
          <h1 class="dn-top__title" t-esc="titulo"/>
        </div>
      </div>
      <t t-out="0"/>
    </header>
  </template>

  <!-- One order of the list (also re-rendered by the 60 s refresh). -->
  <template id="armado_lista_cuerpo" name="Armado: lista (cuerpo)">
    <div class="dn-empty" t-if="not grupos">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'empty'"/></t>
      <p>No hay pedidos para armar. Actualizá en un rato.</p>
    </div>
    <t t-foreach="grupos" t-as="g">
      <section t-att-class="'arm-zona' if g['hoy'] or g['nombre'] == 'Sin zona' else 'arm-zona arm-zona--otra'">
        <h2 class="dn-label arm-zona__tit"><span t-esc="g['nombre']"/><small t-esc="g['detalle']"/></h2>
        <div class="arm-lista">
          <t t-foreach="g['pedidos']" t-as="p">
            <t t-set="n" t-value="len(p._distri_renglones_a_armar())"/>
            <a t-att-class="'dn-card arm-ped arm-ped--%s' % p.distri_armado" t-att-href="'/armado/pedido/%s' % p.id" data-dn="down">
              <span class="arm-ped__txt">
                <span class="arm-ped__nom"><t t-esc="p._distri_nombre_cliente()"/></span>
                <span class="arm-ped__det">
                  <t t-esc="p.name"/> · <t t-esc="n"/> <t t-esc="'producto' if n == 1 else 'productos'"/>
                  <t t-if="p.distri_armado != 'pendiente' and p.distri_armador_id"> · <t t-esc="p.distri_armador_id.name"/></t>
                  <t t-if="p.distri_armado == 'armado' and p.distri_bultos">
                    · <b><t t-esc="p.distri_bultos"/> <t t-esc="'bulto' if p.distri_bultos == 1 else 'bultos'"/></b>
                  </t>
                </span>
                <span class="arm-chips">
                  <span t-att-class="'dn-chip dn-chip--%s' % {'pendiente': 'warn', 'en_armado': 'info'}.get(p.distri_armado, 'ok')">
                    <t t-if="p.distri_armado == 'pendiente'">Para armar</t>
                    <t t-elif="p.distri_armado == 'en_armado'">En armado</t>
                    <t t-else="">Armado</t>
                  </span>
                  <span t-if="p._distri_sin_cliente()" class="dn-chip dn-chip--err">Sin cliente asignado</span>
                  <span t-if="p.distri_modificado" class="dn-chip dn-chip--err">Modificado</span>
                </span>
              </span>
              <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
            </a>
          </t>
        </div>
      </section>
    </t>
  </template>

  <template id="armado_lista" name="Armado: pedidos del día">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Armado · Distri Neuquén</title>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="arm dn-has-nav" t-att-data-parent="inicio" data-page="lista">
  <t t-call="distri_pedido.armado_top">
    <t t-set="volver" t-value="inicio"/>
    <t t-set="volver_txt" t-value="'Volver al inicio'"/>
    <t t-set="kicker" t-value="'%s · %s' % (fecha, usuario.name)"/>
    <t t-set="titulo" t-value="'Pedidos para armar'"/>
  </t>
  <div class="dn-banner dn-banner--ok" t-if="terminado" role="status">
    <span><b><t t-esc="terminado.name"/></b> quedó armado en
      <t t-esc="terminado.distri_bultos"/> <t t-esc="'bulto' if terminado.distri_bultos == 1 else 'bultos'"/>.</span>
    <a class="dn-btn" target="_blank" rel="noopener"
       t-att-href="'/armado/pedido/%s/etiquetas' % terminado.id">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'print'"/></t> Imprimir etiquetas</a>
  </div>
  <div class="dn-banner dn-banner--ok" t-if="dejado" role="status">
    <span>Dejaste <b><t t-esc="dejado.name"/></b> para más tarde. Quedó para armar
    y lo puede tomar cualquiera.</span>
  </div>
  <main class="dn-main arm-main" id="lista" aria-live="polite">
    <t t-call="distri_pedido.armado_lista_cuerpo"/>
  </main>
  <div class="dn-bottom"><t t-call="distri_pedido.dn_nav"/></div>
</body>
</html>
  </template>

  <!-- Un renglon del pedido. Lo usa la pagina y lo devuelven /listo, /falta
       y /agregar para reemplazarlo en su lugar sin recargar. El armador toca
       «Listo» o anota lo que falta; lo que no toca se entrega completo.
       States: pend (to pack), listo (ticked), falta (short, amber). -->
  <template id="armado_renglon" name="Armado: renglón">
    <t t-set="faltante" t-value="l.distri_faltante"/>
    <t t-set="estado" t-value="'falta' if faltante else ('listo' if l.distri_listo else 'pend')"/>
    <t t-set="unidad" t-value="l.product_uom_id.name if l.product_uom_id.relative_factor &gt; 1 else ''"/>
    <t t-set="cabeza">
      <span class="ren__mark" aria-hidden="true">
        <span t-if="estado == 'falta'" class="dn-chip dn-chip--warn">Falta</span>
        <span t-elif="estado == 'listo'" class="ren__tick"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'check'"/></t></span>
        <span t-else="" class="ren__circle"/>
      </span>
      <img t-if="puede_tocar" class="ren__foto" loading="lazy" width="56" height="56" alt=""
           t-att-src="foto(l.product_id)"/>
      <span class="ren__nom">
        <span class="ren__prod"><t t-esc="l.product_id.name"/></span>
        <span t-if="l.distri_por_telefono" class="dn-chip">Agregado por teléfono</span>
        <span class="ren__res" t-if="faltante">Faltan <t t-esc="cant(faltante)"/> · se entregan <t t-esc="cant(l.product_uom_qty)"/></span>
        <span class="dn-sr"><t t-if="estado == 'listo'">Listo.</t><t t-elif="estado == 'falta'">Con faltante.</t><t t-else="">Para armar.</t></span>
      </span>
      <span class="ren__cant dn-num">
        <t t-if="faltante"><t t-esc="cant(l.product_uom_qty)"/> <small>de <t t-esc="cant(l.distri_pedida)"/></small></t>
        <t t-else=""><b t-esc="cant(l.distri_pedida)"/></t>
        <small t-if="unidad" class="ren__uni" t-esc="unidad"/>
      </span>
    </t>
    <details t-if="puede_tocar" t-att-id="'r%s' % l.id" t-att-class="'ren ren--%s' % estado"
             t-att-data-estado="estado" t-att-data-pedida="cant(l.distri_pedida)"
             t-att-open="'open' if actual and actual == l else None">
      <summary class="ren__top"><t t-out="cabeza"/></summary>
      <div class="ren__body">
        <div class="dn-grid2">
          <form t-if="estado != 'falta'" method="post" data-fetch="listo"
                t-att-action="'/armado/pedido/%s/listo' % pedido.id">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <input type="hidden" name="linea_id" t-att-value="l.id"/>
            <button t-if="estado == 'pend'" type="submit" name="accion" value="listo" class="dn-btn dn-btn--lg">
              Listo, <t t-esc="cant(l.distri_pedida)"/></button>
            <button t-else="" type="submit" name="accion" value="deshacer" class="dn-btn dn-btn--lg dn-btn--ghost">
              Volver a revisar</button>
          </form>
          <form t-else="" method="post" data-fetch="falta"
                t-att-action="'/armado/pedido/%s/falta' % pedido.id">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <input type="hidden" name="linea_id" t-att-value="l.id"/>
            <button type="submit" name="accion" value="deshacer" class="dn-btn dn-btn--lg dn-btn--ghost">
              No falta nada</button>
          </form>
          <label class="dn-btn dn-btn--lg dn-btn--warn" t-att-for="'f%s' % l.id" role="button" tabindex="0">
            <t t-if="faltante">Corregir</t><t t-else="">Falta</t></label>
        </div>
        <input type="checkbox" class="ren__tog dn-sr" t-att-id="'f%s' % l.id" tabindex="-1" aria-hidden="true"/>
        <form class="ren__falta" method="post" data-fetch="falta"
              t-att-action="'/armado/pedido/%s/falta' % pedido.id">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="linea_id" t-att-value="l.id"/>
          <div class="dn-field">
            <label t-att-for="'c%s' % l.id">¿Cuántas faltan?</label>
            <div class="dn-row">
              <input class="dn-input dn-input--big" t-att-id="'c%s' % l.id" type="number" name="faltan"
                     min="1" step="1" inputmode="numeric"
                     t-att-max="cant(l.distri_pedida)"
                     t-att-value="cant(faltante) if faltante else ''"/>
              <button type="submit" name="accion" value="faltan" class="dn-btn dn-btn--navy">Guardar</button>
            </div>
          </div>
          <button type="submit" name="accion" value="todas" class="dn-btn dn-btn--warn" formnovalidate="formnovalidate">
            Faltan todas (<t t-esc="cant(l.distri_pedida)"/>)</button>
        </form>
      </div>
    </details>
    <div t-else="" t-att-id="'r%s' % l.id" t-att-class="'ren ren--%s' % estado" t-att-data-estado="estado">
      <div class="ren__top"><t t-out="cabeza"/></div>
    </div>
  </template>

  <!-- Resultados del buscador de Agregar producto. Los usa la pagina (sin
       JavaScript) y /buscar, que los devuelve para el fetch(). -->
  <template id="armado_resultados" name="Armado: resultados del buscador">
    <p class="arm-vacio" t-if="q and not resultados">No encontramos productos con "<t t-esc="q"/>". Probá con otra palabra.</p>
    <t t-foreach="resultados" t-as="prod">
      <div class="arm-prod">
        <div class="arm-prod__nom"><t t-esc="prod.name"/>
          <small><t t-esc="unidad_de(prod).name"/></small>
        </div>
        <form method="post" data-fetch="agregar" t-att-data-nombre="prod.name"
              t-att-action="'/armado/pedido/%s/agregar' % pedido.id">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="producto_id" t-att-value="prod.id"/>
          <input type="hidden" name="clave" t-att-value="nueva_clave()"/>
          <input class="dn-input" type="number" name="cantidad" value="1" min="1" step="1" inputmode="numeric"
                 aria-label="Cantidad"/>
          <button type="submit" class="dn-btn">Agregar</button>
        </form>
      </div>
    </t>
  </template>

  <template id="armado_pedido" name="Armado: un pedido">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title><t t-esc="pedido.name"/> · Armado</title>
  <t t-call="distri_pedido.dn_head"/>
</head>
<t t-set="csrf_token" t-value="request.csrf_token()"/>
<t t-set="total" t-value="len(renglones)"/>
<t t-set="con_foot" t-value="pedido.distri_armado == 'pendiente' or puede_tocar or puede_corregir"/>
<body t-att-class="'arm dn-has-foot' if con_foot else 'arm dn-has-nav'" data-parent="/armado"
      data-page="pedido" t-att-data-pedido="pedido.id">
  <t t-call="distri_pedido.armado_top">
    <t t-set="volver" t-value="'/armado'"/>
    <t t-set="volver_txt" t-value="'Volver a los pedidos'"/>
    <t t-set="kicker" t-value="pedido.name + (' · %s' % pedido.distri_zona_id.name if pedido.distri_zona_id else '')"/>
    <t t-set="titulo" t-value="pedido._distri_nombre_cliente()"/>
    <div class="dn-top__extra" id="progreso" t-att-data-total="total" t-if="total">
      <div class="dn-progress__txt">
        <span><span class="js-hechos dn-num" t-esc="hechos"/> de <t t-esc="total"/> <t t-esc="'producto' if total == 1 else 'productos'"/></span>
        <b class="js-faltan" t-att-hidden="None if con_faltante else 'hidden'">
          <t t-esc="con_faltante"/> <t t-esc="'faltante' if con_faltante == 1 else 'faltantes'"/></b>
      </div>
      <div class="dn-progress" role="progressbar" aria-label="Productos revisados" aria-valuemin="0"
           t-att-aria-valuemax="total" t-att-aria-valuenow="hechos">
        <i t-attf-style="width:{{ int(round(100.0 * hechos / total)) }}%"/>
      </div>
    </div>
  </t>
  <div class="dn-banner dn-banner--err" t-if="error" role="alert"><t t-esc="error"/></div>
  <div class="dn-banner dn-banner--err" t-if="pedido.state == 'cancel'">Este pedido se canceló.</div>
  <div class="dn-banner" t-if="(pedido._distri_sin_cliente() and pedido.distri_domicilio) or pedido.distri_entrega == 'retira'">
    <t t-if="pedido._distri_sin_cliente() and pedido.distri_domicilio"><t t-esc="pedido.distri_domicilio"/></t>
    <t t-if="pedido.distri_entrega == 'retira'">Lo retira en el depósito.</t>
  </div>
  <div class="dn-banner dn-banner--warn" t-if="pedido._distri_sin_cliente()">
    Sin cliente asignado. Se arma igual; la factura espera a que administración
    asigne el cliente.
  </div>
  <div class="dn-banner dn-banner--warn" t-if="pedido.distri_modificado">
    El cliente modificó este pedido después de cargarlo.
  </div>
  <div class="dn-banner" t-if="pedido.distri_encomienda"><span>
    <b>Encomienda</b> a la terminal de <t t-esc="pedido._distri_parcel_town()"/>
    <t t-if="pedido.distri_carrier_id"> · <t t-esc="pedido.distri_carrier_id.name"/></t>
    · <t t-esc="pedido.distri_envio_paga_label"/>
    <t t-if="pedido.distri_encomienda_retira"> · Retira: <t t-esc="pedido.distri_encomienda_retira"/></t>.
    Embalar para viajar en micro y poner el remito adentro.
  </span></div>
  <div class="dn-banner dn-banner--warn" t-if="pedido.distri_armado == 'en_armado' and not puede_tocar">
    Lo está armando <t t-esc="pedido.distri_armador_id.name"/>
    desde las <t t-esc="hora(pedido.distri_armado_inicio)"/>.
  </div>
  <div class="dn-banner dn-banner--ok" t-if="pedido.distri_armado == 'armado'" id="armado-ok">
    <span>Armado por <t t-esc="pedido.distri_armador_id.name"/>
    a las <t t-esc="hora(pedido.distri_armado_fin)"/><t t-if="pedido.distri_bultos">,
      en <b class="js-bultos"><t t-esc="pedido.distri_bultos"/> <t t-esc="'bulto' if pedido.distri_bultos == 1 else 'bultos'"/></b></t>.</span>
  </div>
  <div class="dn-banner" t-if="pedido.distri_armado == 'pendiente' and pedido.state != 'cancel'">
    Tocá «Tomar pedido» para empezar a armarlo.
  </div>

  <main class="dn-main arm-main arm-cols">
    <div class="arm-ren" id="renglones">
      <t t-foreach="renglones" t-as="l">
        <t t-call="distri_pedido.armado_renglon"/>
      </t>
      <div class="dn-empty" t-if="not renglones"><p>El pedido no tiene productos.</p></div>
    </div>

    <div class="arm-lado">
      <t t-if="puede_tocar">
        <h2 class="dn-label">Agregar producto</h2>
        <div class="dn-card arm-agregar">
          <form class="dn-row" method="get" t-att-action="'/armado/pedido/%s' % pedido.id" role="search"
                t-att-data-buscar="'/armado/pedido/%s/buscar' % pedido.id">
            <input class="dn-input" type="search" name="q" t-att-value="q" placeholder="Buscar en el catálogo"
                   autocomplete="off" aria-label="Buscar en el catálogo"/>
            <button type="submit" class="dn-btn dn-btn--navy" aria-label="Buscar">
              <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'search'"/></t></button>
          </form>
          <div id="resultados"><t t-call="distri_pedido.armado_resultados"/></div>
        </div>
        <p class="arm-hint">Lo que no marcaste como faltante se entrega completo.</p>
      </t>

      <!-- Sheets. Without JavaScript they are plain cards at the end of the
           page and the footer buttons jump to them. -->
      <section t-if="puede_tocar" class="dn-sheet" id="terminar" role="dialog" aria-labelledby="terminar-t">
        <h2 id="terminar-t"><t t-if="pedido._distri_sin_cliente()">Terminar armado</t><t t-else="">Terminar y facturar</t></h2>
        <p class="arm-quedan" hidden="hidden"/>
        <form method="post" data-fetch="terminar" class="arm-form"
              t-att-action="'/armado/pedido/%s/terminar' % pedido.id">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <div class="dn-field">
            <label for="bultos">¿En cuántos bultos quedó?</label>
            <div class="dn-step arm-step">
              <button type="button" data-paso="-1" aria-label="Uno menos"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'minus'"/></t></button>
              <input class="dn-input dn-num" type="number" id="bultos" name="bultos" min="1" max="999" step="1"
                     inputmode="numeric" required="required" placeholder="0"/>
              <button type="button" data-paso="1" aria-label="Uno más"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'plus'"/></t></button>
            </div>
          </div>
          <p class="arm-hint">Lo que no marcaste como faltante se entrega completo.</p>
          <button type="submit" class="dn-btn dn-btn--lg">Terminar armado</button>
          <a t-att-href="'/armado/pedido/%s' % pedido.id" class="dn-btn dn-btn--ghost arm-solojs" data-dn-close="">Seguir armando</a>
        </form>
      </section>

      <section t-if="puede_tocar" class="dn-sheet" id="mas-tarde" role="dialog" aria-labelledby="mas-tarde-t">
        <h2 id="mas-tarde-t">¿Lo dejás para más tarde?</h2>
        <p class="arm-borra" t-att-hidden="None if con_faltante else 'hidden'">
          <t t-if="con_faltante == 1">Se va a borrar el faltante que marcaste.</t>
          <t t-else="">Se van a borrar los <t t-esc="con_faltante"/> faltantes que marcaste.</t>
        </p>
        <p>El pedido vuelve a la lista como para armar: lo puede tomar cualquiera y
          el cliente lo puede volver a cambiar.</p>
        <form method="post" data-fetch="mas-tarde" class="dn-grid2"
              t-att-action="'/armado/pedido/%s/mas-tarde' % pedido.id">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <a t-att-href="'/armado/pedido/%s' % pedido.id" class="dn-btn dn-btn--ghost" data-dn-close="">Cancelar</a>
          <button type="submit" class="dn-btn dn-btn--navy">Sí, dejarlo</button>
        </form>
      </section>

      <section t-if="puede_corregir" class="dn-sheet" id="corregir" role="dialog" aria-labelledby="corregir-t">
        <h2 id="corregir-t">Corregir bultos</h2>
        <form method="post" data-fetch="bultos" class="arm-form"
              t-att-action="'/armado/pedido/%s/bultos' % pedido.id">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <div class="dn-field">
            <label for="bultos-c">¿En cuántos bultos quedó?</label>
            <input class="dn-input dn-input--big dn-num" type="number" id="bultos-c" name="bultos" min="1" max="999"
                   step="1" inputmode="numeric" required="required" t-att-value="pedido.distri_bultos or ''"/>
          </div>
          <button type="submit" class="dn-btn dn-btn--lg">Guardar bultos</button>
        </form>
      </section>
    </div>
  </main>

  <div class="dn-bottom">
    <div t-if="pedido.distri_armado == 'pendiente' and pedido.state != 'cancel'" class="dn-foot dn-foot--one">
      <form method="post" data-fetch="tomar" t-att-action="'/armado/pedido/%s/tomar' % pedido.id">
        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
        <button type="submit" class="dn-btn dn-btn--lg">Tomar pedido</button>
      </form>
    </div>
    <div t-elif="puede_tocar" class="dn-foot">
      <a href="#mas-tarde" class="dn-btn dn-btn--lg dn-btn--ghost" data-sheet="mas-tarde">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'clock'"/></t> Más tarde</a>
      <a href="#terminar" class="dn-btn dn-btn--lg" data-sheet="terminar">
        <t t-if="pedido._distri_sin_cliente()">Terminar armado</t><t t-else="">Terminar y facturar</t></a>
    </div>
    <div t-elif="puede_corregir" class="dn-foot">
      <a href="#corregir" class="dn-btn dn-btn--lg dn-btn--ghost" data-sheet="corregir">Corregir bultos</a>
      <a t-if="pedido.distri_bultos" class="dn-btn dn-btn--lg" target="_blank" rel="noopener"
         t-att-href="'/armado/pedido/%s/etiquetas' % pedido.id">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'print'"/></t> Imprimir etiquetas</a>
    </div>
    <t t-call="distri_pedido.dn_nav"/>
  </div>
</body>
</html>
  </template>

  <template id="armado_faltantes" name="Armado: faltantes del día">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Faltantes del día · Distri Neuquén</title>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="arm dn-has-nav" t-att-data-parent="inicio" data-page="faltantes">
  <t t-call="distri_pedido.armado_top">
    <t t-set="volver" t-value="inicio"/>
    <t t-set="volver_txt" t-value="'Volver al inicio'"/>
    <t t-set="kicker" t-value="fecha"/>
    <t t-set="titulo" t-value="'Faltantes del día'"/>
  </t>
  <main class="dn-main arm-main">
    <div class="dn-empty" t-if="not filas">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'check'"/></t>
      <p>Hoy no se anotaron faltantes.</p>
    </div>
    <div class="arm-ren" t-if="filas">
      <t t-foreach="filas" t-as="f">
        <div class="ren ren--falta arm-falt">
          <div class="ren__top">
            <span class="ren__nom"><span class="ren__prod"><t t-esc="f['producto'].name"/></span>
              <span class="ren__res">
                <t t-foreach="f['pedidos']" t-as="x">
                  <t t-esc="x['pedido'].name"/> <t t-esc="x['pedido']._distri_nombre_cliente()"/>
                  (<t t-esc="cant(x['faltan'])"/>)<t t-if="not x_last">, </t>
                </t>
              </span>
            </span>
            <span class="ren__cant dn-num"><b t-esc="cant(f['total'])"/>
              <small t-if="f['unidad']" class="ren__uni" t-esc="f['unidad']"/></span>
          </div>
        </div>
      </t>
    </div>
  </main>
  <div class="dn-bottom"><t t-call="distri_pedido.dn_nav"/></div>
</body>
</html>
  </template>

  <!-- ========================================= backend: app del armado -->

  <!-- Administracion tambien arma cuando hay mucho trabajo: la pantalla del
       armador como app propia del menu principal. -->
  <record id="action_armado_pantalla" model="ir.actions.act_url">
    <field name="name">Armado</field>
    <field name="url">/armado</field>
    <field name="target">self</field>
  </record>

  <menuitem id="menu_armado_app" name="Armado" sequence="44"
            web_icon="distri_pedido,static/src/img/iconos/armado.png"
            action="action_armado_pantalla"
            groups="distri_pedido.grupo_armador"/>

  <!-- ================================================== backend: zonas -->

  <record id="view_zona_list" model="ir.ui.view">
    <field name="name">distri.zona.list</field>
    <field name="model">distri.zona</field>
    <field name="arch" type="xml">
      <list string="Zonas de reparto" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="viaje"/>
        <field name="dia_lunes"/>
        <field name="dia_martes"/>
        <field name="dia_miercoles"/>
        <field name="dia_jueves"/>
        <field name="dia_viernes"/>
        <field name="dia_sabado" optional="hide"/>
        <field name="active" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_zona_form" model="ir.ui.view">
    <field name="name">distri.zona.form</field>
    <field name="model">distri.zona</field>
    <field name="arch" type="xml">
      <form string="Zona de reparto">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="viaje"/>
              <field name="sequence"/>
              <field name="active"/>
            </group>
            <group string="Días de reparto">
              <field name="dia_lunes"/>
              <field name="dia_martes"/>
              <field name="dia_miercoles"/>
              <field name="dia_jueves"/>
              <field name="dia_viernes"/>
              <field name="dia_sabado"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_zona" model="ir.actions.act_window">
    <field name="name">Zonas de reparto</field>
    <field name="res_model">distri.zona</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>La zona del pedido sale de la ciudad del cliente. El armador ve primero las
         zonas que reparten hoy, en el orden de los viajes.</p>
    </field>
  </record>

  <menuitem id="menu_zona"
            name="Zonas de reparto"
            parent="sale.sale_order_menu"
            action="action_zona"
            groups="distri_pedido.grupo_administracion,sales_team.group_sale_manager,base.group_system"
            sequence="42"/>

  <!-- ============================================ backend: pedido de venta -->

  <record id="view_order_form_armado" model="ir.ui.view">
    <field name="name">sale.order.form.armado</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_distri_abrir_armado" type="object" string="Armar este pedido"
                groups="distri_pedido.grupo_armador"
                invisible="state != 'sale' or distri_armado == 'armado'"/>
        <button name="action_distri_facturar_armado" type="object" string="Facturar lo armado"
                groups="distri_pedido.grupo_administracion" class="btn-primary"
                invisible="state != 'sale' or distri_armado != 'armado' or distri_falta_cliente or invoice_count"/>
        <button name="action_distri_dejar_para_mas_tarde" type="object" string="Dejar para más tarde"
                groups="distri_pedido.grupo_administracion"
                invisible="state == 'cancel' or distri_armado != 'en_armado'"
                confirm="El pedido vuelve a pendiente: lo puede tomar cualquier armador y el cliente lo puede volver a cambiar. Se borran los faltantes que marcó el armador; lo agregado por teléfono queda. ¿Seguimos?"/>
      </xpath>
      <xpath expr="//page[@name='other_information']" position="before">
        <page string="Armado" name="distri_armado">
          <div class="alert alert-danger" role="alert" invisible="not distri_factura_error">
            No salió la factura del armado: <field name="distri_factura_error" readonly="1" class="d-inline"/>
          </div>
          <group>
            <group>
              <field name="distri_armado"/>
              <field name="distri_falta_cliente" widget="badge" decoration-danger="1"
                     invisible="not distri_falta_cliente"/>
              <field name="distri_armador_id"/>
              <field name="distri_modificado"/>
            </group>
            <group>
              <field name="distri_zona_id"/>
              <field name="distri_armado_inicio"/>
              <field name="distri_armado_fin"/>
              <field name="distri_bultos" invisible="distri_armado != 'armado'"/>
              <field name="distri_factura_auto_id" invisible="not distri_factura_auto_id"/>
            </group>
          </group>
        </page>
      </xpath>
      <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
        <field name="distri_faltante" optional="show" column_invisible="parent.state != 'sale'" readonly="1"/>
        <field name="distri_por_telefono" optional="show" column_invisible="parent.state != 'sale'" readonly="1"/>
      </xpath>
    </field>
  </record>

  <record id="view_order_list_armado" model="ir.ui.view">
    <field name="name">sale.order.list.armado</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree"/>
    <field name="arch" type="xml">
      <field name="state" position="before">
        <field name="distri_armado" optional="show" widget="badge"
               decoration-warning="distri_armado == 'en_armado'"
               decoration-success="distri_armado == 'armado'"/>
        <field name="distri_falta_cliente" optional="show" widget="badge" decoration-danger="1"/>
        <field name="distri_bultos" optional="show" invisible="distri_armado != 'armado'"/>
        <field name="distri_modificado" optional="show"/>
      </field>
    </field>
  </record>

  <!-- Un pedido de la pagina se puede armar antes de que el administrador le
       asigne el cliente (decision 7): queda en Cotizaciones, y aca se ve que
       ya lo tomo el armador y que falta asignarle el cliente para facturar. -->
  <record id="view_quotation_list_armado" model="ir.ui.view">
    <field name="name">sale.order.quotation.list.armado</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree"/>
    <field name="arch" type="xml">
      <field name="state" position="before">
        <field name="distri_armado" optional="show" widget="badge"
               decoration-warning="distri_armado == 'en_armado'"
               decoration-success="distri_armado == 'armado'"/>
        <field name="distri_falta_cliente" optional="show" widget="badge" decoration-danger="1"/>
      </field>
    </field>
  </record>

  <record id="view_order_search_armado" model="ir.ui.view">
    <field name="name">sale.order.search.armado</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <separator/>
        <filter name="distri_armado_sin_cliente" string="Armado · falta asignar cliente"
                domain="[('distri_armado', '=', 'armado'), ('distri_falta_cliente', '=', 'falta')]"/>
        <filter name="distri_en_armado_sin_cliente" string="Tomado por el armador · falta asignar cliente"
                domain="[('distri_falta_cliente', '=', 'falta')]"/>
        <filter name="distri_factura_error" string="Armado · no salió la factura"
                domain="[('distri_factura_error', '!=', False)]"/>
      </xpath>
    </field>
  </record>

</odoo>
