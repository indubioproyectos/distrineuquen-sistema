<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 19.0.1.129.0: «Auditoría de cobros» (models/auditoria.py), «Resumen
       diario por persona» and «Autorizados por Gerencia»
       (models/pago_proveedor.py). -->

  <!-- ================================================= anomalies -->

  <record id="view_mp_anomaly_list" model="ir.ui.view">
    <field name="name">distri.mp.anomaly.list</field>
    <field name="model">distri.mp.anomaly</field>
    <field name="arch" type="xml">
      <list string="Auditoría de cobros" create="0" edit="0" delete="0"
            decoration-danger="state == 'open' and overdue"
            decoration-warning="state == 'open' and not overdue"
            decoration-muted="state in ('resolved', 'annulled')">
        <field name="first_seen" optional="show"/>
        <field name="kind"/>
        <field name="state" widget="badge"
               decoration-warning="state == 'open'" decoration-success="state == 'reviewed'"/>
        <field name="partner_id"/>
        <field name="amount" sum="Total"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="payment_id"/>
        <field name="journal_id" optional="show"/>
        <field name="card_id" optional="show"/>
        <field name="income_id" optional="hide"/>
        <field name="credited_by_id"/>
        <field name="credited_at"/>
        <field name="detail" optional="show"/>
        <field name="overdue" optional="show"/>
        <field name="reviewed_by_id" optional="hide"/>
        <field name="review_note" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_mp_anomaly_form" model="ir.ui.view">
    <field name="name">distri.mp.anomaly.form</field>
    <field name="model">distri.mp.anomaly</field>
    <field name="arch" type="xml">
      <form string="Anomalía" create="0" edit="0" delete="0">
        <header>
          <button name="action_open_review" type="object" string="Marcar revisado"
                  class="btn-primary" invisible="state != 'open'"/>
          <button name="action_open_annul" type="object" string="Anular pago"
                  invisible="state not in ('open', 'reviewed') or not payment_id or payment_state in ('draft', 'canceled')"/>
          <field name="state" widget="statusbar" statusbar_visible="open,reviewed"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_payment" type="object" class="oe_stat_button"
                    icon="fa-money" string="Pago" invisible="not payment_id"/>
            <button name="action_view_card" type="object" class="oe_stat_button"
                    icon="fa-file-image-o" string="Comprobante"
                    invisible="not card_id and not income_id"/>
          </div>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <div class="alert alert-danger" role="alert" invisible="not overdue">
            Alerta a Gerencia: sigue sin transferencia en el reporte de Mercado Pago.
          </div>
          <group>
            <group>
              <field name="kind"/>
              <field name="partner_id"/>
              <field name="amount"/>
              <field name="currency_id" invisible="1"/>
              <field name="detail"/>
            </group>
            <group>
              <field name="payment_id"/>
              <field name="payment_state"/>
              <field name="journal_id"/>
              <field name="related_payment_id" invisible="not related_payment_id"/>
              <field name="card_id" invisible="not card_id"/>
              <field name="related_card_id" invisible="not related_card_id"/>
              <field name="income_id" invisible="not income_id"/>
            </group>
            <group string="Quién">
              <field name="credited_by_id"/>
              <field name="credited_at"/>
            </group>
            <group string="Auditoría">
              <field name="first_seen"/>
              <field name="last_seen"/>
              <field name="audit_id"/>
              <field name="reviewed_by_id" invisible="not reviewed_by_id"/>
              <field name="reviewed_at" invisible="not reviewed_at"/>
              <field name="resolved_at" invisible="not resolved_at"/>
              <field name="review_note" invisible="not review_note"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_mp_anomaly_search" model="ir.ui.view">
    <field name="name">distri.mp.anomaly.search</field>
    <field name="model">distri.mp.anomaly</field>
    <field name="arch" type="xml">
      <search>
        <field name="partner_id"/>
        <field name="payment_id"/>
        <field name="credited_by_id"/>
        <field name="detail"/>
        <filter name="open" string="Abiertas" domain="[('state', '=', 'open')]"/>
        <filter name="reviewed" string="Revisadas" domain="[('state', '=', 'reviewed')]"/>
        <filter name="closed" string="Resueltas o anuladas"
                domain="[('state', 'in', ('resolved', 'annulled'))]"/>
        <separator/>
        <filter name="anomalies" string="Sin la marca «sin comprobante»"
                domain="[('kind', '!=', 'sin_comprobante')]"/>
        <filter name="overdue" string="Alertas a Gerencia" domain="[('overdue', '=', True)]"/>
        <separator/>
        <filter name="missing" string="Sin transferencia"
                domain="[('kind', 'in', ('sin_transferencia', 'manual_sin_transferencia'))]"/>
        <filter name="difference" string="Diferencia o revertido"
                domain="[('kind', 'in', ('diferencia', 'revertido'))]"/>
        <filter name="duplicates" string="Duplicados"
                domain="[('kind', 'in', ('doble_acreditacion', 'operacion_repetida', 'cliente_importe'))]"/>
        <filter name="review" string="Revisar"
                domain="[('kind', 'in', ('revisar', 'mellizo_banco'))]"/>
        <filter name="no_receipt" string="Sin comprobante"
                domain="[('kind', '=', 'sin_comprobante')]"/>
        <group>
          <filter name="by_kind" string="Tipo" context="{'group_by': 'kind'}"/>
          <filter name="by_user" string="Acreditó o cargó" context="{'group_by': 'credited_by_id'}"/>
          <filter name="by_state" string="Estado" context="{'group_by': 'state'}"/>
          <filter name="by_journal" string="Diario" context="{'group_by': 'journal_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_mp_anomaly" model="ir.actions.act_window">
    <field name="name">Auditoría de cobros</field>
    <field name="res_model">distri.mp.anomaly</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_open': 1, 'search_default_anomalies': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Sin anomalías abiertas</p>
      <p>Cada vez que se sube un reporte de Mercado Pago se auditan todos los comprobantes
         acreditados y todos los pagos electrónicos hasta el último movimiento del reporte.
         Lo que no cierra aparece acá.</p>
    </field>
  </record>

  <record id="view_mp_anomaly_review_form" model="ir.ui.view">
    <field name="name">distri.mp.anomaly.review.form</field>
    <field name="model">distri.mp.anomaly.review</field>
    <field name="arch" type="xml">
      <form>
        <field name="mode" invisible="1"/>
        <div class="alert alert-warning" role="alert" invisible="not warning">
          <field name="warning"/>
        </div>
        <group>
          <field name="anomaly_ids" widget="many2many_tags"/>
          <field name="note" required="1" placeholder="Qué revisaste o por qué se anula"/>
        </group>
        <footer>
          <button name="action_apply" type="object" string="Marcar revisado" class="btn-primary"
                  invisible="mode != 'review'"/>
          <button name="action_apply" type="object" string="Anular pago" class="btn-danger"
                  invisible="mode != 'annul'"
                  confirm="Se anula el pago y vuelve la deuda que cancelaba. ¿Seguir?"/>
          <button special="cancel" string="Cancelar"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ================================================= audit runs -->

  <record id="view_mp_audit_list" model="ir.ui.view">
    <field name="name">distri.mp.audit.list</field>
    <field name="model">distri.mp.audit</field>
    <field name="arch" type="xml">
      <list string="Corridas de auditoría" create="0" edit="0" delete="0">
        <header>
          <button name="action_run_now" type="object" string="Auditar ahora" display="always"
                  class="btn-primary"/>
        </header>
        <field name="run_at"/>
        <field name="report_id"/>
        <field name="covers_until"/>
        <field name="credited_count"/>
        <field name="verified_count"/>
        <field name="pending_count"/>
        <field name="missing_count"/>
        <field name="difference_count" optional="show"/>
        <field name="duplicate_count"/>
        <field name="without_receipt_count" optional="show"/>
        <field name="open_count"/>
        <field name="alert_count" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_mp_audit_form" model="ir.ui.view">
    <field name="name">distri.mp.audit.form</field>
    <field name="model">distri.mp.audit</field>
    <field name="arch" type="xml">
      <form string="Auditoría" create="0" edit="0" delete="0">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_anomalies" type="object" class="oe_stat_button"
                    icon="fa-exclamation-triangle" string="Anomalías"/>
          </div>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <field name="summary"/>
          <group>
            <group string="Comprobantes acreditados">
              <field name="credited_count"/>
              <field name="verified_count"/>
              <field name="pending_count"/>
              <field name="difference_count"/>
              <field name="missing_count"/>
              <field name="reversed_count"/>
              <field name="annulled_count"/>
              <field name="review_count"/>
              <field name="tied_count"/>
            </group>
            <group string="Pagos electrónicos">
              <field name="report_id"/>
              <field name="covers_until"/>
              <field name="payment_count"/>
              <field name="without_receipt_count"/>
              <field name="duplicate_count"/>
              <field name="bank_twin_count"/>
              <field name="open_count"/>
              <field name="alert_count"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_mp_audit" model="ir.actions.act_window">
    <field name="name">Corridas de auditoría</field>
    <field name="res_model">distri.mp.audit</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ================================================= daily summary -->

  <record id="view_credit_summary_list" model="ir.ui.view">
    <field name="name">distri.credit.summary.list</field>
    <field name="model">distri.credit.summary</field>
    <field name="arch" type="xml">
      <list string="Resumen diario por persona" create="0" edit="0" delete="0">
        <field name="date"/>
        <field name="count"/>
        <field name="amount"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="anomaly_count"/>
        <field name="text"/>
      </list>
    </field>
  </record>

  <record id="view_credit_summary_form" model="ir.ui.view">
    <field name="name">distri.credit.summary.form</field>
    <field name="model">distri.credit.summary</field>
    <field name="arch" type="xml">
      <form string="Resumen diario" create="0" edit="0" delete="0">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <field name="count"/>
            <field name="amount"/>
            <field name="currency_id" invisible="1"/>
            <field name="anomaly_count"/>
          </group>
          <field name="line_ids">
            <list>
              <field name="user_id"/>
              <field name="count"/>
              <field name="amount" sum="Total"/>
              <field name="currency_id" column_invisible="1"/>
              <field name="verified_count"/>
              <field name="pending_count"/>
              <field name="anomaly_count"/>
              <field name="supplier_count"/>
              <field name="supplier_amount"/>
            </list>
          </field>
          <field name="text"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_credit_summary" model="ir.actions.act_window">
    <field name="name">Resumen diario por persona</field>
    <field name="res_model">distri.credit.summary</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ================================================= supplier payments -->

  <record id="view_supplier_payment_list" model="ir.ui.view">
    <field name="name">distri.supplier.payment.list</field>
    <field name="model">distri.supplier.payment</field>
    <field name="arch" type="xml">
      <list string="Autorizados por Gerencia" decoration-muted="state == 'cancelled'">
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="supplier_id"/>
        <field name="amount" sum="Total"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="loaded_by_id"/>
        <field name="authorized_by_id"/>
        <field name="payment_id"/>
        <field name="state" widget="badge" decoration-success="state == 'posted'"/>
      </list>
    </field>
  </record>

  <record id="view_supplier_payment_form" model="ir.ui.view">
    <field name="name">distri.supplier.payment.form</field>
    <field name="model">distri.supplier.payment</field>
    <field name="arch" type="xml">
      <form string="Pago a proveedor por cuenta de un cliente" delete="0">
        <header>
          <button name="action_post" type="object" string="Acreditar al cliente"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_cancel" type="object" string="Anular"
                  invisible="state == 'cancelled'"
                  confirm="Se anula el pago y vuelve la deuda que cancelaba. ¿Seguir?"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_payment" type="object" class="oe_stat_button"
                    icon="fa-money" string="Pago" invisible="not payment_id"/>
          </div>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="partner_id" readonly="state != 'draft'"/>
              <field name="supplier_id" readonly="state != 'draft'"/>
              <field name="amount" readonly="state != 'draft'"/>
              <field name="currency_id" invisible="1"/>
              <field name="date" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="authorized_by_id" readonly="state != 'draft'"/>
              <field name="loaded_by_id"/>
              <field name="posted_at"/>
              <field name="payment_id"/>
              <field name="note"/>
            </group>
          </group>
          <group>
            <field name="receipt_filename" invisible="1"/>
            <field name="receipt_file" filename="receipt_filename" readonly="state != 'draft'"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_supplier_payment" model="ir.actions.act_window">
    <field name="name">Autorizados por Gerencia</field>
    <field name="res_model">distri.supplier.payment</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Pagos a proveedores por cuenta de clientes</p>
      <p>El cliente le transfirió directo a un proveedor de la empresa, con autorización de
         Gerencia. Se acredita en un diario aparte y no se cruza con el reporte de Mercado Pago.</p>
    </field>
  </record>

  <!-- ================================================= board card -->

  <record id="view_mp_collection_form_v129" model="ir.ui.view">
    <field name="name">distri.mp.collection.form.v129</field>
    <field name="model">distri.mp.collection</field>
    <field name="inherit_id" ref="view_mp_collection_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_confirm_other_payment']" position="after">
        <button name="action_tie_bank_twin" type="object" string="Es el pago cargado a mano"
                class="btn-primary"
                invisible="kind != 'income' or state != 'draft' or not bank_twin_payment_id"
                groups="distri_pedido.grupo_cobros,base.group_system"/>
        <button name="action_confirm_not_bank_twin" type="object"
                string="Confirmar: no es ese pago"
                invisible="kind != 'income' or state != 'draft' or not bank_twin_payment_id or not partner_id"
                groups="distri_pedido.grupo_cobros,base.group_system"
                confirm="¿Revisaste que el pago cargado a mano es otra transferencia? Se registra otro pago."/>
      </xpath>
      <xpath expr="//sheet" position="inside">
        <group string="Pago cargado a mano propuesto" invisible="not bank_twin_payment_id">
          <field name="bank_twin_payment_id"/>
        </group>
      </xpath>
    </field>
  </record>

  <!-- ================================================= menus -->

  <menuitem id="menu_cobros_auditoria" name="Auditoría de cobros" parent="menu_cobros_root"
            action="action_mp_anomaly" sequence="11"
            groups="distri_pedido.grupo_administracion,distri_pedido.grupo_gerencia,base.group_system"/>
  <menuitem id="menu_cobros_resumen_diario" name="Resumen diario por persona"
            parent="menu_cobros_root" action="action_credit_summary" sequence="52"
            groups="distri_pedido.grupo_gerencia,base.group_system"/>
  <menuitem id="menu_cobros_auditoria_corridas" name="Corridas de auditoría"
            parent="menu_cobros_root" action="action_mp_audit" sequence="54"
            groups="distri_pedido.grupo_administracion,distri_pedido.grupo_gerencia,base.group_system"/>
  <menuitem id="menu_cobros_pago_proveedor" name="Autorizados por Gerencia"
            parent="menu_cobros_root" action="action_supplier_payment" sequence="56"
            groups="distri_pedido.grupo_pago_proveedor"/>

  <!-- «Pagos a proveedores por cuenta de clientes» (models/pago_proveedor.py):
       created once per company with accounting -->
  <function model="account.journal" name="_distri_ensure_supplier_journal"/>
</odoo>
