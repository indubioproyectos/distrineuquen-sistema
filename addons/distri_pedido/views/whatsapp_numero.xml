<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Numbers connected to the Meta app and their role (19.0.1.88.0,
       models/whatsapp.py). Loaded last: the «Comprobantes sin archivo» menu
       hangs from the Cobros menu (views/cobros.xml). -->

  <record id="view_whatsapp_numero_list" model="ir.ui.view">
    <field name="name">distri.whatsapp.numero.list</field>
    <field name="model">distri.whatsapp.numero</field>
    <field name="arch" type="xml">
      <list string="Números de WhatsApp">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="phone_number_id"/>
        <field name="rol"/>
        <field name="whatsapp_count"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_whatsapp_numero_form" model="ir.ui.view">
    <field name="name">distri.whatsapp.numero.form</field>
    <field name="model">distri.whatsapp.numero</field>
    <field name="arch" type="xml">
      <form string="Número de WhatsApp">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_messages" type="object" class="oe_stat_button"
                    icon="fa-whatsapp">
              <field name="whatsapp_count" widget="statinfo" string="Mensajes"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                  invisible="active"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="+54 9 299 000-0000"/></h1>
          </div>
          <group>
            <group>
              <field name="phone_number_id"/>
              <field name="rol" widget="radio"/>
              <field name="active" invisible="1"/>
            </group>
            <group>
              <div class="text-muted" colspan="2">
                Todos los números de la misma app de Meta mandan sus avisos a la misma dirección.
                El Phone Number ID de cada aviso dice qué número recibió el mensaje. Un mensaje
                a un número que no está en esta lista se guarda igual, marcado «Número no
                configurado», y se trata como «Pedidos y comprobantes».
              </div>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_whatsapp_numero_search" model="ir.ui.view">
    <field name="name">distri.whatsapp.numero.search</field>
    <field name="model">distri.whatsapp.numero</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="phone_number_id"/>
        <filter name="archivados" string="Archivados" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="action_whatsapp_numero" model="ir.actions.act_window">
    <field name="name">Números de WhatsApp</field>
    <field name="res_model">distri.whatsapp.numero</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Cargá cada número conectado a la app de Meta con su Phone Number ID y su uso:
         «Pedidos y comprobantes», «Solo comprobantes» (repartidores y vendedores) o «Solo
         pedidos».</p>
    </field>
  </record>

  <menuitem id="menu_whatsapp_numero"
            name="Números de WhatsApp"
            parent="sale.sale_order_menu"
            action="action_whatsapp_numero"
            groups="base.group_system"
            sequence="42"/>

  <!-- ============================================ «Comprobantes sin archivo» -->

  <record id="view_whatsapp_missing_files_list" model="ir.ui.view">
    <field name="name">distri.whatsapp.message.missing.files.list</field>
    <field name="model">distri.whatsapp.message</field>
    <field name="priority">40</field>
    <field name="arch" type="xml">
      <list string="Comprobantes sin archivo" create="0" delete="0"
            decoration-danger="media_state == 'error'"
            decoration-warning="media_state == 'pending'">
        <field name="create_date" string="Recibido"/>
        <field name="timestamp" optional="hide"/>
        <field name="numero_recibido"/>
        <field name="wa_id"/>
        <field name="profile_name" optional="show"/>
        <field name="distri_forwarded_by_id" optional="show"/>
        <field name="message_type"/>
        <field name="media_mime_type" optional="show"/>
        <field name="media_state" widget="badge"
               decoration-warning="media_state == 'pending'"
               decoration-danger="media_state == 'error'"/>
        <field name="media_attempts" optional="show"/>
        <field name="media_error" optional="show"/>
        <field name="media_alert" optional="show"/>
        <field name="media_id" optional="hide"/>
        <button name="action_wa_download_media" type="object" string="Descargar ahora"
                icon="fa-download" groups="base.group_system"
                invisible="not media_id"/>
      </list>
    </field>
  </record>

  <record id="action_whatsapp_missing_files" model="ir.actions.server">
    <field name="name">Comprobantes sin archivo</field>
    <field name="model_id" ref="model_distri_whatsapp_message"/>
    <field name="state">code</field>
    <field name="code">action = model.action_wa_missing_files()</field>
    <field name="group_ids" eval="[(6, 0, [ref('distri_pedido.grupo_administracion'),
                                         ref('base.group_system'),
                                         ref('sales_team.group_sale_manager')])]"/>
  </record>

  <menuitem id="menu_cobros_missing_files" name="Comprobantes sin archivo"
            parent="menu_cobros_root" action="action_whatsapp_missing_files" sequence="22"
            groups="distri_pedido.grupo_administracion,base.group_system"/>

  <menuitem id="menu_whatsapp_missing_files" name="Comprobantes sin archivo"
            parent="sale.sale_order_menu" action="action_whatsapp_missing_files" sequence="43"
            groups="base.group_system,sales_team.group_sale_manager"/>

  <!-- Alerta de archivos sin bajar: una actividad para administración (sin
       correo) cuando una foto o PDF sigue sin descargar 2 h después de
       llegar, y otra cuando tiene más de 5 días (Meta lo borra a los 7). -->
  <record id="cron_whatsapp_media_alerts" model="ir.cron">
    <field name="name">WhatsApp: alertar comprobantes sin descargar</field>
    <field name="model_id" ref="model_distri_whatsapp_message"/>
    <field name="state">code</field>
    <field name="code">model._wa_cron_media_alerts()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active">True</field>
  </record>

</odoo>
