<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 19.0.1.129.33 («Etapa 3b», part 1; distri_pedido.ui_v2 only),
       controllers/equipo.py. Both on the kit with /deposito's top bar
       (deposito_top, static/src/deposito/deposito.css) plus
       static/src/kit/equipo.css. -->

  <!-- #74 «Equipo»: read-only (no user, group or password is changed here) -->
  <template id="equipo_page" name="Equipo">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Equipo · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="dp eq" data-parent="/tablero" data-page="equipo">
  <t t-call="distri_pedido.deposito_top">
    <t t-set="volver" t-value="inicio"/>
    <t t-set="kicker" t-value="'Distri Neuquén · %s' % user.name"/>
    <t t-set="titulo" t-value="'Equipo'"/>
    <t t-set="sub" t-value="summary"/>
  </t>
  <main class="dn-main">
    <ul class="eq-list">
      <li t-foreach="rows" t-as="r" t-att-class="'eq-row' + ('' if r['active'] else ' eq-row--off')" t-att-data-user="r['id']">
        <div class="eq-row__top">
          <b class="eq-name" t-esc="r['name']"/>
          <span t-if="r['active']" class="dn-chip dn-chip--ok">Activo</span>
          <span t-else="" class="dn-chip dn-chip--neutral">Suspendido</span>
        </div>
        <span class="eq-roles" t-esc="r['roles']"/>
        <!-- 19.0.1.129.51: e-mail confirmed or not; masked but for Sistemas -->
        <span class="eq-mail" t-att-data-correo="'si' if r.get('email') else 'no'">
          <t t-if="r.get('email')">✓ Correo: <t t-esc="r['email']"/></t>
          <t t-else="">Sin correo</t>
        </span>
        <span class="eq-login">
          <t t-if="r['last_login']">Último ingreso: <t t-esc="r['last_login']"/></t>
          <t t-else="">Nunca entró</t>
        </span>
      </li>
    </ul>
    <div class="dp-note">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'user'"/></t>
      <span>Esta pantalla es solo para ver. Las altas, las suspensiones y los permisos los hace Sistemas.</span>
    </div>
  </main>
  <!-- the role's bottom bar (ui_v2 only) -->
  <t t-call="distri_pedido.dn_page_nav"/>
</body>
</html>
  </template>

  <!-- #3 «Ordenar el Inicio»: ↑/↓ per tile and «Restablecer» -->
  <template id="tablero_ordenar_page" name="Ordenar el Inicio">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Ordenar el Inicio · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="dp eq" data-parent="/tablero" data-page="tablero-ordenar">
  <t t-call="distri_pedido.deposito_top">
    <t t-set="volver" t-value="inicio"/>
    <t t-set="kicker" t-value="'Distri Neuquén · %s' % user.name"/>
    <t t-set="titulo" t-value="'Ordenar el Inicio'"/>
    <t t-set="sub" t-value="'Subí o bajá cada pantalla. El orden es solo tuyo.'"/>
  </t>
  <main class="dn-main">
    <ol class="eq-list">
      <li t-foreach="tiles" t-as="tile" class="eq-row eq-row--ord" t-att-data-tile="tile['key']">
        <span class="dp-ico"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="tile['glyph']"/></t></span>
        <b class="eq-name" t-esc="tile['title']"/>
        <form method="post" action="/tablero/ordenar" class="eq-move" data-eq-orden="">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="key" t-att-value="tile['key']"/>
          <button type="submit" name="direction" value="up" class="eq-btn" aria-label="Subir"
                  t-att-disabled="'disabled' if tile_first else None">↑</button>
          <button type="submit" name="direction" value="down" class="eq-btn" aria-label="Bajar"
                  t-att-disabled="'disabled' if tile_last else None">↓</button>
        </form>
      </li>
    </ol>
    <form t-if="custom" method="post" action="/tablero/ordenar" data-eq-orden="">
      <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
      <button type="submit" name="reset" value="1" class="dn-btn dn-btn--ghost">Restablecer el orden de fábrica</button>
    </form>
    <a class="dn-btn" t-att-href="inicio" data-dn="up">Listo</a>
  </main>
  <!-- ↑/↓ without a new history entry per tap: the same post with fetch(),
       then this page is replaced (no JavaScript: a plain post and redirect;
       a failed fetch reloads the page, which shows the saved order) -->
  <script>
    document.addEventListener('submit', function (ev) {
      var form = ev.target;
      if (!form.hasAttribute || !form.hasAttribute('data-eq-orden') || !window.fetch || !window.FormData) { return; }
      ev.preventDefault();
      var data = new FormData(form), btn = ev.submitter;
      if (btn &amp;&amp; btn.name) { data.append(btn.name, btn.value); }
      fetch(form.action, {method: 'POST', body: data, credentials: 'same-origin', headers: {'X-Distri-Fetch': '1'}})
        .then(function (r) { if (!r.ok) { throw new Error(r.status); } location.replace('/tablero/ordenar'); })
        .catch(function () { location.reload(); });
    });
  </script>
  <t t-call="distri_pedido.dn_page_nav"/>
</body>
</html>
  </template>
</odoo>
