<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- «Tablero» / «Inicio»: the staff home (controllers/tablero.py). Opening
       /odoo without a menu lands here instead of Odoo's Discuss.
       19.0.1.108.0 (owner-approved mockup «Inicio»): on the kit, with a
       glyph per tile, count badges, the «pedidos sin cliente» banner, «Mi
       reparto de hoy» for a user that also drives, and Odoo's other apps
       folded under «Todas las aplicaciones de Odoo». -->
  <template id="tablero_page" name="Tablero del equipo">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Inicio · <t t-esc="empresa"/></title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
</head>
<body class="tab" data-parent="" data-page="tablero">
  <header class="dn-top">
    <div class="dn-top__row">
      <div class="dn-top__txt">
        <span class="dn-top__kicker"><t t-esc="empresa"/> · <t t-esc="user.name"/></span>
        <h1 class="dn-top__title tab-title">Inicio</h1>
      </div>
      <t t-call="distri_pedido.dn_ajustes"/>
    </div>
  </header>

  <!-- 19.0.1.126.0: the one-time notice of the instant crediting, until «Entendido» -->
  <form t-if="aviso_acreditar" class="dn-card dn-card--warn tab-aviso" method="post"
        action="/tablero/aviso-acreditar" role="alert" data-aviso="acreditar">
    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
    <input type="hidden" name="volver" value="/tablero"/>
    <p t-esc="aviso_acreditar"/>
    <button type="submit" class="dn-btn">Entendido</button>
  </form>

  <!-- 19.0.1.113.0: agil_banner, the stopped AgilPedido sync (controllers/tablero.py) -->
  <div t-if="banner or agil_banner or reclamar" class="tab-banners">
    <a t-if="agil_banner" class="tab-alerta tab-alerta--err" t-att-href="agil_banner['url']" role="alert">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'alert'"/></t>
      <span t-esc="agil_banner['text']"/>
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
    </a>
    <!-- 19.0.1.129.37 (nueva_venta): the receipts «Lo manda después» left at his name -->
    <a t-if="reclamar" class="tab-alerta" t-att-href="reclamar['url']" data-dn="down" data-tab="reclamar">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'receipt'"/></t>
      <span t-esc="reclamar['text']"/>
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
    </a>
    <a t-if="banner" class="tab-alerta" t-att-href="banner['url']" data-dn="down">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'alert'"/></t>
      <span t-esc="banner['text']"/>
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
    </a>
  </div>

  <main class="tab-tiles">
    <a t-foreach="tiles" t-as="tile" class="tab-tile" t-att-href="tile['url']"
       t-att-data-dn="'down' if not tile['url'].startswith('/odoo') else None"
       t-att-data-tile="tile['key']">
      <span t-if="tile['badge']" t-att-class="'tab-badge dn-num' + (' tab-badge--%s' % tile['badge']['kind'] if tile['badge']['kind'] else '')"
            t-esc="tile['badge']['text']"/>
      <span class="tab-ico"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="tile['glyph']"/></t></span>
      <b t-esc="tile['title']"/>
      <span class="tab-sub" t-esc="tile['subtitle']"/>
    </a>
  </main>

  <section class="tab-more">
    <!-- 19.0.1.129.33 (#3): each user's own order of the tiles (ui_v2 only) -->
    <a t-if="ordenar_url" class="dn-link tab-ordenar" t-att-href="ordenar_url" data-dn="down">Ordenar el Inicio</a>
    <t t-if="mi_ruta">
      <h2 class="dn-label">Para el repartidor</h2>
      <a class="tab-row" t-att-href="mi_ruta['url']">
        <span class="tab-ico tab-ico--sm"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'truck'"/></t></span>
        <span class="tab-row__txt"><b>Mi reparto de hoy</b><span t-esc="mi_ruta['detail']"/></span>
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
      </a>
    </t>
    <details t-if="apps" class="tab-apps">
      <summary class="dn-link">Todas las aplicaciones del sistema</summary>
      <div class="tab-apps__grid">
        <a t-foreach="apps" t-as="app" class="tab-app" t-att-href="app['url']"><img t-att-src="app['icon']" alt="" loading="lazy"/><t t-esc="app['title']"/></a>
      </div>
    </details>
  </section>
</body>
</html>
  </template>

</odoo>
