<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- «Tablero»: the staff home (controllers/tablero.py). Opening /odoo
       without a menu lands here instead of Odoo's Discuss. -->
  <template id="tablero_page" name="Tablero del equipo">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <meta name="theme-color" content="#10243f"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <title>Inicio · <t t-esc="empresa"/></title>
  <link rel="manifest" href="/tablero/manifest.webmanifest"/>
  <link rel="icon" href="/distri_pedido/static/src/img/iconos/app-192.png?v=95"/>
  <link rel="apple-touch-icon" href="/distri_pedido/static/src/img/iconos/app-192.png?v=95"/>
  <link rel="stylesheet" t-att-href="shared_css"/>
  <t t-call="distri_pedido.sin_historial"/>
  <style>
    #tab{max-width:760px;margin:0 auto;min-height:100vh;background:var(--bg)}
    .bar{background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:8px;
         padding:calc(7px + env(safe-area-inset-top)) 12px 7px;font-size:13px}
    .bar b{color:var(--mint);font-size:12px;letter-spacing:1px;text-transform:uppercase}
    .bar span{color:var(--head-sub)}
    .bar a{color:var(--mint);font-weight:700;text-decoration:none;font-size:12px}
    .tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;padding:10px}
    .tile{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;background:#fff;
          border:1px solid var(--line);border-radius:12px;padding:10px 8px;color:var(--text);text-decoration:none}
    .tile:active,.app:active{background:var(--tint)}
    .tile img{width:48px;height:48px;border-radius:12px;object-fit:contain;box-shadow:0 1px 3px rgba(16,36,63,.25)}
    .tile b{font-size:14px}
    .tile span{font-size:11px;color:var(--muted);line-height:1.2}
    .section{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);font-weight:800;padding:6px 12px 0}
    .apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:4px;padding:6px 8px 20px}
    .app{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 4px;border-radius:10px;
         color:var(--text);text-decoration:none;text-align:center;font-size:11.5px;line-height:1.2}
    .app img{width:42px;height:42px;border-radius:10px;object-fit:contain;box-shadow:0 1px 3px rgba(16,36,63,.25)}
  </style>
</head>
<body>
  <div id="tab">
    <div class="bar">
      <div><b><t t-esc="empresa"/></b> <span>· <t t-esc="user.name"/></span></div>
      <!-- 19.0.1.98.0: «Salir» lives in «Ajustes», like every page -->
      <t t-call="distri_pedido.dn_ajustes"/>
    </div>
    <div class="tiles">
      <t t-foreach="tiles" t-as="tile">
        <a class="tile" t-att-href="tile['url']">
          <img t-att-src="tile['icon']" alt=""/>
          <b t-esc="tile['title']"/>
          <span t-esc="tile['subtitle']"/>
        </a>
      </t>
    </div>
    <t t-if="apps">
      <div class="section">Todas las aplicaciones</div>
      <div class="apps">
        <t t-foreach="apps" t-as="app">
          <a class="app" t-att-href="app['url']"><img t-att-src="app['icon']" alt=""/><t t-esc="app['title']"/></a>
        </t>
      </div>
    </t>
  </div>
</body>
</html>
  </template>

</odoo>
