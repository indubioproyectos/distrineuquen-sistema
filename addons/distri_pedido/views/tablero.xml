<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- «Tablero» / «Inicio»: the staff home (controllers/tablero.py). Opening
       /odoo without a menu lands here instead of Odoo's Discuss.
       19.0.1.108.0 (owner-approved mockup «Inicio»): on the kit, with a
       glyph per tile, count badges, the «pedidos sin cliente» banner, «Mi
       reparto de hoy» for a user that also drives, and Odoo's other apps
       folded under «Todas las aplicaciones de Odoo». -->
  <!-- One tile of Inicio (19.0.1.129.42: shared by the plain grid and the groups). -->
  <template id="tablero_tile" name="Tablero: mosaico">
    <a class="tab-tile" t-att-href="tile['url']"
       t-att-data-dn="'down' if not tile['url'].startswith('/odoo') else None"
       t-att-data-tile="tile['key']">
      <span t-if="tile['badge']" t-att-class="'tab-badge dn-num' + (' tab-badge--%s' % tile['badge']['kind'] if tile['badge']['kind'] else '')"
            t-esc="tile['badge']['text']"/>
      <span class="tab-ico"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="tile['glyph']"/></t></span>
      <b t-esc="tile['title']"/>
      <span class="tab-sub" t-esc="tile['subtitle']"/>
    </a>
  </template>

  <template id="tablero_page" name="Tablero del equipo">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Inicio · <t t-esc="empresa"/></title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
</head>
<body t-att-class="'tab tab--v2' if v2 else 'tab'" data-parent="" data-page="tablero">
  <header class="dn-top">
    <div class="dn-top__row">
      <div class="dn-top__txt">
        <span class="dn-top__kicker"><t t-esc="empresa"/> · <t t-esc="user.name"/></span>
        <h1 class="dn-top__title tab-title">Inicio</h1>
      </div>
      <t t-call="distri_pedido.dn_ajustes"/>
    </div>
  </header>

  <!-- 19.0.1.126.0: the one-time notice of the instant crediting, until «Entendido» -->
  <form t-if="aviso_acreditar" class="dn-card dn-card--warn tab-aviso" method="post"
        action="/tablero/aviso-acreditar" role="alert" data-aviso="acreditar">
    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
    <input type="hidden" name="volver" value="/tablero"/>
    <p t-esc="aviso_acreditar"/>
    <button type="submit" class="dn-btn">Entendido</button>
  </form>

  <!-- 19.0.1.113.0: agil_banner, the stopped AgilPedido sync (controllers/tablero.py) -->
  <div t-if="banner or agil_banner or reclamar" class="tab-banners">
    <a t-if="agil_banner" class="tab-alerta tab-alerta--err" t-att-href="agil_banner['url']" role="alert">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'alert'"/></t>
      <span t-esc="agil_banner['text']"/>
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
    </a>
    <!-- 19.0.1.129.37 (nueva_venta): the receipts «Lo manda después» left at his name -->
    <a t-if="reclamar" class="tab-alerta" t-att-href="reclamar['url']" data-dn="down" data-tab="reclamar">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'receipt'"/></t>
      <span t-esc="reclamar['text']"/>
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
    </a>
    <a t-if="banner" class="tab-alerta" t-att-href="banner['url']" data-dn="down">
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'alert'"/></t>
      <span t-esc="banner['text']"/>
      <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
    </a>
  </div>

  <!-- 19.0.1.129.42 (ui_v2): administración's tiles in labelled groups -->
  <main t-if="grupos" class="tab-grupos">
    <section t-foreach="grupos" t-as="grupo" class="tab-grupo" t-att-aria-label="grupo['label']">
      <h2 class="dn-label tab-grupo__t" t-esc="grupo['label']"/>
      <div class="tab-tiles">
        <t t-foreach="grupo['tiles']" t-as="tile"><t t-call="distri_pedido.tablero_tile"/></t>
      </div>
    </section>
  </main>
  <main t-else="" class="tab-tiles">
    <t t-foreach="tiles" t-as="tile"><t t-call="distri_pedido.tablero_tile"/></t>
  </main>

  <section class="tab-more">
    <!-- 19.0.1.129.33 (#3): each user's own order of the tiles (ui_v2 only) -->
    <a t-if="ordenar_url" class="dn-link tab-ordenar" t-att-href="ordenar_url" data-dn="down">Ordenar el Inicio</a>
    <t t-if="mi_ruta">
      <h2 class="dn-label">Para el repartidor</h2>
      <a class="tab-row" t-att-href="mi_ruta['url']">
        <span class="tab-ico tab-ico--sm"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'truck'"/></t></span>
        <span class="tab-row__txt"><b>Mi reparto de hoy</b><span t-esc="mi_ruta['detail']"/></span>
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
      </a>
    </t>
    <details t-if="apps" class="tab-apps">
      <summary class="dn-link">Todas las aplicaciones del sistema</summary>
      <div class="tab-apps__grid">
        <a t-foreach="apps" t-as="app" class="tab-app" t-att-href="app['url']"><img t-att-src="app['icon']" alt="" loading="lazy"/><t t-esc="app['title']"/></a>
      </div>
    </details>
  </section>
</body>
</html>
  </template>

  <!-- 19.0.1.129.47 (ui_v2): Inicio on the design system («HomeTile», mockup
       s26-01-inicio). Same tiles, visibility, order and links as the page
       above (controllers/tablero.py); every role's tiles in labelled groups,
       the first tile of the user's order highlighted on top of its group,
       the others with the name only and a short badge. -->
  <template id="tablero_v2_tile" name="Inicio v2: mosaico">
    <a t-att-class="'dn-tile dn-tile--main' if is_main else 'dn-tile'" t-att-href="tile['url']"
       t-att-data-dn="'down' if not tile['url'].startswith('/odoo') else None"
       t-att-data-tile="tile['key']" t-att-title="None if is_main else tile['subtitle']"
       t-att-aria-label="('%s · %s' % (tile['title'], tile['badge']['text'])) if tile['badge'] else None">
      <span class="dn-tile__ico"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="tile['glyph']"/></t></span>
      <span class="dn-tile__txt"><t t-esc="tile['title']"/><small t-if="is_main" t-esc="tile['subtitle']"/></span>
      <span t-if="tile['badge']" t-att-class="'dn-tile__bd' + (' dn-tile__bd--%s' % tile['badge']['kind'] if tile['badge']['kind'] else '')"
            t-esc="badge_short(tile['badge'])" aria-hidden="true"/>
    </a>
  </template>

  <!-- 19.0.1.129.48 (ui_v2): one receipt of «Mis comprobantes a reclamar»
       (models/reclamar_inicio.py _distri_inicio_row): customer, amount of
       that receipt, document, «hace N días» and the actions of its role. -->
  <template id="tablero_v2_reclamo" name="Inicio v2: comprobante a reclamar">
    <li class="tab2-rec__item" t-att-data-rec="r['id']" t-att-data-rol="r['rol']">
      <div class="tab2-rec__head"><b t-esc="r['cliente']"/><b class="dn-num" t-esc="money(r['importe'])"/></div>
      <span class="tab2-rec__meta"><t t-esc="r['documento'] or r['pedido']"/><t t-if="r['documento'] and r['pedido'] and r['pedido'] not in r['documento']"> · <t t-esc="r['pedido']"/></t> · entregado <t t-esc="r['hace']"/></span>
      <div class="tab2-rec__acts">
        <details t-if="r['subir_post']" class="tab2-rec__up">
          <summary class="dn-btn dn-btn--outline dn-btn--sm"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'camera'"/></t>Subir comprobante</summary>
          <form method="post" enctype="multipart/form-data" t-att-action="r['subir_post']">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <input type="file" name="comprobantes" accept="image/*,application/pdf,.pdf" multiple="multiple" required="required"/>
            <button type="submit" class="dn-btn dn-btn--sm">Enviar</button>
          </form>
        </details>
        <a t-if="r['subir_url']" class="dn-btn dn-btn--outline dn-btn--sm" t-att-href="r['subir_url']" data-dn="down"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'camera'"/></t>Subir comprobante</a>
        <a t-if="r['foto_url']" class="dn-btn dn-btn--outline dn-btn--sm" t-att-href="r['foto_url']"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'camera'"/></t>Sacar foto</a>
        <a t-if="r['wa_url']" class="dn-btn dn-btn--ghost dn-btn--sm" target="_blank" rel="noopener" t-att-href="r['wa_url']"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'chat'"/></t>Pedir por WhatsApp</a>
        <form t-if="r['wa_post']" method="post" t-att-action="r['wa_post']" target="_blank" class="tab2-rec__wa">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="volver" value="/rendiciones/comprobantes"/>
          <button type="submit" class="dn-btn dn-btn--ghost dn-btn--sm"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'chat'"/></t>Pedir por WhatsApp</button>
        </form>
      </div>
    </li>
  </template>

  <template id="tablero_v2_page" name="Inicio (sistema de diseño)">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Inicio · <t t-esc="empresa"/></title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
</head>
<body class="tab2" data-parent="" data-page="tablero">
  <header class="dn-top tab2-top">
    <div class="dn-top__row">
      <svg class="tab2-logo" width="38" height="32" viewBox="96 122 320 266" fill="none" aria-hidden="true"><path fill="#ffffff" fill-rule="evenodd" d="M104.5 130H170.5A75 75 0 0 1 170.5 280H104.5ZM142.5 168H170.5A37 37 0 0 1 170.5 242H142.5ZM277.5 280V130H319.5L369.5 215.2V130H407.5V280H365.5L315.5 194.8V280Z"/><path d="M123.5 335C211.8 367 300.2 367 388.5 335" fill="none" stroke="#00d1b2" stroke-width="38" stroke-linecap="round"/></svg>
      <div class="dn-top__txt">
        <span class="dn-top__kicker"><t t-esc="empresa"/> · <t t-esc="user.name"/></span>
        <h1 class="dn-top__title">Inicio</h1>
      </div>
      <t t-call="distri_pedido.dn_ajustes"/>
    </div>
  </header>

  <main class="tab2-main">
    <!-- the one-time notice of the instant crediting, until «Entendido» -->
    <form t-if="aviso_acreditar" class="dn-card dn-card--warn tab2-aviso" method="post"
          action="/tablero/aviso-acreditar" role="alert" data-aviso="acreditar">
      <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
      <input type="hidden" name="volver" value="/tablero"/>
      <p t-esc="aviso_acreditar"/>
      <button type="submit" class="dn-btn dn-btn--sm dn-btn--auto">Entendido</button>
    </form>

    <!-- 19.0.1.129.48: «Mis comprobantes a reclamar», the main task of the
         day, first (controllers/tablero.py reclamar_block); not drawn when
         there is nothing to claim. No totals: each receipt has its amount. -->
    <section t-if="reclamos" class="dn-card tab2-rec" aria-labelledby="tab2-rec-t" data-tab="reclamar">
      <div class="tab2-rec__top">
        <span class="dn-tile__ico"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'receipt'"/></t></span>
        <h2 id="tab2-rec-t" class="tab2-rec__t">Mis comprobantes a reclamar</h2>
        <span class="dn-tile__bd" t-esc="reclamos['n']"/>
      </div>
      <p class="tab2-rec__hint">Te pedimos que nos ayudes a pedirle a cada cliente su comprobante. Cada uno se borra solo cuando llega a la empresa.</p>
      <ul class="tab2-rec__list">
        <t t-foreach="reclamos['rows']" t-as="r"><t t-call="distri_pedido.tablero_v2_reclamo"/></t>
      </ul>
      <details t-if="reclamos['more']" class="tab2-rec__more">
        <summary class="dn-btn dn-btn--ghost dn-btn--sm dn-btn--auto">Ver <t t-esc="len(reclamos['more'])"/> más</summary>
        <ul class="tab2-rec__list">
          <t t-foreach="reclamos['more']" t-as="r"><t t-call="distri_pedido.tablero_v2_reclamo"/></t>
        </ul>
      </details>
    </section>

    <div t-if="banner or agil_banner or reclamar" class="tab2-banners">
      <a t-if="agil_banner" class="tab2-banner tab2-banner--err" t-att-href="agil_banner['url']" role="alert">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'alert'"/></t>
        <span t-esc="agil_banner['text']"/>
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
      </a>
      <a t-if="reclamar" class="tab2-banner" t-att-href="reclamar['url']" data-dn="down" data-tab="reclamar">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'receipt'"/></t>
        <span t-esc="reclamar['text']"/>
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
      </a>
      <a t-if="banner" class="tab2-banner" t-att-href="banner['url']" data-dn="down">
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'alert'"/></t>
        <span t-esc="banner['text']"/>
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
      </a>
    </div>

    <!-- a user that also drives, with a route today -->
    <section t-if="mi_ruta" class="tab2-grupo" aria-label="Para el repartidor">
      <h2 class="dn-label">Para el repartidor</h2>
      <a class="tab2-row" t-att-href="mi_ruta['url']">
        <span class="dn-tile__ico"><t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'truck'"/></t></span>
        <span class="tab2-row__txt"><b>Mi reparto de hoy</b><span t-esc="mi_ruta['detail']"/></span>
        <t t-call="distri_pedido.dn_icon"><t t-set="i" t-value="'next'"/></t>
      </a>
    </section>

    <section t-foreach="grupos" t-as="grupo" class="tab2-grupo" t-att-aria-label="grupo['label']">
      <h2 class="dn-label" t-esc="grupo['label']"/>
      <t t-set="lead" t-value="bool(main) and grupo['tiles'][0]['key'] == main['key']"/>
      <t t-if="lead" t-call="distri_pedido.tablero_v2_tile">
        <t t-set="tile" t-value="main"/><t t-set="is_main" t-value="True"/>
      </t>
      <div t-if="len(grupo['tiles']) &gt; (1 if lead else 0)" class="tab2-tiles">
        <t t-foreach="grupo['tiles'][1:] if lead else grupo['tiles']" t-as="tile">
          <t t-call="distri_pedido.tablero_v2_tile"><t t-set="is_main" t-value="False"/></t>
        </t>
      </div>
    </section>

    <div t-if="ordenar_url or apps" class="tab2-more">
      <a t-if="ordenar_url" class="dn-btn dn-btn--ghost dn-btn--sm dn-btn--auto tab2-ordenar" t-att-href="ordenar_url" data-dn="down">Ordenar el Inicio</a>
      <details t-if="apps" class="tab2-apps">
        <summary class="dn-btn dn-btn--ghost dn-btn--sm dn-btn--auto">Todas las aplicaciones del sistema</summary>
        <div class="tab2-apps__grid">
          <a t-foreach="apps" t-as="app" class="tab2-app" t-att-href="app['url']"><img t-att-src="app['icon']" alt="" loading="lazy"/><t t-esc="app['title']"/></a>
        </div>
      </details>
    </div>
  </main>
</body>
</html>
  </template>

</odoo>
