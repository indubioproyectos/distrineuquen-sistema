<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- «Despacho»: the dispatcher's phone screen (controllers/despacho.py).
       Online only; same look as the driver's app. -->
  <template id="despacho_app" name="Despacho: control de carga">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <meta name="theme-color" content="#10243f"/>
  <title>Despacho · <t t-esc="empresa"/></title>
  <link rel="icon" href="/distri_pedido/static/src/reparto/icon-192.png"/>
  <!-- 19.0.1.129.33: the kit's look with distri_pedido.ui_v2 on (dn.css
       carries distri_ui.css's class names on the kit tokens); despacho.js is
       the same. No sin_historial.js: this page keeps its own history
       (tests/test_sin_historial.py), so the bar's links are plain links -->
  <t t-if="ui_v2">
    <link t-if="dn['font']" rel="preload" as="font" type="font/woff2" crossorigin="anonymous" t-att-href="dn['font']"/>
    <link rel="stylesheet" t-att-href="dn['css']"/>
  </t>
  <link t-else="" rel="stylesheet" t-att-href="shared_css + '?v=' + version"/>
  <link rel="stylesheet" t-att-href="static + 'despacho.css?v=' + version"/>
  <t t-if="ui_v2">
    <t t-foreach="dn['page_css']" t-as="href"><link rel="stylesheet" t-att-href="href"/></t>
  </t>
</head>
<body t-att-class="('dn-legado' + (' dn-legado--nav' if nav else '')) if ui_v2 else None">
  <!-- 19.0.1.98.0: «Ajustes» (letter size, install, name/role, Salir) -->
  <t t-call="distri_pedido.dn_ajustes"><t t-set="gear_float" t-value="True"/></t>
  <div id="app"><div class="cargando">Cargando…</div></div>
  <div id="toast" hidden="hidden"></div>
  <script t-att-src="static + 'despacho.js?v=' + version" defer="defer"></script>
  <!-- 19.0.1.129.33: the role's bottom bar (ui_v2 only) -->
  <t t-call="distri_pedido.dn_page_nav"/>
</body>
</html>
  </template>

  <record id="action_despacho_pantalla" model="ir.actions.act_url">
    <field name="name">Despacho</field>
    <field name="url">/despacho</field>
    <field name="target">self</field>
  </record>

  <menuitem id="menu_reparto_despacho" name="Despacho (celular)" parent="menu_reparto_root"
            action="action_despacho_pantalla" sequence="16"
            groups="distri_pedido.grupo_administracion"/>

</odoo>
