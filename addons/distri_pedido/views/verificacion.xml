<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 19.0.1.129.31: «Tablero de verificación» (controllers/verificacion.py,
       models/verificacion.py). Behind distri_pedido.verificacion_v2. -->

  <!-- «Histórico»: hidden by default on the payments board. Nothing is
       marked until scripts/correcciones/v129_31_marcar_historicos.sh runs
       (refused with the flag off), so with the flag off the board shows
       exactly the same cards.
       19.0.1.129.32: with the flag off the board is 129.26's: the three
       filters are invisible and the action keeps its context; with the flag
       on, ir.actions.act_window._get_action_dict (models/verificacion.py)
       adds distri_verificacion_v2 and the default «Sin históricos». -->
  <record id="view_mp_collection_search_historic" model="ir.ui.view">
    <field name="name">distri.mp.collection.search.historic</field>
    <field name="model">distri.mp.collection</field>
    <field name="inherit_id" ref="distri_pedido.view_mp_collection_search"/>
    <field name="arch" type="xml">
      <filter name="apartados" position="after">
        <separator/>
        <filter name="not_historic" invisible="not context.get('distri_verificacion_v2')"
                string="Sin históricos" domain="[('historic', '=', False)]"/>
        <filter name="historic" invisible="not context.get('distri_verificacion_v2')"
                string="Históricos (antes del 15/09)"
                domain="[('historic', '=', True)]"/>
        <filter name="auto_credited_check" invisible="not context.get('distri_verificacion_v2')"
                string="Acreditados solos sin revisar"
                domain="[('auto_credited', '=', True), ('human_check', '=', 'pendiente')]"/>
      </filter>
    </field>
  </record>

  <record id="view_mp_collection_form_verificacion" model="ir.ui.view">
    <field name="name">distri.mp.collection.form.verificacion</field>
    <field name="model">distri.mp.collection</field>
    <field name="inherit_id" ref="distri_pedido.view_mp_collection_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <div class="alert alert-warning mb-0" role="alert"
             invisible="not auto_credited or human_check != 'pendiente'">
          <b>Acreditado solo:</b> el reporte de Mercado Pago ya traía la transferencia. Falta que
          lo revise una persona (Denis, Gonzalo o Ale).
          <button name="action_distri_human_check" type="object" string="Revisado"
                  class="btn btn-sm btn-primary ms-2"/>
        </div>
        <div class="alert alert-secondary mb-0" role="status" invisible="not historic">
          <b>Histórico:</b> ingreso pendiente anterior al 15/09/2026. No se borró: queda oculto por
          defecto.
        </div>
        <field name="auto_credited" invisible="1"/>
        <field name="human_check" invisible="1"/>
        <field name="historic" invisible="1"/>
      </xpath>
    </field>
  </record>

  <template id="verificacion_top" name="Verificación: barra">
    <header class="dn-top">
      <div class="dn-top__row">
        <a class="dn-link" t-att-href="volver" data-dn-back="">‹ Volver</a>
        <t t-call="distri_pedido.dn_ajustes"/>
      </div>
      <div class="dn-top__txt">
        <span class="dn-top__kicker">Distri Neuquén · <t t-esc="user.name"/></span>
        <h1 class="dn-top__title" t-esc="titulo"/>
        <p t-if="sub" class="dn-top__sub" t-esc="sub"/>
      </div>
    </header>
  </template>

  <template id="verificacion_page" name="Tablero de verificación">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Tablero de verificación · Distri Neuquén</title>
  <t t-set="manifest" t-value="'/tablero/manifest.webmanifest'"/>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="dn-has-nav" t-att-data-parent="inicio" data-page="verificacion">
  <t t-call="distri_pedido.verificacion_top">
    <t t-set="volver" t-value="inicio"/>
    <t t-set="titulo" t-value="'Tablero de verificación'"/>
    <t t-set="sub" t-value="'Solo lo que necesita a una persona. Cada cola tiene un responsable y un plazo.'"/>
  </t>
  <main class="dn-main">
    <!-- 19.0.1.129.37: the upload of receipts, several at once (dropped on the PC) -->
    <a t-if="subir" class="dn-btn dn-btn--outline" href="/comprobantes" data-dn="down">Subir comprobantes
      (varios a la vez)</a>
    <!-- 19.0.1.129.38: «Comprobantes subidos» by who sent them (#10, #66) -->
    <a t-if="subidos" class="dn-btn dn-btn--outline" href="/verificacion/subidos"
       data-dn="down">Comprobantes subidos (por usuario)</a>
    <a t-foreach="colas" t-as="c" class="dn-card dn-row" t-att-href="'/verificacion/%s' % c['key']"
       t-att-data-cola="c['key']">
      <div>
        <b><t t-esc="c['number']"/>. <t t-esc="c['title']"/></b>
        <p class="dn-label" t-esc="c['what']"/>
        <p class="dn-label">
          <t t-esc="c['who']"/><t t-if="c['term_label']"> · plazo <t t-esc="c['term_label']"/></t>
          <t t-if="c['oldest']"> · el más viejo <t t-esc="c['oldest']"/></t>
        </p>
        <!-- 19.0.1.129.38: the report's incomes nobody could assign (#48), informs only -->
        <p t-if="c['key'] == 'sin_comprobante' and sin_cliente" class="dn-label">
          Además <t t-esc="sin_cliente"/> sin cliente (filtro «Sin cliente»)
        </p>
      </div>
      <span t-att-class="'dn-chip dn-num ' + ('dn-chip--err' if c['overdue'] else 'dn-chip--warn' if c['count'] and c['term'] else 'dn-chip--neutral')">
        <t t-esc="c['count']"/><t t-if="c['overdue']"> · <t t-esc="c['overdue']"/> vencidos</t>
      </span>
    </a>
  </main>
  <div class="dn-bottom"><t t-call="distri_pedido.dn_nav"/></div>
</body>
</html>
  </template>

  <template id="verificacion_cola" name="Tablero de verificación: cola">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title><t t-esc="cola['title']"/> · Distri Neuquén</title>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="dn-has-nav" data-parent="/verificacion" t-att-data-page="'verificacion-' + cola['key']">
  <t t-call="distri_pedido.verificacion_top">
    <t t-set="volver" t-value="'/verificacion'"/>
    <t t-set="titulo" t-value="'%s. %s' % (cola['number'], cola['title'])"/>
    <t t-set="sub" t-value="cola['what']"/>
  </t>
  <div t-if="ok" class="dn-banner dn-banner--ok" role="status"><span t-esc="ok"/></div>
  <div t-if="error" class="dn-banner dn-banner--err" role="alert"><span t-esc="error"/></div>
  <main class="dn-main">
    <p class="dn-label">
      <t t-esc="cola['who']"/><t t-if="cola['term_label']"> · plazo <t t-esc="cola['term_label']"/></t>
      · <t t-esc="cola['count']"/> en la cola<t t-if="cola['overdue']">, <t t-esc="cola['overdue']"/> vencidos</t>
    </p>
    <!-- 19.0.1.129.38: queue 7 filters -->
    <div t-if="cola['key'] == 'sin_comprobante'" class="dn-row" data-filtros="">
      <a t-att-class="'dn-chip ' + ('dn-chip--warn' if not filtro else 'dn-chip--neutral')"
         href="/verificacion/sin_comprobante">Todos</a>
      <a t-att-class="'dn-chip ' + ('dn-chip--warn' if filtro == 'otro_cliente' else 'dn-chip--neutral')"
         href="/verificacion/sin_comprobante?filtro=otro_cliente">Comprobante de otro cliente</a>
      <a t-att-class="'dn-chip ' + ('dn-chip--warn' if filtro == 'sin_cliente' else 'dn-chip--neutral')"
         href="/verificacion/sin_comprobante?filtro=sin_cliente">Sin cliente · <t t-esc="sin_cliente"/></a>
    </div>
    <p t-if="filtro == 'sin_cliente'" class="dn-label">Ingresos del reporte que nadie pudo asignar
      a un cliente (sin los históricos). Solo informa: no suman al número de Inicio. Los asigna
      Sistemas desde el tablero de cobros.</p>
    <p t-if="filtro == 'otro_cliente'" class="dn-label">Ingresos sin comprobante para los que hay
      un comprobante pendiente de otro cliente con el mismo número de operación, o el mismo importe
      con el mismo CUIT o a la misma hora.</p>
    <!-- 19.0.1.129.39: proposed ties of credited receipts (queue 5) -->
    <t t-if="cruces">
      <h2 class="dn-label" data-cruces="">Cruces propuestos · <t t-esc="len(cruces)"/></h2>
      <p class="dn-label">Comprobantes acreditados y transferencias del reporte con el mismo importe,
        del mismo día o del día anterior, donde cada uno es el único candidato del otro. No se cruzan
        solos: revisalos y tocá «Cruzar». No se registra otro pago.</p>
      <section t-foreach="cruces" t-as="c" class="dn-card" t-att-data-cruce="'%s-%s' % (c['card_id'], c['income_id'])">
        <p><b t-esc="c['partner']"/> · <span class="dn-num" t-esc="c['amount']"/></p>
        <p class="dn-label">Comprobante: <t t-esc="c['card']"/></p>
        <p class="dn-label">Reporte: <t t-esc="c['income']"/></p>
        <p t-if="c['gap']" class="dn-label">Diferencia de hora: <t t-esc="c['gap']"/></p>
        <p t-if="c['warning']" data-mayorista=""><span class="dn-chip dn-chip--err" t-esc="c['warning']"/></p>
        <div class="dn-row">
          <a class="dn-btn dn-btn--outline" t-att-href="c['card_url']">Abrir comprobante</a>
          <a t-if="c['income_url']" class="dn-btn dn-btn--outline" t-att-href="c['income_url']">Abrir ingreso</a>
          <form t-if="c['can_tie']" method="post" action="/verificacion/cruzar">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <input type="hidden" name="card_id" t-att-value="c['card_id']"/>
            <input type="hidden" name="income_id" t-att-value="c['income_id']"/>
            <button type="submit" class="dn-btn">Cruzar</button>
          </form>
        </div>
      </section>
      <h2 class="dn-label">En la cola</h2>
    </t>
    <p t-if="not filas" class="dn-empty">No hay nada en esta cola.</p>
    <section t-foreach="filas" t-as="f" t-att-class="'dn-card' + (' dn-card--warn' if f['overdue'] else '')"
             t-att-data-fila="'%s-%s' % (f['model'], f['id'])">
      <p><b t-esc="f['partner']"/> · <span class="dn-num" t-esc="f['amount']"/></p>
      <p class="dn-label"><t t-esc="f['name']"/> · <t t-esc="f['age']"/><t t-if="f['who']"> · <t t-esc="'repartidor' if f['model'] == 'distri.route.stop' else 'acreditó'"/> <t t-esc="f['who']"/></t></p>
      <p t-if="f['reason']" class="dn-label" t-esc="f['reason']"/>
      <p t-if="f.get('other')" data-otro-cliente=""><span class="dn-chip dn-chip--err">Comprobante de otro cliente</span>
        <span class="dn-label" t-esc="f['other']"/></p>
      <div class="dn-row">
        <a t-if="f['url']" class="dn-btn dn-btn--outline" t-att-href="f['url']">Abrir</a>
        <form t-if="f.get('claim')" method="post" action="/verificacion/reclamar" target="_blank">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="card_id" t-att-value="f['id']"/>
          <button type="submit" class="dn-btn">Reclamar por WhatsApp</button>
        </form>
        <form t-if="f['check']" method="post" action="/verificacion/revisado">
          <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
          <input type="hidden" name="card_id" t-att-value="f['id']"/>
          <button type="submit" class="dn-btn">Revisado</button>
        </form>
        <t t-if="f['twin']">
          <form method="post" action="/verificacion/duplicado">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <input type="hidden" name="msg_id" t-att-value="f['id']"/>
            <input type="hidden" name="decision" value="mismo"/>
            <button type="submit" class="dn-btn dn-btn--warn">Es el mismo pago</button>
          </form>
          <form method="post" action="/verificacion/duplicado">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <input type="hidden" name="msg_id" t-att-value="f['id']"/>
            <input type="hidden" name="decision" value="dos"/>
            <button type="submit" class="dn-btn dn-btn--ghost">Son dos pagos</button>
          </form>
        </t>
      </div>
    </section>
  </main>
  <div class="dn-bottom"><t t-call="distri_pedido.dn_nav"/></div>
</body>
</html>
  </template>
  <!-- 19.0.1.129.38: «Comprobantes subidos» (#10 and #66), by who sent them and state -->
  <template id="verificacion_subidos" name="Tablero de verificación: comprobantes subidos">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <title>Comprobantes subidos · Distri Neuquén</title>
  <t t-call="distri_pedido.dn_head"/>
</head>
<body class="dn-has-nav" data-parent="/verificacion" data-page="verificacion-subidos">
  <t t-call="distri_pedido.verificacion_top">
    <t t-set="volver" t-value="'/verificacion'"/>
    <t t-set="titulo" t-value="'Comprobantes subidos'"/>
    <t t-set="sub" t-value="'Quién subió cada comprobante y en qué estado está.'"/>
  </t>
  <main class="dn-main">
    <div class="dn-row" data-dias="">
      <a t-foreach="(1, 7, 30)" t-as="d"
         t-att-class="'dn-chip ' + ('dn-chip--warn' if data['days'] == d else 'dn-chip--neutral')"
         t-att-href="'/verificacion/subidos?dias=%s' % d"><t t-esc="'Hoy' if d == 1 else 'Últimos %s días' % d"/></a>
    </div>
    <p class="dn-label"><t t-esc="data['total']"/> comprobantes<t t-if="data['who']"> · <t t-esc="data['who']"/></t><t t-if="data['bucket']"> · <t t-esc="data['buckets'][data['bucket']]"/></t>
      <a t-if="data['who'] or data['bucket']" class="dn-link" t-att-href="'/verificacion/subidos?dias=%s' % data['days']">Ver todos</a></p>
    <p t-if="not data['groups']" class="dn-empty">No llegó ningún comprobante en estos días.</p>
    <section t-foreach="data['groups']" t-as="g" class="dn-card" t-att-data-quien="g['who']">
      <p><a class="dn-link" t-att-href="g['url']"><b t-esc="g['who']"/></a> · <span class="dn-num" t-esc="g['total']"/></p>
      <div class="dn-row">
        <t t-foreach="data['buckets'].items()" t-as="b">
          <a t-if="g['buckets'][b[0]]" t-att-data-estado="b[0]"
             t-att-class="'dn-chip ' + ('dn-chip--ok' if b[0] == 'aprobado' else 'dn-chip--err' if b[0] == 'rechazado' else 'dn-chip--warn' if b[0] == 'pendiente' else 'dn-chip--neutral')"
             t-att-href="g['urls'][b[0]]"><t t-esc="b[1]"/> · <t t-esc="g['buckets'][b[0]]"/></a>
        </t>
      </div>
    </section>
    <section t-foreach="data['rows']" t-as="r" class="dn-card" t-att-data-subido="r['id']">
      <p><b t-esc="r['partner']"/> · <span class="dn-num" t-esc="r['amount']"/></p>
      <p class="dn-label"><t t-esc="r['when']"/> · <t t-esc="r['who']"/> · <t t-esc="r['bucket_label']"/> (<t t-esc="r['state']"/>)</p>
      <div class="dn-row"><a class="dn-btn dn-btn--outline" t-att-href="r['url']">Abrir</a></div>
    </section>
  </main>
  <div class="dn-bottom"><t t-call="distri_pedido.dn_nav"/></div>
</body>
</html>
  </template>
</odoo>
