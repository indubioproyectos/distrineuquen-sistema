<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- The delivery driver's app shell. No user data here: the service worker
       caches it so the app opens without signal. -->
  <template id="reparto_app" name="Reparto: app del repartidor">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <meta name="theme-color" content="#10243f"/>
  <title>Reparto · <t t-esc="empresa"/></title>
  <link rel="manifest" href="/reparto/manifest.webmanifest"/>
  <link rel="icon" t-att-href="static + 'icon-192.png?v=' + version"/>
  <link rel="apple-touch-icon" t-att-href="static + 'icon-192.png?v=' + version"/>
  <link rel="stylesheet" t-att-href="shared_css + '?v=' + version"/>
  <link rel="stylesheet" t-att-href="static + 'app.css?v=' + version"/>
</head>
<!-- 19.0.1.113.0: data-uid tells app2.js whose state to open (per-user
     state on the phone); app.js stays one version for the old template -->
<body t-att-data-uid="uid">
  <!-- 19.0.1.98.0: «Ajustes» (letter size, install, name/role, Salir) -->
  <t t-call="distri_pedido.dn_ajustes"><t t-set="gear_float" t-value="True"/></t>
  <div id="app"><div class="cargando">Cargando…</div></div>
  <div id="toast" hidden="hidden"></div>
  <script t-att-src="static + 'claim.js?v=' + version" defer="defer"></script>
  <!-- 19.0.1.115.0: app3.js (app2.js stays for the cached 19.0.1.114.0 page) -->
  <script t-att-src="static + 'app3.js?v=' + version" defer="defer"></script>
</body>
</html>
  </template>

</odoo>
