<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 19.0.1.129.35: «Rearmar» as a correction while distri_pedido.nueva_venta
       is on (models/rearmar.py distri.rearmar.wizard): the reason, then the
       same «Rearmar» as before. -->
  <record id="view_rearmar_wizard" model="ir.ui.view">
    <field name="name">distri.rearmar.wizard.form</field>
    <field name="model">distri.rearmar.wizard</field>
    <field name="arch" type="xml">
      <form string="Rearmar · corrección">
        <p>
          «Rearmar» es una corrección: se cancela la factura y el pedido, y se crea uno nuevo para volver a
          armarlo. Escribí por qué.
        </p>
        <group>
          <field name="order_id"/>
          <field name="motivo" placeholder="Por qué hay que rearmarlo"/>
        </group>
        <footer>
          <button name="action_rearmar" type="object" string="Rearmar" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- the reason of «Anular venta» on the order form (read-only) -->
  <record id="view_order_form_anulada" model="ir.ui.view">
    <field name="name">sale.order.form.anulada</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <div class="alert alert-warning" role="status" invisible="not distri_anulada_motivo">
          Venta anulada por <field name="distri_anulada_por_id" readonly="1" class="d-inline"/>:
          <field name="distri_anulada_motivo" readonly="1" class="d-inline"/>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
