<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- El cliente ve el remito, nunca la factura (models/remito.py): nadie le
       manda la factura desde Odoo. Se ocultan los botones "Enviar" del
       formulario y de las listas de facturas y notas de credito, y se saca
       "Compartir" del menu Accion (manda el enlace de la factura por correo).
       Imprimir queda para el personal. -->
  <record id="view_move_form_sin_enviar" model="ir.ui.view">
    <field name="name">account.move.form.distri.sin.enviar</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="(//header/button[@name='action_invoice_sent'])[1]" position="attributes">
        <attribute name="invisible">True</attribute>
      </xpath>
      <xpath expr="(//header/button[@name='action_invoice_sent'])[2]" position="attributes">
        <attribute name="invisible">True</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_out_invoice_tree_sin_enviar" model="ir.ui.view">
    <field name="name">account.out.invoice.list.distri.sin.enviar</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_out_invoice_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_send_and_print']" position="attributes">
        <attribute name="invisible">True</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_out_credit_note_tree_sin_enviar" model="ir.ui.view">
    <field name="name">account.out.credit.note.list.distri.sin.enviar</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_send_and_print']" position="attributes">
        <attribute name="invisible">True</attribute>
      </xpath>
    </field>
  </record>

  <!-- account la carga con noupdate: se desvincula en cada actualizacion -->
  <function model="ir.actions.server" name="unlink_action"
            eval="[[ref('account.model_account_move_action_share')]]"/>
</odoo>
