<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- «Alta de revendedor» by self-signup (19.0.1.92.0,
       controllers/alta_revendedor.py, models/alta_revendedor.py) -->

  <template id="alta_revendedor_head" name="Alta de revendedor: estilos">
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
    <meta name="robots" content="noindex,nofollow"/>
    <link rel="icon" t-att-href="'/web/image/res.company/%s/logo' % empresa_id"/>
    <style>
      :root{--fondo:#f5f5f5;--tarjeta:#fff;--texto:#4a4a4a;--tenue:#7a7a7a;--linea:#dbdbdb;
            --acento:#00d1b2;--alerta:#c92a2a}
      *{box-sizing:border-box}
      body{margin:0;background:var(--fondo);color:var(--texto);
           font:16px/1.5 BlinkMacSystemFont,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
      .marco{max-width:560px;margin:0 auto;padding:1.2rem 1rem 2rem}
      .cab{text-align:center}
      .cab img{width:64px;height:64px;border-radius:50%;object-fit:cover}
      h1{font-size:1.25rem;margin:.6rem 0 .3rem}
      .sub{color:var(--tenue);font-size:.9rem;margin:0 0 1rem}
      .tarjeta{background:var(--tarjeta);border:1px solid #eee;border-radius:6px;padding:1rem;margin:0 0 1rem}
      .btn{display:block;text-align:center;background:var(--acento);color:#fff;border:0;border-radius:4px;
           padding:.8rem 1rem;font-weight:700;text-decoration:none;margin:.5rem 0;font-size:1rem;width:100%;cursor:pointer}
      .btn.s{background:#fff;color:var(--texto);border:1px solid var(--linea)}
      .btn.g{background:#fff;color:#3c4043;border:1px solid #dadce0}
      .btn.wa{background:#25d366}
      label{display:block;font-size:.85rem;font-weight:600;margin:.6rem 0 .2rem}
      input{width:100%;padding:.6rem;border:1px solid var(--linea);border-radius:4px;font-size:1rem}
      .err{background:#fdecea;color:var(--alerta);border-radius:4px;padding:.6rem .8rem;margin:0 0 .8rem;font-weight:600}
      .ok{background:#e6faf7;color:#00806f;border-radius:4px;padding:.8rem;margin:0 0 .8rem}
      .nota{font-size:.85rem;color:var(--tenue)}
      .nota a{color:#00806f}
    </style>
  </template>

  <template id="revendedor_page" name="Soy revendedor / Soy distribuidora">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <t t-call="distri_pedido.alta_revendedor_head"/>
  <title>Revendedores y distribuidoras · <t t-esc="empresa"/></title>
</head>
<body>
  <div class="marco">
    <div class="cab">
      <img t-att-src="'/web/image/res.company/%s/logo' % empresa_id" alt=""/>
      <h1>Revendedores y distribuidoras</h1>
      <p class="sub">Creá tu cuenta y completá los datos de tu comercio. Cuando te habilitemos,
        al entrar vas a ver los precios de tu lista. Hasta entonces ves la lista mayorista general.</p>
    </div>
    <div class="tarjeta">
      <a class="btn" t-att-href="signup">Crear cuenta con mi correo</a>
      <a class="btn g" t-if="google" t-att-href="google">Entrar con Google</a>
      <a class="btn s" t-att-href="login">Ya tengo cuenta: entrar</a>
    </div>
    <p class="nota">¿Dudas? <a t-att-href="whatsapp" target="_blank" rel="noopener">Escribinos por WhatsApp</a>.
      <a href="/pedido">Volver al catálogo</a></p>
  </div>
</body>
</html>
  </template>

  <template id="mi_perfil_page" name="Mi perfil de revendedor">&lt;!DOCTYPE html&gt;
<html lang="es">
<head>
  <t t-call="distri_pedido.alta_revendedor_head"/>
  <title>Mi perfil de revendedor · <t t-esc="empresa"/></title>
</head>
<body>
  <div class="marco">
    <div class="cab">
      <img t-att-src="'/web/image/res.company/%s/logo' % empresa_id" alt=""/>
      <h1>Mi perfil de revendedor</h1>
    </div>

    <t t-if="estado in ('pendiente', 'habilitado') and not error">
      <div class="ok" role="status">
        <t t-if="estado == 'habilitado'">Tu cuenta de revendedor ya está habilitada: en el catálogo ves los precios de tu lista.</t>
        <t t-else="">
          <b t-if="listo">¡Listo! Recibimos tus datos.</b>
          Tu alta está pendiente: te avisamos cuando esté habilitada. Mientras tanto ves la
          lista mayorista general.
        </t>
      </div>
      <a t-if="estado == 'pendiente'" class="btn wa" t-att-href="whatsapp" target="_blank" rel="noopener">Avisar por WhatsApp</a>
      <a class="btn s" href="/pedido">Ir al catálogo</a>
    </t>
    <p t-else="" class="sub">Para terminar el alta, completá los datos de tu comercio.</p>

    <form class="tarjeta" method="post" action="/mi-perfil"
          onsubmit="this.querySelector('button').disabled=true">
      <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
      <div t-if="error" class="err" role="alert"><t t-esc="error"/></div>
      <label for="comercio">Nombre del comercio</label>
      <input id="comercio" name="comercio" required="required" maxlength="120" t-att-value="form.get('comercio')"/>
      <label for="contacto">Nombre y apellido</label>
      <input id="contacto" name="contacto" required="required" maxlength="120" t-att-value="form.get('contacto')"/>
      <label for="cuit">CUIT/CUIL (11 números)</label>
      <input id="cuit" name="cuit" required="required" inputmode="numeric" maxlength="20" t-att-value="form.get('cuit')"/>
      <label for="telefono">Teléfono / WhatsApp</label>
      <input id="telefono" name="telefono" required="required" inputmode="tel" maxlength="40"
             placeholder="Ej.: 299 4222444" t-att-value="form.get('telefono')"/>
      <label for="direccion">Dirección</label>
      <input id="direccion" name="direccion" required="required" maxlength="120" t-att-value="form.get('direccion')"/>
      <label for="localidad">Localidad</label>
      <input id="localidad" name="localidad" required="required" maxlength="120" t-att-value="form.get('localidad')"/>
      <button type="submit" class="btn">Guardar mis datos</button>
    </form>
  </div>
</body>
</html>
  </template>

  <!-- ============================================ manager side -->

  <record id="view_partner_form_alta_revendedor" model="ir.ui.view">
    <field name="name">res.partner.form.alta.revendedor</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="distri_pedido.view_partner_form_saldo"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <field name="distri_alta_estado" invisible="1"/>
        <button name="action_distri_enable_reseller" type="object" class="btn-primary"
                string="Habilitar revendedor"
                invisible="distri_alta_estado not in ('pendiente', 'rechazado', 'perfil')"/>
        <button name="action_distri_reject_reseller" type="object" string="Rechazar"
                invisible="distri_alta_estado != 'pendiente'"
                confirm="Se rechaza el alta: sigue viendo solo la lista general. ¿Seguir?"/>
      </xpath>
      <xpath expr="//group[@name='distri_acceso']" position="before">
        <group string="Alta de revendedor (se registró solo)" name="distri_alta"
               invisible="not distri_alta_estado"
               groups="distri_pedido.grupo_administracion,distri_pedido.grupo_gerencia">
          <field name="distri_alta_estado" readonly="1"/>
          <field name="distri_alta_contacto" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_reseller_enable_form" model="ir.ui.view">
    <field name="name">distri.reseller.enable.form</field>
    <field name="model">distri.reseller.enable</field>
    <field name="arch" type="xml">
      <form string="Habilitar revendedor">
        <p>Al habilitarlo ve la sección DISTRIBUIDORAS o la lista que elijas acá, cuando entra con
           su usuario.</p>
        <group>
          <field name="partner_id"/>
          <field name="pricelist_id" options="{'no_create': True}"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" class="btn-primary" string="Habilitar"/>
          <button special="cancel" string="Cancelar"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_partner_list_alta_revendedor" model="ir.ui.view">
    <field name="name">res.partner.list.alta.revendedor</field>
    <field name="model">res.partner</field>
    <field name="priority">40</field>
    <field name="arch" type="xml">
      <list string="Revendedores pendientes de alta" create="0">
        <field name="create_date" string="Registrado"/>
        <field name="name" string="Comercio"/>
        <field name="distri_alta_contacto"/>
        <field name="vat" string="CUIT"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="city"/>
        <field name="distri_alta_estado" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="action_revendedores_pendientes" model="ir.actions.act_window">
    <field name="name">Revendedores pendientes de alta</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('distri_alta_estado', '=', 'pendiente')]</field>
    <field name="context">{'create': False}</field>
    <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_list_alta_revendedor')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No hay revendedores esperando el alta.</p>
      <p>Los que se registran solos desde la página de pedidos y completan su perfil aparecen
         acá. Abrí la ficha y tocá «Habilitar revendedor» (elegís la lista) o «Rechazar».</p>
    </field>
  </record>

  <menuitem id="menu_revendedores_pendientes"
            name="Revendedores pendientes de alta"
            parent="sale.sale_order_menu"
            action="action_revendedores_pendientes"
            groups="distri_pedido.grupo_administracion,distri_pedido.grupo_gerencia"
            sequence="4"/>

</odoo>
