<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <record id="categoria_distri" model="ir.module.category">
      <field name="name">Distri Neuquén</field>
      <field name="sequence">5</field>
    </record>

    <record id="privilegio_distri" model="res.groups.privilege">
      <field name="name">Distri Neuquén</field>
      <field name="category_id" ref="categoria_distri"/>
      <field name="sequence">10</field>
      <field name="description">Roles de la operación: armador, reparto, vendedor, administración y gerencia.</field>
    </record>

    <record id="grupo_armador" model="res.groups">
      <field name="name">Armador</field>
      <field name="privilege_id" ref="privilegio_distri"/>
      <field name="sequence">10</field>
      <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
      <field name="comment">Prepara los pedidos y carga lo que entrega. No ve los clientes ni las cuentas.</field>
    </record>

    <record id="grupo_reparto" model="res.groups">
      <field name="name">Reparto y cobranza</field>
      <field name="privilege_id" ref="privilegio_distri"/>
      <field name="sequence">20</field>
      <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
      <field name="comment">Entrega los pedidos y registra los cobros en la calle.</field>
    </record>

    <record id="grupo_vendedor" model="res.groups">
      <field name="name">Vendedor</field>
      <field name="privilege_id" ref="privilegio_distri"/>
      <field name="sequence">30</field>
      <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
      <field name="comment">Carga pedidos y ve la cuenta corriente de los clientes de su cartera.</field>
    </record>

    <record id="grupo_administracion" model="res.groups">
      <field name="name">Administración contable</field>
      <field name="privilege_id" ref="privilegio_distri"/>
      <field name="sequence">40</field>
      <field name="implied_ids" eval="[(4, ref('grupo_vendedor')), (4, ref('grupo_armador')), (4, ref('grupo_reparto')), (4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_user')), (4, ref('base.group_partner_manager'))]"/>
      <field name="comment">Asigna clientes, aprueba pedidos, ve todas las cuentas y la contabilidad completa (diarios, asientos, informes).</field>
    </record>

    <!-- 19.0.1.129.0 (decision 7, 21/11/2026): «Pago a proveedor de Distri»,
         a customer credited for a transfer he made straight to a supplier
         (models/pago_proveedor.py). Only Gerencia (implied below), the
         administrator (Denis) and the technical admin (Ale): the last two
         are added by migrations/19.0.1.129.0. A privilege of its own, so it
         adds to the user's role instead of replacing it. -->
    <record id="privilegio_pago_proveedor" model="res.groups.privilege">
      <field name="name">Pago a proveedor</field>
      <field name="category_id" ref="categoria_distri"/>
      <field name="sequence">40</field>
      <field name="description">Quién acredita a un cliente lo que le pagó directo a un proveedor de la empresa.</field>
    </record>

    <record id="grupo_pago_proveedor" model="res.groups">
      <field name="name">Cobros: pago a proveedor de Distri</field>
      <field name="privilege_id" ref="privilegio_pago_proveedor"/>
      <field name="sequence">10</field>
      <field name="comment">Acredita al cliente una transferencia que hizo directo a un proveedor de la empresa, con la autorización de Gerencia, en el diario «Pagos a proveedores por cuenta de clientes».</field>
      <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="grupo_gerencia" model="res.groups">
      <field name="name">Gerencia</field>
      <field name="privilege_id" ref="privilegio_distri"/>
      <field name="sequence">50</field>
      <field name="implied_ids" eval="[(4, ref('grupo_administracion')), (4, ref('stock.group_stock_manager')), (4, ref('purchase.group_purchase_user')), (4, ref('account.group_account_readonly')), (4, ref('grupo_pago_proveedor'))]"/>
      <field name="comment">Ve todo, carga compras y lleva el stock.</field>
    </record>

    <!-- 19.0.1.73.0: who authorizes money. Implied by no other group on
         purpose: Administración and Gerencia keep seeing everything, and
         giving the permission back is adding the user here. A privilege of
         its own (same category): in the user form each privilege is one
         drop-down, so inside «Distri Neuquén» choosing it would take
         Administración or Gerencia away. -->
    <record id="privilegio_cobros" model="res.groups.privilege">
      <field name="name">Cobros</field>
      <field name="category_id" ref="categoria_distri"/>
      <field name="sequence">20</field>
      <field name="description">Quién autoriza la plata. Se suma al rol de Distri Neuquén, no lo reemplaza.</field>
    </record>

    <record id="grupo_cobros" model="res.groups">
      <field name="name">Cobros: autorizar pagos</field>
      <field name="privilege_id" ref="privilegio_cobros"/>
      <field name="sequence">10</field>
      <field name="comment">Confirma, descarta y deshace las tarjetas de Mercado Pago, aprueba sin comprobante, elige el cliente de un cobro, registra pagos de clientes, cierra el día, ajusta saldos y aprueba la puesta al día.</field>
      <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- 19.0.1.97.0: «Cajero», the person who keeps the daily cash (/caja,
         models/caja.py). A privilege of its own like «Cobros», so it adds
         to the user's Distri role instead of replacing it; separate from
         «Cobros: autorizar pagos» on purpose. -->
    <record id="privilegio_caja" model="res.groups.privilege">
      <field name="name">Caja</field>
      <field name="category_id" ref="categoria_distri"/>
      <field name="sequence">30</field>
      <field name="description">Quién maneja la caja del día. Se suma al rol de Distri Neuquén, no lo reemplaza.</field>
    </record>

    <record id="grupo_cajero" model="res.groups">
      <field name="name">Cajero</field>
      <field name="privilege_id" ref="privilegio_caja"/>
      <field name="sequence">10</field>
      <field name="comment">Abre y cierra la caja del día, recibe las rendiciones y la plata de los demás, paga gastos y proveedores desde la caja y cuenta los billetes.</field>
    </record>

    <!-- 19.0.1.129.11: who turns an income of the Mercado Pago report into a
         payment and approves the «Tablero de migración» (models/
         ingresos_reporte.py). A privilege of its own, so it adds to the
         user's role. -->
    <record id="privilegio_ingresos_reporte" model="res.groups.privilege">
      <field name="name">Ingresos del reporte</field>
      <field name="category_id" ref="categoria_distri"/>
      <field name="sequence">25</field>
      <field name="description">Quién confirma los ingresos del reporte de Mercado Pago y aprueba el tablero de migración.</field>
    </record>

  </data>

  <!-- noupdate: the membership is decided here once, only the user admin
       (Ale · Sistemas). Implied by no group, base.group_system neither:
       explicit membership. -->
  <data noupdate="1">
    <record id="grupo_ingresos_reporte" model="res.groups">
      <field name="name">Cobros: confirmar ingresos del reporte y migración</field>
      <field name="privilege_id" ref="privilegio_ingresos_reporte"/>
      <field name="sequence">10</field>
      <field name="comment">Confirma o registra como pago un ingreso del reporte de Mercado Pago (el flujo normal es acreditar el comprobante) y aprueba las tarjetas del tablero de migración.</field>
      <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
  </data>
</odoo>
